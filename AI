-- Обновление счетчика токенов по истории
local function updateTokenCounter()
    local totalChars = 0
    for _, msg in ipairs(chatHistory) do
        totalChars = totalChars + #msg.text
    end
    -- Приблизительная оценка: 1 токен ~= 4 символа текста
    local estimatedTokens = math.floor(totalChars / 4)
    TokenLabel.Text = "💬 Токенов в памяти: ~" .. estimatedTokens
end

