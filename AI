local Memory = {}

function Memory.Initialize(AI)
    AI.Memory = AI.Memory or {
        RecentMessages = {},
        SuccessfulActions = {},
        FailedActions = {},
        PlayerRelationships = {},
        LearnedTriggers = {},
        ContextWindow = {},
        ActionHistory = {}
    }
end

function Memory.AddMessage(AI, message, speaker)
    local msgData = {
        Text = message,
        Speaker = speaker,
        Time = tick(),
        Emotion = Memory.AnalyzeEmotion(message)
    }
    table.insert(AI.Memory.RecentMessages, msgData)
    if #AI.Memory.RecentMessages > AI.Config.MaxRecentMessages then
        table.remove(AI.Memory.RecentMessages, 1)
    end
    table.insert(AI.Memory.ContextWindow, msgData)
    if #AI.Memory.ContextWindow > 6 then
        table.remove(AI.Memory.ContextWindow, 1)
    end
    return msgData
end

function Memory.AnalyzeEmotion(text)
    local emotions = { Joy = 0, Sadness = 0, Anger = 0, Fear = 0, Surprise = 0 }
    local lowerText = text:lower()
    local joyWords = {"рад", "счастье", "ура", "круто", "отлично", "супер", "смех", "хаха", "лол", "класс"}
    for _, word in ipairs(joyWords) do if string.find(lowerText, word) then emotions.Joy = emotions.Joy + 20 end end
    local sadWords = {"груст", "печаль", "жаль", "плохо", "увы", "эх", "тоск", "один"}
    for _, word in ipairs(sadWords) do if string.find(lowerText, word) then emotions.Sadness = emotions.Sadness + 20 end end
    local angerWords = {"злой", "бесит", "ярость", "гнев", "ненавид", "дурак", "идиот"}
    for _, word in ipairs(angerWords) do if string.find(lowerText, word) then emotions.Anger = emotions.Anger + 20 end end
    local fearWords = {"страш", "боюсь", "жутк", "ужас", "паник", "помоги"}
    for _, word in ipairs(fearWords) do if string.find(lowerText, word) then emotions.Fear = emotions.Fear + 20 end end
    local surpriseWords = {"ого", "вау", "ничего себе", "не может быть", "серьёзно", "правда"}
    for _, word in ipairs(surpriseWords) do if string.find(lowerText, word) then emotions.Surprise = emotions.Surprise + 20 end end
    return emotions
end

function Memory.RecordSuccess(AI, action, context)
    table.insert(AI.Memory.SuccessfulActions, { Action = action, Context = context, Time = tick() })
    if #AI.Memory.SuccessfulActions > 50 then table.remove(AI.Memory.SuccessfulActions, 1) end
end

function Memory.RecordFailure(AI, action, reason)
    table.insert(AI.Memory.FailedActions, { Action = action, Reason = reason, Time = tick() })
    if #AI.Memory.FailedActions > 50 then table.remove(AI.Memory.FailedActions, 1) end
end

function Memory.RecordAction(AI, action, state, result)
    table.insert(AI.Memory.ActionHistory, { Action = action, State = state, Result = result, Time = tick() })
    if #AI.Memory.ActionHistory > 100 then table.remove(AI.Memory.ActionHistory, 1) end
end

function Memory.GetContextResponse(AI)
    if #AI.Memory.RecentMessages < 2 then return nil end
    local lastMsg = AI.Memory.RecentMessages[#AI.Memory.RecentMessages]
    local prevMsg = AI.Memory.RecentMessages[#AI.Memory.RecentMessages - 1]
    if prevMsg.Speaker == "Bot" and lastMsg.Speaker ~= "Bot" then
        local positiveResponses = {"да", "yes", "ага", "угу", "конечно", "точно", "верно"}
        local negativeResponses = {"нет", "no", "неа", "не", "неправильно"}
        for _, word in ipairs(positiveResponses) do
            if string.find(lastMsg.Text:lower(), word) then return "Отлично! Я рад что мы на одной волне!" end
        end
        for _, word in ipairs(negativeResponses) do
            if string.find(lastMsg.Text:lower(), word) then return "Понятно. У каждого своё мнение." end
        end
    end
    return nil
end

function Memory.LearnTrigger(AI, message, response)
    local words = {}
    for word in string.gmatch(message:lower(), "%S+") do
        if #word > 3 then words[word] = true end
    end
    for trigger, _ in pairs(AI.Memory.LearnedTriggers) do
        local knownWords = 0
        local totalWords = 0
        for word in string.gmatch(trigger:lower(), "%S+") do
            totalWords = totalWords + 1
            if words[word] then knownWords = knownWords + 1 end
        end
        if knownWords / math.max(totalWords, 1) > 0.7 then return end
    end
    AI.Memory.LearnedTriggers[message] = { Response = response, Time = tick(), Confidence = 1 }
end

function Memory.SearchLearned(AI, message)
    for trigger, data in pairs(AI.Memory.LearnedTriggers) do
        local similarity = Utils.CalculateSimilarity(message:lower(), trigger:lower())
        if similarity > 0.5 then
            data.Confidence = data.Confidence + 1
            return data.Response
        end
    end
    return nil
end

function Memory.AnalyzeSuccessPatterns(AI)
    if #AI.Memory.SuccessfulActions < 5 then return nil end
    local actionCounts = {}
    for _, record in ipairs(AI.Memory.SuccessfulActions) do
        actionCounts[record.Action] = (actionCounts[record.Action] or 0) + 1
    end
    local bestAction, bestCount = nil, 0
    for action, count in pairs(actionCounts) do
        if count > bestCount then bestCount = count; bestAction = action end
    end
    return bestAction, bestCount
end

function Memory.Cleanup(AI)
    local currentTime = tick()
    local maxAge = 300
    for i = #AI.Memory.RecentMessages, 1, -1 do
        if currentTime - AI.Memory.RecentMessages[i].Time > maxAge then table.remove(AI.Memory.RecentMessages, i) end
    end
    for i = #AI.Memory.ContextWindow, 1, -1 do
        if currentTime - AI.Memory.ContextWindow[i].Time > maxAge then table.remove(AI.Memory.ContextWindow, i) end
    end
end

function Memory.Update(AI)
    Memory.Cleanup(AI)
    if #AI.Memory.RecentMessages >= 3 and math.random(1, 100) <= 5 then
        local msg = AI.Memory.RecentMessages[math.random(1, #AI.Memory.RecentMessages)]
        if msg.Speaker ~= "Bot" then
            Memory.LearnTrigger(AI, msg.Text, "Интересно! Я запомню это.")
        end
    end
end

