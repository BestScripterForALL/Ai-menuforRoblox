local NeedsSystem = {}

function NeedsSystem.Initialize(AI)
    AI.Needs = AI.Needs or {
        Hunger = 100, Thirst = 100, Comfort = 100, Fun = 100, Social = 100
    }
end

function NeedsSystem.Update(AI)
    local decay = AI.Config.NeedsDecayRates
    AI.Needs.Hunger = math.clamp(AI.Needs.Hunger - (decay.Hunger or 0.1), 0, 100)
    AI.Needs.Thirst = math.clamp(AI.Needs.Thirst - (decay.Thirst or 0.08), 0, 100)
    AI.Needs.Comfort = math.clamp(AI.Needs.Comfort - (decay.Comfort or 0.05), 0, 100)
    AI.Needs.Fun = math.clamp(AI.Needs.Fun - (decay.Fun or 0.15), 0, 100)
    AI.Needs.Social = math.clamp(AI.Needs.Social - 0.12, 0, 100)

    if AI.State == "SIT" then
        AI.Needs.Comfort = math.clamp(AI.Needs.Comfort + 2, 0, 100)
        AI.Mood.Energy = math.clamp(AI.Mood.Energy + 1.5, 0, 100)
    elseif AI.State == "DANCE" then
        AI.Needs.Fun = math.clamp(AI.Needs.Fun + 3, 0, 100)
        AI.Needs.Hunger = math.clamp(AI.Needs.Hunger - 0.3, 0, 100)
    elseif AI.State == "GROUP_HANG" then
        AI.Needs.Social = math.clamp(AI.Needs.Social + 2, 0, 100)
        AI.Needs.Fun = math.clamp(AI.Needs.Fun + 1, 0, 100)
    elseif AI.State == "EXPLORE" then
        AI.Needs.Fun = math.clamp(AI.Needs.Fun + 1.5, 0, 100)
        AI.Needs.Hunger = math.clamp(AI.Needs.Hunger - 0.2, 0, 100)
    end

    if AI.Personality == "Lazy" then
        AI.Needs.Hunger = math.clamp(AI.Needs.Hunger - 0.05, 0, 100)
        AI.Needs.Comfort = math.clamp(AI.Needs.Comfort - 0.15, 0, 100)
    elseif AI.Personality == "Curious" then
        AI.Needs.Fun = math.clamp(AI.Needs.Fun - 0.25, 0, 100)
    elseif AI.Personality == "Aggressive" then
        AI.Needs.Social = math.clamp(AI.Needs.Social - 0.05, 0, 100)
    end
end

function NeedsSystem.CheckCriticalNeeds(AI)
    local threshold = 20
    if AI.Needs.Hunger < threshold then
        NeedsSystem.FindFood(AI)
        return true
    end
    if AI.Needs.Thirst < threshold then
        NeedsSystem.FindDrink(AI)
        return true
    end
    if AI.Needs.Comfort < threshold then
        AI.State = "SIT"; AI.ActionTimer = 30; return true
    end
    if AI.Needs.Fun < threshold then
        local funActions = {"DANCE", "PARTY", "EXPLORE", "SING"}
        AI.State = funActions[math.random(1, #funActions)]; AI.ActionTimer = 20; return true
    end
    if AI.Needs.Social < threshold then
        local crowdPos = AI.Modules.Navigation.FindCrowdCenter(AI)
        if crowdPos then AI.State = "GROUP_HANG"; AI.Target = crowdPos; return true end
    end
    return false
end

function NeedsSystem.FindFood(AI)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local foodKeywords = {"food", "pizza", "burger", "apple", "bread", "meat", "fish", "еда", "пицца", "бургер", "яблоко", "хлеб"}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.CanCollide then
            local name = obj.Name:lower()
            for _, keyword in ipairs(foodKeywords) do
                if string.find(name, keyword) then
                    local dist = (char.HumanoidRootPart.Position - obj.Position).Magnitude
                    if dist < 30 then
                        AI.Modules.Navigation.MoveToLocation(AI, obj.Position)
                        AI.Needs.Hunger = math.clamp(AI.Needs.Hunger + 50, 0, 100)
                        return true
                    end
                end
            end
        end
    end
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
            local parent = prompt.Parent
            if parent and parent:IsA("BasePart") then
                for _, keyword in ipairs(foodKeywords) do
                    if string.find(parent.Name:lower(), keyword) then
                        local dist = (char.HumanoidRootPart.Position - parent.Position).Magnitude
                        if dist < 15 then
                            pcall(function() prompt:InputHoldBegin() end)
                            AI.Needs.Hunger = math.clamp(AI.Needs.Hunger + 50, 0, 100)
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

function NeedsSystem.FindDrink(AI)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local drinkKeywords = {"drink", "water", "juice", "soda", "cola", "вода", "сок", "напиток", "кола"}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            for _, keyword in ipairs(drinkKeywords) do
                if string.find(name, keyword) then
                    local dist = (char.HumanoidRootPart.Position - obj.Position).Magnitude
                    if dist < 30 then
                        AI.Modules.Navigation.MoveToLocation(AI, obj.Position)
                        AI.Needs.Thirst = math.clamp(AI.Needs.Thirst + 50, 0, 100)
                        return true
                    end
                end
            end
        end
    end
    return false
end

