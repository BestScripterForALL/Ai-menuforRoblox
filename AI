local Relationships = {}

function Relationships.Initialize(AI)
    AI.Memory.PlayerRelationships = AI.Memory.PlayerRelationships or {}
end

function Relationships.Get(AI, player)
    if not player or not player.UserId then return nil end
    if not AI.Memory.PlayerRelationships[player.UserId] then
        AI.Memory.PlayerRelationships[player.UserId] = {
            Trust = AI.Config.RelationshipDefaults.Trust,
            Friendship = AI.Config.RelationshipDefaults.Friendship,
            Interactions = AI.Config.RelationshipDefaults.Interactions,
            FirstMet = tick(),
            LastSeen = tick(),
            PositiveInteractions = 0,
            NegativeInteractions = 0,
            SharedActivities = {},
            Notes = {}
        }
    end
    return AI.Memory.PlayerRelationships[player.UserId]
end

function Relationships.UpdateRelationship(AI, player, friendshipChange, trustChange, reason)
    local rel = Relationships.Get(AI, player)
    if not rel then return end
    rel.Friendship = math.clamp(rel.Friendship + (friendshipChange or 0), 0, 100)
    rel.Trust = math.clamp(rel.Trust + (trustChange or friendshipChange or 0) * 0.5, 0, 100)
    rel.Interactions = rel.Interactions + 1
    rel.LastSeen = tick()
    if (friendshipChange or 0) > 0 then rel.PositiveInteractions = rel.PositiveInteractions + 1
    elseif (friendshipChange or 0) < 0 then rel.NegativeInteractions = rel.NegativeInteractions + 1 end
    if reason then
        table.insert(rel.Notes, { Reason = reason, Time = tick() })
        if #rel.Notes > 20 then table.remove(rel.Notes, 1) end
    end
    AI.Mood.Trust = math.clamp(AI.Mood.Trust + (friendshipChange or 0) * 0.1, 0, 100)
end

function Relationships.GetFriendshipLevel(AI, player)
    local rel = Relationships.Get(AI, player)
    if not rel then return "Незнакомец" end
    if rel.Friendship >= 80 then return "Лучший друг"
    elseif rel.Friendship >= 60 then return "Друг"
    elseif rel.Friendship >= 40 then return "Приятель"
    elseif rel.Friendship >= 20 then return "Знакомый"
    else return "Незнакомец" end
end

function Relationships.IsTrusted(AI, player)
    local rel = Relationships.Get(AI, player)
    return rel and rel.Trust >= 60
end

function Relationships.IsIgnored(AI, player)
    return player and AI.BoredPlayers[player.UserId] == true
end

function Relationships.ShouldFollow(AI, player)
    local rel = Relationships.Get(AI, player)
    if not rel then return math.random(1, 100) <= 50 end
    local chance = rel.Friendship
    if AI.Personality == "Friendly" then chance = chance + 20
    elseif AI.Personality == "Shy" then
        chance = chance - 20
        if rel.Friendship < 50 then return false end
    elseif AI.Personality == "Aggressive" then
        if rel.Friendship < 30 then return false end
    end
    return math.random(1, 100) <= chance
end

function Relationships.GetBestFriend(AI)
    local bestFriend, bestScore = nil, 0
    for userId, rel in pairs(AI.Memory.PlayerRelationships) do
        local score = rel.Friendship + rel.Trust * 0.5
        if score > bestScore then bestScore = score; bestFriend = userId end
    end
    return bestFriend
end

function Relationships.CheckLongAbsence(AI)
    local currentTime = tick()
    for userId, rel in pairs(AI.Memory.PlayerRelationships) do
        if currentTime - rel.LastSeen > 600 then
            rel.Friendship = math.clamp(rel.Friendship - 0.1, 0, 100)
            rel.Trust = math.clamp(rel.Trust - 0.05, 0, 100)
        end
    end
end

function Relationships.RecordSharedActivity(AI, player, activity)
    local rel = Relationships.Get(AI, player)
    if not rel then return end
    table.insert(rel.SharedActivities, { Activity = activity, Time = tick() })
    if #rel.SharedActivities > 20 then table.remove(rel.SharedActivities, 1) end
end

function Relationships.GetStats(AI, player)
    local rel = Relationships.Get(AI, player)
    if not rel then return nil end
    return {
        Friendship = rel.Friendship, Trust = rel.Trust, Interactions = rel.Interactions,
        PositiveInteractions = rel.PositiveInteractions, NegativeInteractions = rel.NegativeInteractions,
        Level = Relationships.GetFriendshipLevel(AI, player), FirstMet = rel.FirstMet, LastSeen = rel.LastSeen
    }
end

function Relationships.IgnorePlayer(AI, player)
    if not player then return end
    AI.BoredPlayers[player.UserId] = true
    local rel = Relationships.Get(AI, player)
    if rel then rel.Friendship = math.clamp(rel.Friendship - 30, 0, 100); rel.Trust = math.clamp(rel.Trust - 20, 0, 100) end
end

function Relationships.UnignorePlayer(AI, player)
    if not player then return end
    AI.BoredPlayers[player.UserId] = nil
end

function Relationships.Update(AI)
    Relationships.CheckLongAbsence(AI)
    if math.random(1, 100) <= 5 then
        for userId, rel in pairs(AI.Memory.PlayerRelationships) do
            if rel.Friendship < 50 then rel.Friendship = math.clamp(rel.Friendship + 0.1, 0, 100) end
        end
    end
end

