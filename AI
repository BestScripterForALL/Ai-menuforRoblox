local function addMessage(sender, text)
    local msgFrame = Instance.new("Frame")
    msgFrame.Size = UDim2.new(1, 0, 0, 0)
    msgFrame.AutomaticSize = Enum.AutomaticSize.Y
    msgFrame.BackgroundTransparency = 1
    msgFrame.Parent = ChatScroll
    
    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, -10, 0, 0)
    txt.Position = UDim2.new(0, 5, 0, 0)
    txt.AutomaticSize = Enum.AutomaticSize.Y
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.Gotham
    txt.Text = sender .. ": " .. text
    txt.TextColor3 = (sender == "AI") and Color3.fromRGB(200, 180, 255) or Color3.fromRGB(230, 230, 240)
    txt.TextSize = 12
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.TextWrapped = true
    txt.Parent = msgFrame
end

local function sendToAI(promptText)
    if apiKey == "" then
        addMessage("System", "Ошибка: Введите API ключ в настройках!")
        return
    end
    
    addMessage("You", promptText)
    
    task.spawn(function()
        local success, response = pcall(function()
            local requestFunc = syn and syn.request or http_request or request
            local url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=" .. apiKey
            
            local data = {
                contents = {
                    {
                        parts = {
                            { text = systemPrompt },
                            { text = promptText }
                        }
                    }
                }
            }
            
            local res = requestFunc({
                Url = url,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = HttpService:JSONEncode(data)
            })
            
            local decoded = HttpService:JSONDecode(res.Body)
            return decoded.candidates[1].content.parts[1].text
        end)
        
        if success and response then
            addMessage("AI", response)
        else
            addMessage("AI", "Ошибка запроса к ИИ. Проверьте ключ или сеть.")
        end
    end)
end

SendBtn.MouseButton1Click:Connect(function()
    local text = ChatInputBox.Text
    if text ~= "" then
        ChatInputBox.Text = ""
        sendToAI(text)
    end
end)

