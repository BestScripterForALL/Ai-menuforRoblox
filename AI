local Security = {}
local actionHistory = {}

function Security.Initialize(AI)
    Security.StartMonitoring(AI)
end

function Security.StartMonitoring(AI)
    task.spawn(function()
        while AI.Active do
            Security.CheckForAdmins(AI)
            task.wait(math.random(10, 20))
        end
    end)
end

function Security.CheckForAdmins(AI)
    for _, player in ipairs(Players:GetPlayers()) do
        local adminKeywords = {"admin", "mod", "owner", "creator", "staff", "helper"}
        for _, kw in ipairs(adminKeywords) do
            if string.find(player.Name:lower(), kw) or string.find(player.DisplayName:lower(), kw) then
                Security.OnAdminDetected(AI, player); return
            end
        end
    end
end

function Security.OnAdminDetected(AI, player)
    AI.DecisionTimer = 10
    AI.WorldInteraction = false
    if player.Character and LocalPlayer.Character then
        local dist = (player.Character:GetPivot().Position - LocalPlayer.Character:GetPivot().Position).Magnitude
        if dist < 30 then AI.State = "SIT"; AI.ActionTimer = 30 end
    end
end

function Security.HumanizeChat(AI, text)
    if math.random(1, 100) <= 3 then
        local pos = math.random(1, #text)
        local chars = "abcdefghijklmnopqrstuvwxyz"
        text = text:sub(1, pos - 1) .. chars:sub(math.random(1, #chars), math.random(1, #chars)) .. text:sub(pos + 1)
    end
    task.wait(math.min(#text * 0.03, 1))
    return text
end

function Security.CleanupTraces()
    pcall(function() if workspace:FindFirstChild("AI_Logs") then workspace.AI_Logs:Destroy() end end)
end

