local WorldInteraction = {}

function WorldInteraction.Initialize(AI)
    AI.LastInteractTime = 0
    AI.InteractHistory = {}
end

function WorldInteraction.InteractWithEnvironment(AI)
    if not AI.Config.WorldInteractionEnabled or tick() - AI.LastInteractTime < AI.Config.InteractCooldownTime then return false end
    local prompt = WorldInteraction.FindNearestPrompt(AI)
    if prompt then return WorldInteraction.ActivatePrompt(AI, prompt) end
    local teleporter = WorldInteraction.FindTeleporter(AI)
    if teleporter then return WorldInteraction.UseTeleporter(AI, teleporter) end
    local vehicle = WorldInteraction.FindVehicle(AI)
    if vehicle then return WorldInteraction.EnterVehicle(AI, vehicle) end
    local lever = WorldInteraction.FindLever(AI)
    if lever then return WorldInteraction.ActivateLever(AI, lever) end
    local buttons = WorldInteraction.FindClickableButtons(AI)
    if #buttons > 0 then return WorldInteraction.ClickButton(AI, buttons) end
    local remote = WorldInteraction.FindSmartRemote(AI)
    if remote then return WorldInteraction.FireRemote(AI, remote) end
    return false
end

function WorldInteraction.FindNearestPrompt(AI)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local root = char.HumanoidRootPart
    local nearest, minDist = nil, AI.Config.PromptDetectionRadius
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local part = obj.Parent
            if part and part:IsA("BasePart") then
                local dist = (root.Position - part.Position).Magnitude
                if dist < minDist and (not obj.RequiresLineOfSight or WorldInteraction.IsInLineOfSight(AI, part)) then
                    minDist = dist; nearest = obj
                end
            end
        end
    end
    return nearest
end

function WorldInteraction.ActivatePrompt(AI, prompt)
    pcall(function() prompt:InputHoldBegin() end)
    AI.LastInteractTime = tick()
    UI.AddLog("Активирован: " .. (prompt.Parent and prompt.Parent.Name or "неизвестно"), Color3.fromRGB(0, 200, 255))
    return true
end

function WorldInteraction.FindTeleporter(AI)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local root = char.HumanoidRootPart
    local keywords = {"teleport", "portal", "door", "телепорт", "портал", "дверь"}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            for _, kw in ipairs(keywords) do if string.find(name, kw) and (root.Position - obj.Position).Magnitude < AI.Config.TeleporterDetectionRadius then return obj end end
        end
    end
    return nil
end

function WorldInteraction.UseTeleporter(AI, teleporter)
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart"); local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return false end
    Navigation.MoveToLocation(AI, teleporter.Position)
    root.CFrame = teleporter.CFrame + Vector3.new(0, 3, 0); task.wait(0.5)
    AI.LastInteractTime = tick()
    UI.AddLog("Использую телепорт!", Color3.fromRGB(150, 0, 255))
    return true
end

function WorldInteraction.FindVehicle(AI)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local root = char.HumanoidRootPart
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("VehicleSeat") or obj:IsA("Seat")) and obj:IsA("BasePart") then
            local dist = (root.Position - obj.Position).Magnitude
            if dist < AI.Config.VehicleDetectionRadius and obj.Occupant == nil then return obj end
        end
    end
    return nil
end

function WorldInteraction.EnterVehicle(AI, vehicle)
    local char = LocalPlayer.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    pcall(function() vehicle:Sit(humanoid) end)
    AI.LastInteractTime = tick()
    AI.InVehicle = true; AI.VehicleSeat = vehicle
    UI.AddLog("Сажусь в транспорт!", Color3.fromRGB(0, 150, 255))
    return true
end

function WorldInteraction.FindLever(AI)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local root = char.HumanoidRootPart
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ClickDetector") then
            local part = obj.Parent
            if part and part:IsA("BasePart") and (root.Position - part.Position).Magnitude < AI.Config.LeverDetectionRadius then return obj end
        end
    end
    return nil
end

function WorldInteraction.ActivateLever(AI, lever)
    pcall(function() fireclickdetector(lever) end)
    AI.LastInteractTime = tick()
    UI.AddLog("Активирую рычаг!", Color3.fromRGB(255, 150, 0))
    return true
end

function WorldInteraction.FindClickableButtons(AI)
    local buttons = {}
    pcall(function()
        for _, gui in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
            if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and gui.Visible and gui.Active then
                local text = gui:IsA("TextButton") and gui.Text or ""
                table.insert(buttons, {Object = gui, Text = text})
            end
        end
    end)
    return buttons
end

function WorldInteraction.ClickButton(AI, buttons)
    local meaningful, keywords = {}, {"play", "start", "collect", "get", "buy", "open", "enter", "go"}
    for _, btn in ipairs(buttons) do
        for _, kw in ipairs(keywords) do if string.find(btn.Text:lower(), kw) then table.insert(meaningful, btn); break end end
    end
    if #meaningful > 0 then
        local chosen = meaningful[math.random(1, #meaningful)]
        pcall(function() if chosen.Object.Events and chosen.Object.Events.MouseButton1Click then chosen.Object.Events.MouseButton1Click:Fire() end end)
        AI.LastInteractTime = tick()
        UI.AddLog("Нажата кнопка: " .. chosen.Text, Color3.fromRGB(255, 200, 100))
        return true
    end
    return false
end

function WorldInteraction.FindSmartRemote(AI)
    for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            local name = remote.Name:lower()
            if string.find(name, "collect") or string.find(name, "pickup") or string.find(name, "click") then return remote end
        end
    end
    return nil
end

function WorldInteraction.FireRemote(AI, remote)
    pcall(function() remote:FireServer() end)
    AI.LastInteractTime = tick()
    UI.AddLog("Отправлен ремот: " .. remote.Name, Color3.fromRGB(200, 100, 255))
    return true
end

function WorldInteraction.IsInLineOfSight(AI, part)
    local char = LocalPlayer.Character
    if not char or not part then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local rayOrigin = root.Position
    local rayDir = (part.Position - root.Position).Unit * 100
    local params = RaycastParams.new(); params.FilterDescendantsInstances = {char}; params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(rayOrigin, rayDir, params)
    return result and result.Instance:IsDescendantOf(part.Parent) or false
end

function WorldInteraction.ExitVehicle(AI)
    if AI.InVehicle and AI.VehicleSeat then
        pcall(function() AI.VehicleSeat:Sit(nil) end)
        AI.InVehicle = false; AI.VehicleSeat = nil
    end
end

