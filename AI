local Personality = {}
local Personalities = {}

function Personality.Initialize(AI)
    Personalities = AI.Config.Personalities
    Personality.Color = Personalities[AI.Personality].Color
    Personality.ApplyPersonalityModifiers(AI)
end

function Personality.ApplyPersonalityModifiers(AI)
    local pers = Personalities[AI.Personality]
    if not pers then return end
    AI.Mood.SocialNeed = math.clamp(AI.Mood.SocialNeed + pers.SocialBonus, 0, 100)
end

function Personality.GetResponse(personality, responses)
    if not responses then return nil end
    local persResponses = responses[personality or AI.Personality]
    if persResponses and type(persResponses) == "table" and #persResponses > 0 then
        return persResponses[math.random(1, #persResponses)]
    end
    local friendlyResponses = responses["Friendly"]
    if friendlyResponses and type(friendlyResponses) == "table" and #friendlyResponses > 0 then
        return friendlyResponses[math.random(1, #friendlyResponses)]
    end
    if type(responses) == "string" then return responses end
    return "..."
end

function Personality.Update(AI)
    local pers = Personalities[AI.Personality]
    if not pers then return end
    AI.Mood.Energy = math.clamp(AI.Mood.Energy - 0.2 * pers.EnergyDecay, 0, 100)
    AI.Mood.Boredom = math.clamp(AI.Mood.Boredom + 0.1 * pers.BoredomDecay, 0, 100)

    if AI.Personality == "Friendly" then
        if AI.State == "GROUP_HANG" then
            AI.Mood.Happiness = math.clamp(AI.Mood.Happiness + 0.3, 0, 100)
        end
        AI.Mood.Trust = math.clamp(AI.Mood.Trust + 0.05, 0, 100)
    elseif AI.Personality == "Aggressive" then
        if AI.State == "GROUP_HANG" then
            AI.Mood.Happiness = math.clamp(AI.Mood.Happiness - 0.2, 0, 100)
        end
        AI.Mood.Fear = math.clamp(AI.Mood.Fear - 0.1 * pers.FearResistance, 0, 100)
    elseif AI.Personality == "Shy" then
        if AI.State == "GROUP_HANG" then
            AI.Mood.Fear = math.clamp(AI.Mood.Fear + 0.5, 0, 100)
            if AI.Mood.Fear > 80 then
                return "SCARED"
            end
        end
        AI.Mood.SocialNeed = math.clamp(AI.Mood.SocialNeed - 0.2, 0, 100)
    elseif AI.Personality == "Curious" then
        AI.Mood.Curiosity = math.clamp(AI.Mood.Curiosity + 0.2, 0, 100)
        if AI.Mood.Curiosity > 90 then
            AI.Mood.Curiosity = 50
            return "EXPLORE"
        end
    elseif AI.Personality == "Lazy" then
        if AI.State == "IDLE" and math.random(1, 100) <= 15 then
            return "SIT"
        end
    end
    return nil
end

function Personality.ReactToEvent(AI, event, data)
    local pers = Personalities[AI.Personality]
    if not pers then return end
    if event == "PLAYER_JOINED" then
        if AI.Personality == "Friendly" then
            AI.Mood.Happiness = math.clamp(AI.Mood.Happiness + 5, 0, 100)
        elseif AI.Personality == "Shy" then
            AI.Mood.Fear = math.clamp(AI.Mood.Fear + 10, 0, 100)
        elseif AI.Personality == "Curious" then
            AI.Mood.Curiosity = math.clamp(AI.Mood.Curiosity + 15, 0, 100)
        end
    elseif event == "PLAYER_LEFT" then
        if AI.Personality == "Friendly" then
            AI.Mood.Happiness = math.clamp(AI.Mood.Happiness - 3, 0, 100)
        elseif AI.Personality == "Aggressive" then
            AI.Mood.Happiness = math.clamp(AI.Mood.Happiness + 2, 0, 100)
        end
    elseif event == "COMPLIMENT_RECEIVED" then
        AI.Mood.Happiness = math.clamp(AI.Mood.Happiness + (AI.Personality == "Shy" and 20 or 10), 0, 100)
    elseif event == "INSULT_RECEIVED" then
        if AI.Personality == "Aggressive" then
            AI.Mood.Happiness = math.clamp(AI.Mood.Happiness - 30, 0, 100)
            return "AGGRESSIVE_RESPONSE"
        elseif AI.Personality == "Shy" then
            AI.Mood.Fear = math.clamp(AI.Mood.Fear + 30, 0, 100)
            return "SCARED"
        elseif AI.Personality == "Friendly" then
            AI.Mood.Happiness = math.clamp(AI.Mood.Happiness - 15, 0, 100)
        end
    elseif event == "SCARED" then
        local fearIncrease = 30 / pers.FearResistance
        AI.Mood.Fear = math.clamp(AI.Mood.Fear + fearIncrease, 0, 100)
        if AI.Mood.Fear > 70 then return "FLEE" end
    end
    return nil
end

function Personality.WillTalk(AI)
    local pers = Personalities[AI.Personality]
    if not pers then return math.random(1, 100) <= 50 end
    local chance = pers.TalkChance
    if AI.State == "GROUP_HANG" and AI.Personality == "Shy" then
        chance = chance * 0.3
    end
    if AI.Mood.Fear > 60 then chance = chance * 0.5 end
    if AI.Mood.Happiness > 80 then chance = chance * 1.3 end
    return math.random(1, 100) <= chance
end

