local Actions = {}

function Actions.Initialize(AI)
    AI.DanceStep = 1
    AI.WaveCount = 0
end

function Actions.ProcessAction(AI, char, humanoid)
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if AI.State == "DANCE" then Actions.Dance(AI, char, humanoid, root)
    elseif AI.State == "WAVE" then Actions.Wave(AI, char, humanoid, root)
    elseif AI.State == "HUG" then Actions.Hug(AI, char, humanoid, root)
    elseif AI.State == "JUMP" then humanoid.Jump = true
    elseif AI.State == "CLAP" then humanoid.Jump = true; task.wait(0.3)
    elseif AI.State == "SING" then ChatHandler.Speak(AI, "🎵 Ла-ла-ла! Я пою симфонию Lua! 🎵")
    elseif AI.State == "BACKFLIP" then humanoid.Jump = true; root.CFrame = root.CFrame * CFrame.Angles(math.rad(180), 0, 0); task.wait(0.5)
    elseif AI.State == "SLEEP" then humanoid.Sit = true; ChatHandler.Speak(AI, "😴 Zzz..."); AI.Mood.Energy = math.clamp(AI.Mood.Energy + 5, 0, 100)
    elseif AI.State == "COMPLIMENT" then ChatHandler.Speak(AI, "Ты просто замечательный! 🌟")
    elseif AI.State == "PARTY" then Actions.Party(AI, char, humanoid, root)
    elseif AI.State == "SCARED" then Actions.Scared(AI, char, humanoid, root)
    elseif AI.State == "SURPRISE" then humanoid.Jump = true; ChatHandler.Speak(AI, "😲 Ого!")
    elseif AI.State == "RAINBOW" then for i = 1, 7 do root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(51.4), 0); task.wait(0.1) end
    elseif AI.State == "GIFT" then humanoid:MoveTo(root.Position); ChatHandler.Speak(AI, "🎁 Дарю тебе хорошее настроение!")
    elseif AI.State == "COUNT" then ChatHandler.Speak(AI, "1... 2... 3... 4... 5! Готово!")
    elseif AI.State == "SIT" then humanoid.Sit = true; AI.Mood.Energy = math.clamp(AI.Mood.Energy + 3, 0, 100)
    elseif AI.State == "SPIN" then root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(30), 0)
    end
end

function Actions.Dance(AI, char, humanoid, root)
    AI.DanceStep = AI.DanceStep + 1
    if AI.DanceStep > 5 then AI.DanceStep = 1 end
    if AI.DanceStep == 1 then humanoid.Jump = true; root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(90), 0)
    elseif AI.DanceStep == 2 then root.CFrame = root.CFrame + (root.CFrame.RightVector * 3); root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(-180), 0)
    elseif AI.DanceStep == 3 then humanoid.Sit = true; task.wait(0.2); humanoid.Sit = false
    elseif AI.DanceStep == 4 then root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(180), 0)
    else humanoid.Jump = true; root.CFrame = root.CFrame + (root.CFrame.LookVector * 2) end
    AI.Mood.Happiness = math.clamp(AI.Mood.Happiness + 2, 0, 100)
end

function Actions.Wave(AI, char, humanoid, root)
    AI.WaveCount = AI.WaveCount + 1
    root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(15 * math.sin(AI.WaveCount)), 0)
    if AI.WaveCount >= 6 then AI.WaveCount = 0; AI.ActionTimer = 0 end
end

function Actions.Hug(AI, char, humanoid, root)
    if not AI.HugTarget or not AI.HugTarget:FindFirstChild("HumanoidRootPart") then AI.ActionTimer = 0; return end
    local targetRoot = AI.HugTarget.HumanoidRootPart
    local dist = (root.Position - targetRoot.Position).Magnitude
    if dist > 5 then humanoid:MoveTo(targetRoot.Position)
    else humanoid:MoveTo(root.Position); TweenService:Create(root, TweenInfo.new(0.2), { CFrame = CFrame.lookAt(root.Position, targetRoot.Position) }):Play(); task.wait(0.5); AI.ActionTimer = 0; AI.HugTarget = nil end
end

function Actions.Party(AI, char, humanoid, root)
    for i = 1, 3 do humanoid.Jump = true; task.wait(0.3); root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(60), 0) end
end

function Actions.Scared(AI, char, humanoid, root)
    local fleeDir = -root.CFrame.LookVector
    local fleePos = root.Position + fleeDir * 30
    local prevWalkSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = 24
    humanoid:MoveTo(fleePos); task.wait(2.0)
    humanoid:MoveTo(root.Position); humanoid.WalkSpeed = prevWalkSpeed
    ChatHandler.Speak(AI, "Ай, страшно! Убегаю!")
    AI.Mood.Fear = math.clamp(AI.Mood.Fear + 20, 0, 100)
end

