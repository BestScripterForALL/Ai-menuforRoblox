function Personality.RandomizePersonality(AI)
    if math.random(1, 1000) <= 1 then
        local personalities = {"Friendly", "Aggressive", "Shy", "Curious", "Lazy"}
        local newPersonality = personalities[math.random(1, #personalities)]
        if newPersonality ~= AI.Personality then
            AI.Personality = newPersonality
            Personality.ApplyPersonalityModifiers(AI)
            return true
        end
    end
    return false
end

