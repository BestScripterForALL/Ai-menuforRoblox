local Utils = {}

function Utils.Clamp(value, min, max)
    return math.max(min, math.min(max, value))
end

function Utils.Lerp(a, b, t)
    return a + (b - a) * t
end

function Utils.Distance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

function Utils.RandomInRange(min, max)
    return min + math.random() * (max - min)
end

function Utils.RandomSign()
    return math.random(0, 1) == 0 and -1 or 1
end

function Utils.NormalizeAngle(angle)
    while angle > math.pi do angle = angle - 2 * math.pi end
    while angle < -math.pi do angle = angle + 2 * math.pi end
    return angle
end

function Utils.ContainsWord(text, word)
    return string.find(text:lower(), word:lower()) ~= nil
end

function Utils.ContainsAnyWord(text, words)
    local lowerText = text:lower()
    for _, word in ipairs(words) do
        if string.find(lowerText, word:lower()) then
            return true
        end
    end
    return false
end

function Utils.ExtractWords(text)
    local words = {}
    for word in string.gmatch(text:lower(), "%S+") do
        table.insert(words, word)
    end
    return words
end

function Utils.CapitalizeFirst(text)
    if #text == 0 then return text end
    return text:sub(1, 1):upper() .. text:sub(2)
end

function Utils.Trim(text)
    return text:match("^%s*(.-)%s*$") or ""
end

function Utils.ReplaceVariables(text, variables)
    for key, value in pairs(variables) do
        text = string.gsub(text, "{" .. key .. "}", tostring(value))
    end
    return text
end

function Utils.RandomChoice(tbl)
    if #tbl == 0 then return nil end
    return tbl[math.random(1, #tbl)]
end

function Utils.Shuffle(tbl)
    for i = #tbl, 2, -1 do
        local j = math.random(i)
        tbl[i], tbl[j] = tbl[j], tbl[i]
    end
    return tbl
end

function Utils.CopyTable(tbl)
    local copy = {}
    for k, v in pairs(tbl) do
        if type(v) == "table" then
            copy[k] = Utils.CopyTable(v)
        else
            copy[k] = v
        end
    end
    return copy
end

function Utils.MergeTables(...)
    local result = {}
    for _, tbl in ipairs({...}) do
        for k, v in pairs(tbl) do
            if type(v) == "table" and type(result[k]) == "table" then
                result[k] = Utils.MergeTables(result[k], v)
            else
                result[k] = v
            end
        end
    end
    return result
end

function Utils.TableLength(tbl)
    local count = 0
    for _ in pairs(tbl) do
        count = count + 1
    end
    return count
end

function Utils.TableToArray(tbl)
    local array = {}
    for _, v in pairs(tbl) do
        table.insert(array, v)
    end
    return array
end

function Utils.GetLookVector(cframe)
    return cframe.LookVector
end

function Utils.GetRightVector(cframe)
    return cframe.RightVector
end

function Utils.GetUpVector(cframe)
    return cframe.UpVector
end

function Utils.RotateTowards(current, target, maxAngle)
    local currentDir = current.LookVector
    local targetDir = (target - current.Position).Unit
    local angle = math.acos(math.clamp(currentDir:Dot(targetDir), -1, 1))
    if angle < 0.001 then return current end
    local t = math.min(maxAngle / angle, 1)
    local axis = currentDir:Cross(targetDir).Unit
    return CFrame.fromAxisAngle(axis, angle * t) * current
end

function Utils.GetTimestamp()
    return os.time()
end

function Utils.FormatTime(seconds)
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    if hours > 0 then
        return string.format("%02d:%02d:%02d", hours, minutes, secs)
    else
        return string.format("%02d:%02d", minutes, secs)
    end
end

function Utils.Debounce(delay)
    local lastCall = 0
    return function(callback, ...)
        local now = tick()
        if now - lastCall >= delay then
            lastCall = now
            return callback(...)
        end
        return nil
    end
end

function Utils.Once(callback)
    local called = false
    return function(...)
        if not called then
            called = true
            return callback(...)
        end
    end
end

function Utils.CalculateSimilarity(str1, str2)
    local words1 = {}
    for word in string.gmatch(str1:lower(), "%S+") do
        words1[word] = true
    end
    local words2 = {}
    for word in string.gmatch(str2:lower(), "%S+") do
        words2[word] = true
    end
    local intersection = 0
    local union = 0
    for word in pairs(words1) do
        union = union + 1
        if words2[word] then intersection = intersection + 1 end
    end
    for word in pairs(words2) do
        if not words1[word] then union = union + 1 end
    end
    if union == 0 then return 0 end
    return intersection / union
end

function Utils.FuzzyMatch(message, triggers, threshold)
    threshold = threshold or 0.3
    local msgLower = message:lower()
    for _, trigger in ipairs(triggers) do
        if string.find(msgLower, trigger:lower()) then
            return true
        end
    end
    for _, trigger in ipairs(triggers) do
        local similarity = Utils.CalculateSimilarity(msgLower, trigger:lower())
        if similarity >= threshold then
            return true
        end
    end
    return false
end

function Utils.SafeCall(func, ...)
    local success, result = pcall(func, ...)
    if not success then
        warn("SafeCall error:", result)
    end
    return success, result
end

function Utils.SafeWait(duration)
    local start = tick()
    while tick() - start < duration do
        task.wait(0.1)
    end
end

function Utils.SafeFind(obj, path)
    local parts = path:split(".")
    local current = obj
    for _, part in ipairs(parts) do
        if current and type(current) == "table" then
            current = current[part]
        else
            return nil
        end
    end
    return current
end

