-- 14. AI CORE
-- ==========================================
local AI_Core = {}

function AI_Core.Initialize(Config)
    local AI = {
        Active = false, State = "IDLE", Target = nil,
        Mood = {}, Needs = {},
        Memory = { RecentMessages = {}, SuccessfulActions = {}, FailedActions = {}, PlayerRelationships = {}, LearnedTriggers = {} },
        BoredPlayers = {}, GroupHangStart = 0, InGroupHang = false, GroupHangCooldown = 0,
        InteractCooldown = 0, ActionTimer = 0, DecisionTimer = Config.DecisionTimerDefault,
        DanceStep = 1, WaveCount = 0, HugTarget = nil,
        Personality = "Friendly", Config = Config
    }
    for k, v in pairs(Config.MoodDefaults) do AI.Mood[k] = v end
    for k, v in pairs(Config.NeedsDefaults) do AI.Needs[k] = v end
    local personalities = {"Friendly", "Aggressive", "Shy", "Curious", "Lazy"}
    AI.Personality = personalities[math.random(1, #personalities)]
    return AI
end

function AI_Core.StartMainLoop(AI)
    task.spawn(function()
        while task.wait(AI.Config.UpdateTick) do
            if not AI.Active then UI.UpdateStatus("Неактивен"); continue end
            local char = LocalPlayer.Character
            if not char then UI.UpdateStatus("Нет персонажа"); continue end
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if not humanoid or not root then UI.UpdateStatus("Загрузка..."); continue end
            if humanoid.Health <= 0 then
                if AI.State ~= "DEAD" then AI.State = "DEAD"; AI.Target = nil; AI.InGroupHang = false; UI.AddLog("Респавн...", Color3.fromRGB(200, 50, 50)) end
                continue
            end
            if AI.State == "DEAD" then AI.State = "IDLE"; UI.AddLog("Восстановление систем.", Color3.fromRGB(50, 255, 50)) end

            Personality.Update(AI)
            NeedsSystem.Update(AI)
            Memory.Update(AI)
            Relationships.Update(AI)
            UI.UpdateAll(AI)

            if AI.State == "IDLE" or AI.State == "PATROL" or AI.State == "EXPLORE" then
                if WorldInteraction.InteractWithEnvironment(AI) then AI.DecisionTimer = 2; continue end
            end

            if AI.ActionTimer > 0 then
                AI.ActionTimer = AI.ActionTimer - 1
                Actions.ProcessAction(AI, char, humanoid)
                if AI.ActionTimer <= 0 and AI.State ~= "HUG" then AI.State = "IDLE"; humanoid.Sit = false end
                continue
            end

            if AI.State == "IDLE" then
                humanoid.Sit = false; AI.DecisionTimer = AI.DecisionTimer - AI.Config.UpdateTick
                if AI.DecisionTimer <= 0 then
                    AI.DecisionTimer = math.random(3, 7)
                    if AI.GroupHangCooldown > 0 and tick() - AI.GroupHangCooldown < AI.Config.GroupHangCooldownTime then
                        AI.State = math.random(1, 100) <= 70 and "EXPLORE" or "PATROL"; continue
                    end
                    if ChatHandler.CheckNearbyVoiceChat(AI) then continue end
                    if AI.Mood.Energy < 25 then AI.State = "SIT"; AI.ActionTimer = 25; continue end
                    if NeedsSystem.CheckCriticalNeeds(AI) then continue end
                    if AI.Mood.Happiness > 60 and math.random(1, 100) <= 25 then
                        local crowdPos = Navigation.FindCrowdCenter(AI)
                        if crowdPos and not AI.InGroupHang then
                            local allBored = true
                            for _, p in ipairs(Players:GetPlayers()) do
                                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and (p.Character.HumanoidRootPart.Position - crowdPos).Magnitude < 25 and not AI.BoredPlayers[p.UserId] then
                                    allBored = false; break
                                end
                            end
                            if allBored then UI.AddLog("Эта компания мне наскучила. Ухожу.", Color3.fromRGB(255, 100, 100)); AI.State = "EXPLORE"
                            else AI.State = "GROUP_HANG"; AI.Target = crowdPos; AI.GroupHangStart = tick(); AI.InGroupHang = true; UI.AddLog("Заметил компанию! Присоединяюсь.", Color3.fromRGB(255, 100, 255)) end
                            continue
                        end
                    end
                    local actions = {"DANCE", "JOKE", "PHILOSOPHY", "SING", "COMPLIMENT", "WAVE", "PARTY", "WEATHER", "FOOD", "PET", "MUSIC", "GAME"}
                    local chosenAction = actions[math.random(1, #actions)]
                    if chosenAction == "DANCE" then AI.State = "DANCE"; AI.ActionTimer = 30
                    elseif chosenAction == "JOKE" then AI.State = "JOKE"
                    elseif chosenAction == "PHILOSOPHY" then AI.State = "PHILOSOPHY"
                    elseif chosenAction == "SING" then AI.State = "SING"; AI.ActionTimer = 20
                    elseif chosenAction == "COMPLIMENT" then AI.State = "COMPLIMENT"; AI.ActionTimer = 5
                    elseif chosenAction == "WAVE" then AI.State = "WAVE"; AI.ActionTimer = 15
                    elseif chosenAction == "PARTY" then AI.State = "PARTY"; AI.ActionTimer = 25
                    else
                        local categoryMap = { WEATHER = "WeatherComments", FOOD = "FoodComments", PET = "PetReactions", MUSIC = "MusicReactions", GAME = "GameReactions" }
                        local catName = categoryMap[chosenAction]
                        if catName and KnowledgeBase[catName] then
                            local resp = Personality.GetResponse(AI.Personality, KnowledgeBase[catName].Responses)
                            if resp then ChatHandler.Speak(AI, resp) end
                        end
                    end
                end
            elseif AI.State == "GROUP_HANG" and AI.Target then
                local dist = (root.Position - AI.Target).Magnitude
                if dist > 10 then Navigation.MoveToLocation(AI, AI.Target)
                else
                    humanoid:MoveTo(root.Position)
                    local timeInGroup = tick() - AI.GroupHangStart
                    if timeInGroup < AI.Config.GroupHangMinDuration then
                        if math.random(1, 100) <= 30 then
                            local resp = Personality.GetResponse(AI.Personality, KnowledgeBase.GroupReactions.Responses)
                            if resp then ChatHandler.Speak(AI, resp) end
                            AI.Mood.Happiness = math.clamp(AI.Mood.Happiness + 5, 0, 100)
                        end
                    else
                        if AI.Mood.Boredom > 80 or AI.Mood.Happiness < 30 then
                            for _, p in ipairs(Players:GetPlayers()) do
                                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and (p.Character.HumanoidRootPart.Position - AI.Target).Magnitude < 25 then
                                    AI.BoredPlayers[p.UserId] = true
                                end
                            end
                            local resp = Personality.GetResponse(AI.Personality, KnowledgeBase.GroupBoringReactions.Responses)
                            if resp then ChatHandler.Speak(AI, resp) end
                            UI.AddLog("Компания скучная. Ухожу.", Color3.fromRGB(200, 100, 100))
                            AI.State = "IDLE"; AI.Target = nil; AI.InGroupHang = false; AI.GroupHangCooldown = tick()
                        else
                            if math.random(1, 100) <= 40 then
                                ChatHandler.Speak(AI, "Посидел с вами, пойду дальше.")
                                AI.State = "IDLE"; AI.Target = nil; AI.InGroupHang = false
                            end
                        end
                    end
                end
            elseif AI.State == "JOKE" then
                local resp = Personality.GetResponse(AI.Personality, KnowledgeBase.Jokes.Responses)
                if resp then ChatHandler.Speak(AI, resp) end; AI.State = "IDLE"
            elseif AI.State == "PHILOSOPHY" then
                local resp = Personality.GetResponse(AI.Personality, KnowledgeBase.Philosophy.Responses)
                if resp then ChatHandler.Speak(AI, resp) end; AI.State = "IDLE"
            elseif AI.State == "EXPLORE" then Navigation.Explore(AI, char, humanoid, root); AI.State = "IDLE"
            elseif AI.State == "FOLLOW" and AI.Target and AI.Target:FindFirstChild("HumanoidRootPart") then
                if (root.Position - AI.Target.HumanoidRootPart.Position).Magnitude > 8 then Navigation.MoveToLocation(AI, AI.Target.HumanoidRootPart.Position) else humanoid:MoveTo(root.Position) end
            elseif AI.State == "HELP" and AI.Target and AI.Target:FindFirstChild("HumanoidRootPart") then
                if (root.Position - AI.Target.HumanoidRootPart.Position).Magnitude > 5 then Navigation.MoveToLocation(AI, AI.Target.HumanoidRootPart.Position) else ChatHandler.Speak(AI, "Держись, друг! Я рядом!"); AI.State = "IDLE" end
            elseif AI.State == "PATROL" then Navigation.Patrol(AI, char, humanoid, root); AI.State = "IDLE"
            end
        end
    end)
end

