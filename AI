-- 9. CHAT HANDLER
-- ==========================================
local ChatHandler = {}

function ChatHandler.Initialize(AI, KnowledgeBase)
    for _, player in ipairs(Players:GetPlayers()) do
        ChatHandler.ConnectPlayerChat(AI, player, KnowledgeBase)
    end
    Players.PlayerAdded:Connect(function(player)
        ChatHandler.ConnectPlayerChat(AI, player, KnowledgeBase)
    end)
end

function ChatHandler.ConnectPlayerChat(AI, player, KnowledgeBase)
    player.Chatted:Connect(function(message)
        ChatHandler.ProcessMessage(AI, player, message, KnowledgeBase)
    end)
end

function ChatHandler.ProcessMessage(AI, player, message, KnowledgeBase)
    if not AI.Active or player == LocalPlayer then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
    local dist = (char.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
    if dist > AI.Config.DetectionRadius then return end
    if AI.BoredPlayers[player.UserId] then return end

    AI.Modules.Memory.AddMessage(AI, message, player.Name)
    AI.Modules.Relationships.UpdateRelationship(AI, player, 2, nil, "Chat message")

    local lookPos = player.Character.HumanoidRootPart.Position
    TweenService:Create(char.HumanoidRootPart, TweenInfo.new(0.3), {
        CFrame = CFrame.lookAt(char.HumanoidRootPart.Position, Vector3.new(lookPos.X, char.HumanoidRootPart.Position.Y, lookPos.Z))
    }):Play()

    local contextResponse = AI.Modules.Memory.GetContextResponse(AI)
    if contextResponse then ChatHandler.Speak(AI, contextResponse); return end

    local learnedResponse = AI.Modules.Memory.SearchLearned(AI, message)
    if learnedResponse then ChatHandler.Speak(AI, learnedResponse); return end

    for _, category in pairs(KnowledgeBase) do
        if category.Triggers and Utils.FuzzyMatch(message, category.Triggers, AI.Config.FuzzyMatchThreshold) then
            local response = Personality.GetResponse(AI.Personality, category.Responses)
            if response then ChatHandler.Speak(AI, response) end
            if category.Action then
                AI.State = category.Action
                if category.Action == "DANCE" then AI.ActionTimer = 25
                elseif category.Action == "SIT" then AI.ActionTimer = 20
                elseif category.Action == "FOLLOW" then AI.Target = player.Character; AI.State = "FOLLOW"
                elseif category.Action == "STOP" then AI.Target = nil; AI.State = "IDLE"
                elseif category.Action == "HUG" then AI.HugTarget = player.Character; AI.ActionTimer = 30
                elseif category.Action == "HELP" then AI.Target = player.Character; AI.State = "HELP"
                else AI.ActionTimer = 15 end
            end
            AI.Modules.Memory.RecordSuccess(AI, "category", message)
            AI.Modules.Memory.LearnTrigger(AI, message, response)
            return
        end
    end
end

function ChatHandler.Speak(AI, text)
    if AI.Modules.Security then text = AI.Modules.Security.HumanizeChat(AI, text) end
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        pcall(function() TextChatService.TextChannels.RBXGeneral:SendAsync(text) end)
    else
        pcall(function() ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(text, "All") end)
    end
    UI.AddLog("Чат: " .. text, Color3.fromRGB(255, 255, 100))
    AI.Mood.SocialNeed = 100
    AI.Mood.Happiness = math.clamp(AI.Mood.Happiness + 5, 0, 100)
    AI.Modules.Memory.AddMessage(AI, text, "Bot")
end

function ChatHandler.CheckNearbyVoiceChat(AI)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (char.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
            if dist < AI.Config.VoiceDetectRadius then
                local hasVoice = false
                pcall(function() if player:GetAttribute("VoiceEnabled") then hasVoice = true end end)
                if hasVoice then
                    local isTalking = false
                    pcall(function() if player:GetAttribute("IsTalking") == true then isTalking = true end end)
                    if math.random(1, 100) <= 40 then
                        local hum = player.Character:FindFirstChildOfClass("Humanoid")
                        local speechPool = { "О, я слышу твой голос через войс-чат! Привет!" }
                        ChatHandler.Speak(AI, speechPool[math.random(1, #speechPool)])
                        AI.Mood.Happiness = math.clamp(AI.Mood.Happiness + 8, 0, 100)
                        return true
                    end
                end
            end
        end
    end
    return false
end

