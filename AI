-- 11. NAVIGATION
-- ==========================================
local Navigation = {}

function Navigation.Initialize(AI)
    AI.LastPathPosition = nil
    AI.StuckCounter = 0
    AI.PathRetries = 0
end

function Navigation.MoveToLocation(AI, targetPos)
    local char = LocalPlayer.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return false end

    if AI.LastPathPosition then
        local movedDistance = (root.Position - AI.LastPathPosition).Magnitude
        if movedDistance < 2 then AI.StuckCounter = AI.StuckCounter + 1 else AI.StuckCounter = 0 end
        if AI.StuckCounter > 5 then Navigation.HandleStuck(AI, humanoid, root); AI.StuckCounter = 0; return false end
    end
    AI.LastPathPosition = root.Position

    if Navigation.CheckAbyss(AI, char) then return false end

    local path = PathfindingService:CreatePath(AI.Config.PathfindingSettings)
    local success = pcall(function() path:ComputeAsync(root.Position, targetPos) end)
    if not success or path.Status ~= Enum.PathStatus.Success then
        AI.PathRetries = AI.PathRetries + 1
        if AI.PathRetries > 3 then local altPos = Navigation.FindAlternativePosition(AI, targetPos); if altPos then path:ComputeAsync(root.Position, altPos) end end
        return false
    end
    AI.PathRetries = 0

    for _, waypoint in ipairs(path:GetWaypoints()) do
        if not AI.Active or (AI.State ~= "PATROL" and AI.State ~= "FOLLOW" and AI.State ~= "EXPLORE" and AI.State ~= "GROUP_HANG") then break end
        if Navigation.CheckAbyss(AI, char) then AI.State = "IDLE"; return false end
        if waypoint.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
        humanoid:MoveTo(waypoint.Position)
        AI.Mood.Energy = math.clamp(AI.Mood.Energy - 0.4, 0, 100)
        local timeout = 0
        while timeout < 15 and (root.Position - waypoint.Position).Magnitude > 4 do
            timeout = timeout + 1; task.wait(0.1)
            if humanoid.MoveDirection.Magnitude == 0 then humanoid.Jump = true end
            if Navigation.CheckAbyss(AI, char) then humanoid:MoveTo(root.Position); return false end
        end
    end
    return true
end

function Navigation.CheckAbyss(AI, char)
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return false end
    local aheadPos = root.Position + (root.CFrame.LookVector * 4)
    local rayOrigin = aheadPos + Vector3.new(0, 2, 0); local rayDir = Vector3.new(0, -22, 0)
    local params = RaycastParams.new(); params.FilterDescendantsInstances = {char}; params.FilterType = Enum.RaycastFilterType.Exclude
    if not workspace:Raycast(rayOrigin, rayDir, params) then
        UI.AddLog("ОБРЫВ! ОСТОРОЖНО!", Color3.fromRGB(255, 50, 50))
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid:MoveTo(root.Position - (root.CFrame.LookVector * 8)) end
        return true
    end
    return false
end

function Navigation.HandleStuck(AI, humanoid, root)
    humanoid.Jump = true; task.wait(0.5)
    humanoid:MoveTo(root.Position - (root.CFrame.LookVector * 5)); task.wait(1)
    humanoid:MoveTo(root.Position + (root.CFrame.RightVector * -5)); task.wait(1)
    humanoid:MoveTo(root.Position + (root.CFrame.RightVector * 5)); task.wait(1)
end

function Navigation.FindAlternativePosition(AI, targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local root = char.HumanoidRootPart
    for i = 1, 20 do
        local angle = math.random() * math.pi * 2
        local distance = math.random(10, 50)
        local offset = Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
        local testPos = targetPos + offset
        local path = PathfindingService:CreatePath(AI.Config.PathfindingSettings)
        local success = pcall(function() path:ComputeAsync(root.Position, testPos) end)
        if success and path.Status == Enum.PathStatus.Success then return testPos end
    end
    return nil
end

function Navigation.FindCrowdCenter(AI)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    for _, p1 in ipairs(Players:GetPlayers()) do
        if p1 ~= LocalPlayer and p1.Character and p1.Character:FindFirstChild("HumanoidRootPart") then
            local groupCount = 0; local centerSum = Vector3.new(0, 0, 0)
            for _, p2 in ipairs(Players:GetPlayers()) do
                if p2.Character and p2.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (p1.Character.HumanoidRootPart.Position - p2.Character.HumanoidRootPart.Position).Magnitude
                    if dist < AI.Config.GroupDetectionRadius then groupCount = groupCount + 1; centerSum = centerSum + p2.Character.HumanoidRootPart.Position end
                end
            end
            if groupCount >= AI.Config.GroupSizeMin then
                local crowdCenter = centerSum / groupCount
                if (char.HumanoidRootPart.Position - crowdCenter).Magnitude < AI.Config.GroupMaxDistance then return crowdCenter end
            end
        end
    end
    return nil
end

function Navigation.Explore(AI, char, humanoid, root)
    local interestingParts = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.CanCollide then
            local dist = (root.Position - obj.Position).Magnitude
            if dist < 80 and dist > 10 then
                if obj.BrickColor.Number > 0 or obj.Size.Magnitude > 10 or obj.Transparency > 0.5 then
                    table.insert(interestingParts, obj)
                end
            end
        end
    end
    if #interestingParts > 0 then
        local target = interestingParts[math.random(1, #interestingParts)]
        Navigation.MoveToLocation(AI, target.Position)
        TweenService:Create(root, TweenInfo.new(0.5), { CFrame = CFrame.lookAt(root.Position, target.Position) }):Play()
        if math.random(1, 2) == 1 then ChatHandler.Speak(AI, "Интересная архитектура...") end
    else
        Navigation.Patrol(AI, char, humanoid, root)
    end
end

function Navigation.Patrol(AI, char, humanoid, root)
    local randomPos = root.Position + Vector3.new(math.random(-AI.Config.WanderRadius, AI.Config.WanderRadius), 0, math.random(-AI.Config.WanderRadius, AI.Config.WanderRadius))
    Navigation.MoveToLocation(AI, randomPos)
end

