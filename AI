    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 65)
    card.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    card.Parent = DexView
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = card
    
    local tLabel = Instance.new("TextLabel")
    tLabel.Size = UDim2.new(1, -110, 0, 22)
    tLabel.Position = UDim2.new(0, 10, 0, 8)
    tLabel.BackgroundTransparency = 1
    tLabel.Font = Enum.Font.GothamBold
    tLabel.Text = title
    tLabel.TextColor3 = Color3.fromRGB(240, 240, 255)
    tLabel.TextSize = 13
    tLabel.TextXAlignment = Enum.TextXAlignment.Left
    tLabel.Parent = card
    
    local dLabel = Instance.new("TextLabel")
    dLabel.Size = UDim2.new(1, -110, 0, 25)
    dLabel.Position = UDim2.new(0, 10, 0, 30)
    dLabel.BackgroundTransparency = 1
    dLabel.Font = Enum.Font.Gotham
    dLabel.Text = desc
    dLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
    dLabel.TextSize = 11
    dLabel.TextXAlignment = Enum.TextXAlignment.Left
    dLabel.TextWrapped = true
    dLabel.Parent = card
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 90, 0, 35)
    btn.Position = UDim2.new(1, -100, 0.5, -17)
    btn.BackgroundColor3 = Color3.fromRGB(70, 45, 140)
    btn.Font = Enum.Font.GothamBold
    btn.Text = "Сканировать"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Parent = card
    
    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 6)
    bCorner.Parent = btn
    
    btn.MouseButton1Click:Connect(callback)
end

createActionCard("Тотальный сканер (100% всё кроме света)", "Сканирует абсолютно все папки и объекты игры, исключая только освещение/атмосферу.", function()
    task.spawn(function()
        addMessage("System", "Запуск тотального сканирования всех папок...")
        
        local txtLines = {}
        table.insert(txtLines, "=== TOTAL EXPLOIT EXPLORER REPORT (PLACE ID: " .. tostring(game.PlaceId) .. ") ===")
        table.insert(txtLines, "Дата: " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n")
        
        local function dumpObject(parentObj, depth)
            local indent = string.rep("  ", math.min(depth, 8))
            local success, children = pcall(function()
                return parentObj:GetChildren()
            end)
            
            if success and children then
                for _, child in ipairs(children) do
                    local className = child.ClassName
                    if className ~= "Lighting" and className ~= "Atmosphere" and className ~= "Sky" and 
                       className ~= "PostEffect" and className ~= "BloomEffect" and className ~= "BlurEffect" and 
                       className ~= "ColorCorrectionEffect" and className ~= "DepthOfFieldEffect" and className ~= "SunRaysEffect" then
                        
                        local line = indent .. "- [" .. className .. "] " .. child.Name
                        
                        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                            line = line .. " [🔥 REMOTE]"
                        elseif child:IsA("LocalScript") or child:IsA("ModuleScript") or child:IsA("Script") then
                            line = line .. " [📜 SCRIPT]"
                        elseif child:IsA("Folder") then
                            line = line .. " [📁 FOLDER]"
                        elseif child:IsA("Model") then
                            line = line .. " [📦 MODEL]"
                        elseif child:IsA("Tool") then
                            line = line .. " [⚔️ TOOL]"
                        elseif child:IsA("ScreenGui") or child:IsA("Frame") or child:IsA("TextButton") then
                            line = line .. " [🖼️ UI]"
                        end
                        
                        table.insert(txtLines, line)
                        
                        if #txtLines > 900 then
                            table.insert(txtLines, "... [ПРЕРВАНО: Достигнут лимит строк отчета] ...")
                            return
                        end
                        
                        dumpObject(child, depth + 1)
                    end
                end
            end
        end
        
        local servicesToScan = {
            {name = "Workspace", obj = game:GetService("Workspace")},
            {name = "ReplicatedStorage", obj = game:GetService("ReplicatedStorage")},
            {name = "ReplicatedFirst", obj = game:GetService("ReplicatedFirst")},
            {name = "ServerStorage", obj = game:GetService("ServerStorage")},
            {name = "ServerScriptService", obj = game:GetService("ServerScriptService")},
            {name = "SoundService", obj = game:GetService("SoundService")},
            {name = "StarterPlayer", obj = game:GetService("StarterPlayer")},
            {name = "StarterGui", obj = game:GetService("StarterGui")},
            {name = "Players", obj = game:GetService("Players")}
        }
        
        for _, sInfo in ipairs(servicesToScan) do
            if sInfo.obj then
                table.insert(txtLines, "\n--- [" .. sInfo.name .. "] ---")
                dumpObject(sInfo.obj, 1)
                if #txtLines > 900 then break end
            end
        end
        
        local fullReport = table.concat(txtLines, "\n")
        local fileName = "AiRobloxHub_" .. tostring(game.PlaceId) .. ".txt"
        
        if writefile then
            pcall(function()
                writefile(fileName, fullReport)
                addMessage("System", "Файл отчета сохранен: " .. fileName)
            end)
        end
        
        switchTab("Chat")
        sendToAI("Вот тотальный отчет структуры этой игры (все папки, ремоуты, скрипты и UI кроме света, сохранен в " .. fileName .. "). Напиши мощный чит на основе этих данных:\n\n" .. fullReport)
    end)
end)

