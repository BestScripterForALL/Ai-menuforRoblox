local function addMessage(sender, text)
    table.insert(chatHistory, {sender = sender, text = text})
    updateTokenCounter()

    local msgFrame = Instance.new("Frame")
    msgFrame.Size = UDim2.new(1, 0, 0, 0)
    msgFrame.AutomaticSize = Enum.AutomaticSize.Y
    msgFrame.BackgroundTransparency = 1
    msgFrame.Parent = ChatScroll
    
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 4)
    layout.Parent = msgFrame

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, -10, 0, 0)
    txt.AutomaticSize = Enum.AutomaticSize.Y
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.Gotham
    txt.Text = sender .. ": " + text -- Безопасное отображение
    txt.TextColor3 = (sender == "AI") and Color3.fromRGB(200, 180, 255) or Color3.fromRGB(230, 230, 240)
    txt.TextSize = 12
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.TextWrapped = true
    txt.Parent = msgFrame
    
    -- Исправление конкатенации в TextLabel
    txt.Text = sender .. ": " .. text

    local codeSnippet = text:match("```lua%s*(.-)%s*```") or text:match("```%s*(.-)%s*```")

    if sender == "AI" and codeSnippet then
        -- Контейнер для кнопок под кодом
        local btnContainer = Instance.new("Frame")
        btnContainer.Size = UDim2.new(1, -10, 0, 28)
        btnContainer.BackgroundTransparency = 1
        btnContainer.Parent = msgFrame
        
        local bLayout = Instance.new("UIListLayout")
        bLayout.FillDirection = Enum.FillDirection.Horizontal
        bLayout.SortOrder = Enum.SortOrder.LayoutOrder
        bLayout.Padding = UDim.new(0, 6)
        bLayout.Parent = btnContainer

        -- Кнопка копирования
        local copyBtn = Instance.new("TextButton")
        copyBtn.Size = UDim2.new(0.48, 0, 1, 0)
        copyBtn.BackgroundColor3 = Color3.fromRGB(70, 45, 140)
        copyBtn.Font = Enum.Font.GothamBold
        copyBtn.Text = "📋 Скопировать"
        copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        copyBtn.TextSize = 10
        copyBtn.Parent = btnContainer

        local cCorner = Instance.new("UICorner")
        cCorner.CornerRadius = UDim.new(0, 6)
        cCorner.Parent = copyBtn

        copyBtn.MouseButton1Click:Connect(function()
            local setclip = setclipboard or toclipboard or set_clipboard
            if setclip then
                setclip(codeSnippet)
                copyBtn.Text = "✅ Скопировано!"
                task.wait(2)
                copyBtn.Text = "📋 Скопировать"
            else
                copyBtn.Text = "❌ Нет setclipboard"
            end
        end)

        -- Кнопка автозапуска (Execute через loadstring + pcall)
        local execBtn = Instance.new("TextButton")
        execBtn.Size = UDim2.new(0.48, 0, 1, 0)
        execBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 70)
        execBtn.Font = Enum.Font.GothamBold
        execBtn.Text = "▶️ Запустить"
        execBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        execBtn.TextSize = 10
        execBtn.Parent = btnContainer

        local eCorner = Instance.new("UICorner")
        eCorner.CornerRadius = UDim.new(0, 6)
        eCorner.Parent = execBtn

        execBtn.MouseButton1Click:Connect(function()
            local fn, syntaxError = loadstring(codeSnippet)
            if not fn then
                execBtn.Text = "❌ Ошибка синтаксиса"
                execBtn.BackgroundColor3 = Color3.fromRGB(140, 40, 40)
                addMessage("System", "Ошибка загрузки кода: " .. tostring(syntaxError))
                task.wait(2)
                execBtn.Text = "▶️ Запустить"
                execBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 70)
                return
            end
            
            local success, runtimeError = pcall(fn)
            if success then
                execBtn.Text = "✅ Успешно запущен!"
                execBtn.BackgroundColor3 = Color3.fromRGB(30, 150, 70)
                task.wait(2)
                execBtn.Text = "▶️ Запустить"
                execBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 70)
            else
                execBtn.Text = "❌ Ошибка выполнения"
                execBtn.BackgroundColor3 = Color3.fromRGB(140, 40, 40)
                addMessage("System", "Ошибка при выполнении кода скрипта: " .. tostring(runtimeError))
                task.wait(2)
                execBtn.Text = "▶️ Запустить"
                execBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 70)
            end
        end)
    end
end

local function sendToAI(promptText)
    if apiKey == "" then
        addMessage("System", "Ошибка: Введи API ключ в настройках!")
        switchTab("Settings")
        return
    end
    
    addMessage("You", promptText)
    
    task.spawn(function()
        local requestFunc = syn and syn.request or http_request or request
        if not requestFunc then
            addMessage("AI", "Ошибка: Экзекутор не поддерживает HTTP запросы!")
            return
        end
        
        local url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=" .. apiKey

        local bodyData = {
            contents = {
                {
                    parts = {
                        { text = systemPrompt },
                        { text = promptText }
                    }
                }
            }
        }
        
        local success, res = pcall(function()
            return requestFunc({
                Url = url,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = HttpService:JSONEncode(bodyData)
            })
        end)
        
        if success and res and res.Body then
            local decodedSuccess, decoded = pcall(function()
                return HttpService:JSONDecode(res.Body)
            end)
            
            if decodedSuccess and decoded and decoded.candidates then
                local answer = decoded.candidates[1].content.parts[1].text
                addMessage("AI", answer)
            elseif decodedSuccess and decoded and decoded.error then
                addMessage("System", "API Error: " .. tostring(decoded.error.message))
            else
                addMessage("AI", "Ошибка ответа ИИ. Проверь ключ.")
            end
        else
            addMessage("System", "Ошибка сети / соединения с Gemini API.")
        end
    end)
end

SendBtn.MouseButton1Click:Connect(function()
    local text = ChatInputBox.Text
    if text ~= "" then
        ChatInputBox.Text = ""
        sendToAI(text)
    end
end)

