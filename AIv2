local MobileControls = {
    Enabled = true,
    TouchSensitivity = 0.5,
    SwipeThreshold = 50,
    TapDelay = 0.3,
    HoldDelay = 0.5,
    DoubleTapDelay = 0.3,
    Gestures = {
        SwipeUp = false,
        SwipeDown = false,
        SwipeLeft = false,
        SwipeRight = false,
        Tap = false,
        DoubleTap = false,
        Hold = false
    },
    TouchPoints = {},
    LastTouch = {X = 0, Y = 0},
    TouchStart = {X = 0, Y = 0},
    TouchTime = 0,
    LastTapTime = 0,
    TapCount = 0,
    IsHolding = false,
    HoldTimer = 0,
    IsDragging = false,
    DragStart = {X = 0, Y = 0},
    DragCurrent = {X = 0, Y = 0},
    DragDelta = {X = 0, Y = 0}
}

function MobileControls:Init()
    -- Initialize touch handling
    UserInputService.TouchEnabled = true
    UserInputService.TouchInputEnabled = true
    
    -- Handle touch input
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.Touch then
            self:HandleTouchBegan(input)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.Touch then
            self:HandleTouchMoved(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.Touch then
            self:HandleTouchEnded(input)
        end
    end)
end

function MobileControls:HandleTouchBegan(input)
    local pos = input.Position
    self.TouchStart = {X = pos.X, Y = pos.Y}
    self.LastTouch = {X = pos.X, Y = pos.Y}
    self.TouchTime = os.clock()
    self.IsHolding = false
    self.HoldTimer = 0
    self.IsDragging = false
    self.TapCount = self.TapCount + 1
    
    -- Check for double tap
    if os.clock() - self.LastTapTime < self.DoubleTapDelay then
        self.Gestures.DoubleTap = true
        self:FireGesture("doubletap", pos.X, pos.Y)
        self.TapCount = 0
    else
        self.Gestures.Tap = true
    end
    self.LastTapTime = os.clock()
    
    -- Start hold timer
    spawn(function()
        while self.IsHolding == false and os.clock() - self.TouchTime < self.HoldDelay do
            wait(0.1)
            self.HoldTimer = os.clock() - self.TouchTime
        end
        if self.HoldTimer >= self.HoldDelay then
            self.IsHolding = true
            self.Gestures.Hold = true
            self:FireGesture("hold", pos.X, pos.Y)
        end
    end)
end

function MobileControls:HandleTouchMoved(input)
    local pos = input.Position
    self.DragCurrent = {X = pos.X, Y = pos.Y}
    self.DragDelta = {
        X = pos.X - self.TouchStart.X,
        Y = pos.Y - self.TouchStart.Y
    }
    
    if not self.IsDragging then
        local distance = math.sqrt(self.DragDelta.X^2 + self.DragDelta.Y^2)
        if distance > self.SwipeThreshold then
            self.IsDragging = true
            self.Gestures.Tap = false
            self.Gestures.DoubleTap = false
        end
    end
    
    if self.IsDragging then
        -- Detect swipe direction
        if math.abs(self.DragDelta.X) > math.abs(self.DragDelta.Y) then
            if self.DragDelta.X > 0 then
                self.Gestures.SwipeRight = true
                self:FireGesture("swiperight", pos.X, pos.Y)
            else
                self.Gestures.SwipeLeft = true
                self:FireGesture("swipeleft", pos.X, pos.Y)
            end
        else
            if self.DragDelta.Y > 0 then
                self.Gestures.SwipeDown = true
                self:FireGesture("swipedown", pos.X, pos.Y)
            else
                self.Gestures.SwipeUp = true
                self:FireGesture("swipeup", pos.X, pos.Y)
            end
        end
    end
    
    self.LastTouch = {X = pos.X, Y = pos.Y}
end

function MobileControls:HandleTouchEnded(input)
    local pos = input.Position
    
    -- If it was a tap (not drag)
    if not self.IsDragging and not self.IsHolding then
        self:FireGesture("tap", pos.X, pos.Y)
    end
    
    -- Reset gestures
    self.Gestures.SwipeUp = false
    self.Gestures.SwipeDown = false
    self.Gestures.SwipeLeft = false
    self.Gestures.SwipeRight = false
    self.Gestures.Tap = false
    self.Gestures.DoubleTap = false
    self.Gestures.Hold = false
    self.IsHolding = false
    self.IsDragging = false
    self.TapCount = 0
end

function MobileControls:FireGesture(gesture, x, y)
    -- Fire gesture event for other systems
    local event = Instance.new("BindableEvent")
    event.Name = "GestureEvent"
    event:Fire(gesture, x, y)
    event:Destroy()
    
    -- Check for menu toggle gesture (double tap on edge)
    if gesture == "doubletap" then
        if x < 50 or x > game:GetService("GuiService"):GetScreenResolution().X - 50 then
            if AdvancedMenu then
                AdvancedMenu:Toggle()
            end
        end
    end
end

