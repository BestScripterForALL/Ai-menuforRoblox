function MainEngine:Start()
    if self.Status == "running" then
        print("[AI] Engine already running")
        return
    end
    
    print("[AI] Starting engine...")
    self.Status = "running"
    self.StartTime = os.time()
    
    -- Start update loop
    self:StartUpdateLoop()
    
    -- Start services
    self:StartServices()
    
    print("[AI] Engine started!")
    if self.Menu then
        self.Menu:ShowNotification("Engine started!", 2, "success")
    end
end

function MainEngine:Stop()
    if self.Status == "stopped" then
        print("[AI] Engine already stopped")
        return
    end
    
    print("[AI] Stopping engine...")
    self.Status = "stopped"
    
    -- Stop threads
    for _, thread in pairs(self.Threads) do
        thread.Running = false
    end
    
    -- Stop services
    for _, service in pairs(self.Services) do
        service.Running = false
    end
    
    print("[AI] Engine stopped!")
    if self.Menu then
        self.Menu:ShowNotification("Engine stopped!", 2, "warning")
    end
end

function MainEngine:StartUpdateLoop()
    spawn(function()
        while self.Status == "running" do
            local startTime = os.clock()
            
            -- Update subsystems
            pcall(function()
                -- Update AimBot
                if AdvancedAimBot.Enabled then
                    AdvancedAimBot:Update()
                end
                
                -- Update ESP
                if AdvancedESP.Enabled then
                    AdvancedESP:Update()
                end
                
                -- Update Movement
                if AdvancedMovement.BHop.Enabled then
                    AdvancedMovement:BHop_Update()
                end
                
                if AdvancedMovement.SpeedHack.Enabled then
                    AdvancedMovement:SpeedHack_Update()
                end
                
                if AdvancedMovement.FlyHack.Enabled then
                    AdvancedMovement:FlyHack_Update()
                end
                
                if AdvancedMovement.Teleportation.Enabled then
                    AdvancedMovement:Teleportation_Update()
                end
                
                if AdvancedMovement.AntiCheat.Enabled then
                    AdvancedMovement:AntiCheat_Update()
                end
                
                -- Update Anti-Detection
                if AntiDetection.Enabled then
                    AntiDetection:Update()
                end
                
                -- Update Menu
                if self.Menu then
                    self.Menu:Update()
                end
            end)
            
            -- Update performance metrics
            local endTime = os.clock()
            self.Performance.FrameTime = (endTime - startTime) * 1000
            self.Performance.FPS = 1 / (endTime - startTime + 0.001)
            self.Performance.MemoryUsage = collectgarbage("count")
            
            -- Update uptime
            self.Uptime = os.time() - self.StartTime
            
            wait(self.UpdateInterval)
        end
    end)
end

function MainEngine:StartServices()
    -- Remote logging service
    local remoteService = {
        Running = true,
        Name = "RemoteService"
    }
    spawn(function()
        while remoteService.Running and self.Status == "running" do
            wait(5)
            -- Log remote statistics
            if RemoteSystem.RemoteLogging then
                local totalCalls = 0
                for _, calls in pairs(RemoteSystem.RemoteCalls) do
                    totalCalls = totalCalls + calls
                end
                -- print("[AI] Remote calls:", totalCalls)
            end
        end
    end)
    table.insert(self.Services, remoteService)
    
    -- Performance monitoring service
    local perfService = {
        Running = true,
        Name = "PerformanceService"
    }
    spawn(function()
        while perfService.Running and self.Status == "running" do
            wait(10)
            if self.Debug.Enabled then
                print(string.format("[AI] FPS: %.1f, Memory: %.1f MB, Frame Time: %.2fms",
                    self.Performance.FPS,
                    self.Performance.MemoryUsage / 1024,
                    self.Performance.FrameTime
                ))
            end
        end
    end)
    table.insert(self.Services, perfService)
    
    -- Anti-detection service
    local antiService = {
        Running = true,
        Name = "AntiDetectionService"
    }
    spawn(function()
        while antiService.Running and self.Status == "running" do
            wait(15)
            if AntiDetection.Enabled then
                local detections, risk = AntiDetection:Detect()
                if #detections > 0 then
                    print("[AI] Detections:", #detections, "Risk:", risk)
                    if risk > 50 then
                        AntiDetection:Bypass()
                    end
                end
            end
        end
    end)
    table.insert(self.Services, antiService)
end

