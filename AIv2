        while self.Status == "running" do
            pcall(function()
                -- Update AimBot
                if MobileAimBot.Enabled then
                    MobileAimBot:Update()
                end
                
                -- Update ESP
                if MobileESP.Enabled then
                    MobileESP:Update()
                end
                
                -- Update Movement
                if MobileMovement.BHop.Enabled then
                    MobileMovement:BHop_Update()
                end
                if MobileMovement.SpeedHack.Enabled then
                    MobileMovement:SpeedHack_Update()
                end
                if MobileMovement.FlyHack.Enabled then
                    MobileMovement:FlyHack_Update()
                end
                if MobileMovement.Teleportation.Enabled then
                    MobileMovement:Teleportation_Update()
                end
            end)
            
            self.Uptime = os.time() - self.StartTime
            wait(self.UpdateInterval)
        end
    end)
end

