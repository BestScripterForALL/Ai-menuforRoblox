function AdvancedMenu:ShowNotification(message, duration, type)
    if not self.Notifications.Enabled then return end
    
    duration = duration or self.Notifications.Duration
    type = type or "info"
    
    local colors = {
        info = Color3.fromRGB(60, 150, 255),
        success = Color3.fromRGB(0, 200, 100),
        warning = Color3.fromRGB(255, 200, 0),
        error = Color3.fromRGB(255, 0, 0)
    }
    
    local notification = Instance.new("Frame")
    notification.Size = UDim2.new(0, 300, 0, 50)
    notification.Position = UDim2.new(1, -320, 1, -60)
    notification.BackgroundColor3 = self.Themes[self.Theme].Foreground
    notification.BorderSizePixel = 1
    notification.BorderColor3 = colors[type] or colors.info
    notification.Parent = game:GetService("CoreGui")
    
    local icon = Instance.new("Frame")
    icon.Size = UDim2.new(0, 4, 1, 0)
    icon.BackgroundColor3 = colors[type] or colors.info
    icon.BorderSizePixel = 0
    icon.Parent = notification
    
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, -10, 1, 0)
    text.Position = UDim2.new(0, 10, 0, 0)
    text.BackgroundTransparency = 1
    text.Text = message
    text.TextColor3 = self.Themes[self.Theme].Text
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.TextYAlignment = Enum.TextYAlignment.Center
    text.Font = Enum.Font.Gotham
    text.TextSize = 13
    text.TextWrapped = true
    text.Parent = notification
    
    -- Animation
    notification.Position = UDim2.new(1, -320, 1, -60)
    local targetY = -60 - (#self.Notifications.Active * 60)
    notification.Position = UDim2.new(1, -320, 1, targetY)
    
    table.insert(self.Notifications.Active, notification)
    
    -- Auto remove
    game:GetService("Debris"):AddItem(notification, duration)
    wait(duration)
    
    -- Remove from active list
    for i, n in pairs(self.Notifications.Active) do
        if n == notification then
            table.remove(self.Notifications.Active, i)
            break
        end
    end
end

function AdvancedMenu:Update()
    -- Update animations
    if self.Animations.Enabled then
        for _, window in pairs(self.Windows) do
            if window.Animation.Active then
                window.Animation.CurrentPosition = window.Animation.CurrentPosition:Lerp(
                    window.Animation.TargetPosition,
                    self.Animations.Speed
                )
                window.Animation.CurrentSize = window.Animation.CurrentSize:Lerp(
                    window.Animation.TargetSize,
                    self.Animations.Speed
                )
                
                window.Frame.Position = UDim2.new(0, window.Animation.CurrentPosition.X, 0, window.Animation.CurrentPosition.Y)
                window.Frame.Size = UDim2.new(0, window.Animation.CurrentSize.X, 0, window.Animation.CurrentSize.Y)
                
                if (window.Animation.CurrentPosition - window.Animation.TargetPosition).Magnitude < 1 then
                    window.Animation.Active = false
                end
            end
        end
    end
    
    -- Update hotkeys
    if self.Hotkeys.Enabled then
        for key, action in pairs(self.Hotkeys.Keys) do
            if UserInputService:IsKeyDown(Enum.KeyCode[key]) then
                if action then action() end
            end
        end
    end
end

function AdvancedMenu:Toggle()
    self.Open = not self.Open
    for _, window in pairs(self.Windows) do
        window.Visible = self.Open
        window.Frame.Visible = self.Open
    end
end

