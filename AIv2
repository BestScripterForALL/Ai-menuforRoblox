local NeuralNetwork = {
    Layers = {},
    Connections = {},
    Neurons = {},
    LearningRate = 0.01,
    Momentum = 0.9,
    ActivationFunction = "relu",
    TrainingEpochs = 0,
    Accuracy = 0,
    Loss = 0,
    Structure = {},
    Weights = {},
    Biases = {},
    Gradients = {},
    Optimizer = "adam",
    BatchSize = 32,
    DropoutRate = 0.2,
    Regularization = 0.001
}

function NeuralNetwork:CreateLayer(size, activation)
    activation = activation or "relu"
    local layer = {
        Size = size,
        Activation = activation,
        Neurons = {},
        Weights = {},
        Biases = {},
        Output = {},
        Input = {}
    }
    for i = 1, size do
        layer.Neurons[i] = {
            Value = 0,
            Gradient = 0,
            Bias = math.random() * 0.1,
            WeightedSum = 0
        }
    end
    table.insert(self.Layers, layer)
    return layer
end

function NeuralNetwork:ConnectLayers(layer1, layer2)
    local connection = {
        From = layer1,
        To = layer2,
        Weights = {}
    }
    for i = 1, layer1.Size do
        connection.Weights[i] = {}
        for j = 1, layer2.Size do
            connection.Weights[i][j] = math.random() * 0.1 - 0.05
        end
    end
    table.insert(self.Connections, connection)
    return connection
end

function NeuralNetwork:Initialize(inputSize, hiddenSizes, outputSize)
    local inputLayer = self:CreateLayer(inputSize, "linear")
    local hiddenLayers = {}
    for _, size in pairs(hiddenSizes) do
        table.insert(hiddenLayers, self:CreateLayer(size, "relu"))
    end
    local outputLayer = self:CreateLayer(outputSize, "sigmoid")
    
    -- Connect input to first hidden
    self:ConnectLayers(inputLayer, hiddenLayers[1])
    
    -- Connect hidden layers
    for i = 1, #hiddenLayers - 1 do
        self:ConnectLayers(hiddenLayers[i], hiddenLayers[i + 1])
    end
    
    -- Connect last hidden to output
    self:ConnectLayers(hiddenLayers[#hiddenLayers], outputLayer)
    
    self.Structure = {
        InputLayer = inputLayer,
        HiddenLayers = hiddenLayers,
        OutputLayer = outputLayer
    }
end

function NeuralNetwork:Forward(input)
    local inputLayer = self.Structure.InputLayer
    for i = 1, inputLayer.Size do
        inputLayer.Neurons[i].Value = input[i] or 0
    end
    
    for _, connection in pairs(self.Connections) do
        local from = connection.From
        local to = connection.To
        for j = 1, to.Size do
            local sum = 0
            for i = 1, from.Size do
                sum = sum + from.Neurons[i].Value * connection.Weights[i][j]
            end
            to.Neurons[j].WeightedSum = sum + to.Neurons[j].Bias
            to.Neurons[j].Value = self:Activate(to.Neurons[j].WeightedSum, to.Activation)
        end
    end
    
    local output = {}
    local outputLayer = self.Structure.OutputLayer
    for i = 1, outputLayer.Size do
        output[i] = outputLayer.Neurons[i].Value
    end
    return output
end

function NeuralNetwork:Activate(value, activation)
    if activation == "relu" then
        return math.max(0, value)
    elseif activation == "sigmoid" then
        return 1 / (1 + math.exp(-value))
    elseif activation == "tanh" then
        return math.tanh(value)
    elseif activation == "linear" then
        return value
    elseif activation == "leaky_relu" then
        return value > 0 and value or value * 0.01
    elseif activation == "elu" then
        return value > 0 and value or 0.5 * (math.exp(value) - 1)
    end
    return value
end

function NeuralNetwork:Train(inputs, targets, epochs)
    epochs = epochs or 100
    local batchSize = self.BatchSize
    local learningRate = self.LearningRate
    
    for epoch = 1, epochs do
        local totalLoss = 0
        local correct = 0
        
        for i = 1, #inputs do
            local output = self:Forward(inputs[i])
            local target = targets[i]
            
            -- Calculate loss (MSE)
            local loss = 0
            for j = 1, #output do
                loss = loss + (output[j] - target[j])^2
            end
            loss = loss / #output
            totalLoss = totalLoss + loss
            
            -- Backpropagation
            self:Backpropagate(target)
            
            -- Update weights
            self:UpdateWeights(learningRate)
        end
        
        self.TrainingEpochs = self.TrainingEpochs + 1
        self.Loss = totalLoss / #inputs
        
        if epoch % 10 == 0 then
            print("[AI] Training Epoch:", epoch, "Loss:", self.Loss)
        end
    end
end

function NeuralNetwork:Backpropagate(target)
    local outputLayer = self.Structure.OutputLayer
    
    -- Output layer gradients
    for i = 1, outputLayer.Size do
        local neuron = outputLayer.Neurons[i]
        local error = neuron.Value - target[i]
        neuron.Gradient = error * self:ActivateDerivative(neuron.WeightedSum, outputLayer.Activation)
    end
    
    -- Hidden layers gradients (backward)
    for layerIdx = #self.Layers - 1, 2, -1 do
        local layer = self.Layers[layerIdx]
        local nextLayer = self.Layers[layerIdx + 1]
        
        -- Find connection between layers
        local connection = nil
        for _, conn in pairs(self.Connections) do
            if conn.From == layer and conn.To == nextLayer then
                connection = conn
                break
            end
        end
        
        if connection then
            for i = 1, layer.Size do
                local sum = 0
                for j = 1, nextLayer.Size do
                    sum = sum + connection.Weights[i][j] * nextLayer.Neurons[j].Gradient
                end
                layer.Neurons[i].Gradient = sum * self:ActivateDerivative(layer.Neurons[i].WeightedSum, layer.Activation)
            end
        end
    end
end

function NeuralNetwork:ActivateDerivative(value, activation)
    if activation == "sigmoid" then
        local sig = 1 / (1 + math.exp(-value))
        return sig * (1 - sig)
    elseif activation == "tanh" then
        local tan = math.tanh(value)
        return 1 - tan * tan
    elseif activation == "relu" or activation == "leaky_relu" then
        return value > 0 and 1 or 0.01
    elseif activation == "linear" then
        return 1
    elseif activation == "elu" then
        return value > 0 and 1 or 0.5 * math.exp(value)
    end
    return 1
end

function NeuralNetwork:UpdateWeights(learningRate)
    for _, connection in pairs(self.Connections) do
        local from = connection.From
        local to = connection.To
        
        for i = 1, from.Size do
            for j = 1, to.Size do
                local gradient = from.Neurons[i].Value * to.Neurons[j].Gradient
                connection.Weights[i][j] = connection.Weights[i][j] - learningRate * gradient
                
                -- Regularization
                connection.Weights[i][j] = connection.Weights[i][j] * (1 - self.Regularization)
            end
        end
        
        -- Update biases
        for j = 1, to.Size do
            to.Neurons[j].Bias = to.Neurons[j].Bias - learningRate * to.Neurons[j].Gradient
        end
    end
end

function NeuralNetwork:Predict(input)
    local output = self:Forward(input)
    local maxIdx = 1
    local maxVal = output[1]
    for i = 2, #output do
        if output[i] > maxVal then
            maxVal = output[i]
            maxIdx = i
        end
    end
    return maxIdx, maxVal, output
end

