    btn.Position = UDim2.new(0.6, 0, 0, 0)
    btn.BackgroundColor3 = self.Themes[self.Theme].Foreground
    btn.Text = key
    btn.TextColor3 = self.Themes[self.Theme].Text
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.Parent = keybind
    
    local waiting = false
    btn.TouchTap:Connect(function()
        waiting = true
        btn.Text = "Touch screen..."
        btn.BackgroundColor3 = self.Themes[self.Theme].Accent
    end)
    
    btn.MouseButton1Click:Connect(function()
        waiting = true
        btn.Text = "Touch screen..."
        btn.BackgroundColor3 = self.Themes[self.Theme].Accent
    end)
    
    UserInputService.InputBegan:Connect(function(input)
        if waiting then
            if input.UserInputType == Enum.UserInputType.Touch then
                waiting = false
                key = "Touch"
                btn.Text = "Touch"
                btn.BackgroundColor3 = self.Themes[self.Theme].Foreground
                if callback then callback("Touch") end
            elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                waiting = false
                key = input.KeyCode.Name
                btn.Text = key
                btn.BackgroundColor3 = self.Themes[self.Theme].Foreground
                if callback then callback(key) end
            end
        end
    end)
    
    table.insert(tab.Elements, keybind)
    return keybind, function() return key end
