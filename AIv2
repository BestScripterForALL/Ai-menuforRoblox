    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = toggle
    
    btn.TouchTap:Connect(function()
        state = not state
        check.BackgroundColor3 = state and self.Themes[self.Theme].Accent or self.Themes[self.Theme].Border
        indicator.Visible = state
        if callback then callback(state) end
    end)
    
    btn.MouseButton1Click:Connect(function()
        state = not state
        check.BackgroundColor3 = state and self.Themes[self.Theme].Accent or self.Themes[self.Theme].Border
        indicator.Visible = state
        if callback then callback(state) end
    end)
    
    table.insert(tab.Elements, toggle)
    return toggle, function() return state end
end

function MobileMenu:AddSlider(tab, text, min, max, default, callback, format)
    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(1, -20, 0, 60)
    slider.Position = UDim2.new(0, 10, 0, #tab.Elements * 55 + 10)
    slider.BackgroundTransparency = 1
    slider.Parent = tab.Frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 0, 25)
    label.BackgroundTransparency = 1
    label.Text = text .. ": " .. tostring(default)
    label.TextColor3 = self.Themes[self.Theme].Text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.TextSize = 16
    label.Parent = slider
    
    local value = math.clamp(default or 50, min, max)
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0.9, 0, 0, 8)
    bar.Position = UDim2.new(0, 0, 0.7, 0)
    bar.BackgroundColor3 = self.Themes[self.Theme].Border
    bar.Parent = slider
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = self.Themes[self.Theme].Accent
    fill.BorderSizePixel = 0
    fill.Parent = bar
    
    local drag = Instance.new("TextButton")
    drag.Size = UDim2.new(0, 30, 0, 30)
    drag.Position = UDim2.new((value - min) / (max - min), -15, -0.5, -15)
    drag.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    drag.BorderSizePixel = 0
    drag.Text = ""
    drag.Parent = bar
    
    local dragging = false
    drag.TouchBegan:Connect(function()
        dragging = true
    end)
    drag.TouchEnded:Connect(function()
        dragging = false
    end)
    
    drag.MouseButton1Down:Connect(function()
        dragging = true
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    RunService.RenderStepped:Connect(function()
        if not dragging then return end
        local pos = UserInputService:GetMouseLocation().X
        if pos == 0 then
            -- Touch input
            local touch = UserInputService:GetCurrentInputType()
            if touch == Enum.UserInputType.Touch then
                -- Get touch position
                local touches = UserInputService:GetTouchPositions()
                if #touches > 0 then
                    pos = touches[1].X
                end
            end
        end
        local rel = (pos - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
        value = math.clamp(math.floor(rel * (max - min) + min), min, max)
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        drag.Position = UDim2.new((value - min) / (max - min), -15, -0.5, -15)
        label.Text = text .. ": " .. (format and format(value) or tostring(value))
        if callback then callback(value) end
    end)
    
    table.insert(tab.Elements, slider)
    return slider, function() return value end
end

