function GameAnalyzer:AnalyzeObject(instance, properties, depth)
    local id = instance:GetFullName()
    if self.ScannedObjects[id] then return end
    
    self.ScannedObjects[id] = {
        Instance = instance,
        ClassName = instance.ClassName,
        Depth = depth,
        Properties = properties,
        Children = #instance:GetChildren(),
        Parent = instance.Parent and instance.Parent:GetFullName() or nil,
        IsService = instance:IsA("Service") or false,
        IsRemote = instance:IsA("RemoteEvent") or instance:IsA("RemoteFunction"),
        IsPart = instance:IsA("BasePart") or false,
        IsModel = instance:IsA("Model") or false
    }
    
    -- Analyze remotes
    if self.ScannedObjects[id].IsRemote then
        self:AnalyzeRemote(instance)
    end
    
    -- Analyze parts
    if self.ScannedObjects[id].IsPart then
        self:AnalyzePart(instance)
    end
end

function GameAnalyzer:AnalyzeRemote(remote)
    local info = {
        Type = remote.ClassName,
        Name = remote.Name,
        Parent = remote.Parent and remote.Parent:GetFullName() or nil,
        IsServer = false,
        IsClient = false
    }
    
    if remote:IsA("RemoteEvent") then
        info.IsServer = true
        info.IsClient = true
    elseif remote:IsA("RemoteFunction") then
        info.IsServer = true
        info.IsClient = true
    end
    
    table.insert(self.RemoteCalls, info)
end

function GameAnalyzer:AnalyzePart(part)
    local info = {
        Name = part.Name,
        ClassName = part.ClassName,
        Position = part.Position,
        Size = part.Size,
        Color = part.Color,
        Material = part.Material,
        Transparency = part.Transparency,
        Anchored = part.Anchored,
        CanCollide = part.CanCollide
    }
    table.insert(self.MemoryRegions, info)
