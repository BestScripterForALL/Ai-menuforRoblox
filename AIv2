    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.TextSize = 16
    label.Parent = toggle
    
    local state = default or false
    local check = Instance.new("Frame")
    check.Size = UDim2.new(0, 40, 0, 40)
    check.Position = UDim2.new(1, -45, 0.5, -20)
    check.BackgroundColor3 = state and self.Themes[self.Theme].Accent or self.Themes[self.Theme].Border
