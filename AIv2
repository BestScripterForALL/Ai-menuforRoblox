function MobileESP:CreateBox(player, screenPos, size)
    local drawing = Drawing.new("Square")
    drawing.Size = Vector2.new(size.X, size.Y)
    drawing.Position = screenPos - Vector2.new(size.X/2, size.Y)
    drawing.Color = self.BoxColor
    drawing.Thickness = 2
    drawing.Visible = true
    drawing.Filled = false
    table.insert(self.DrawingObjects, drawing)
    return drawing
end

function MobileESP:CreateHealthBar(player, screenPos, size, healthPercent)
    local background = Drawing.new("Square")
    background.Size = Vector2.new(6, size.Y)
    background.Position = screenPos - Vector2.new(10, size.Y)
    background.Color = Color3.fromRGB(50, 50, 50)
    background.Thickness = 1
    background.Filled = true
    background.Visible = true
    table.insert(self.DrawingObjects, background)
    
    local health = Drawing.new("Square")
    health.Size = Vector2.new(4, size.Y * (healthPercent / 100))
    health.Position = screenPos - Vector2.new(9, size.Y * (healthPercent / 100))
    health.Color = self:GetHealthColor(healthPercent)
    health.Thickness = 0
    health.Filled = true
    health.Visible = true
    table.insert(self.DrawingObjects, health)
    
    return background, health
end

function MobileESP:GetHealthColor(percent)
    if percent > 75 then
        return Color3.fromRGB(0, 255, 0)
    elseif percent > 50 then
        return Color3.fromRGB(255, 255, 0)
    elseif percent > 25 then
        return Color3.fromRGB(255, 165, 0)
    else
        return Color3.fromRGB(255, 0, 0)
    end
end

function MobileESP:CreateTracer(player, screenPos)
    local localPlayer = Players.LocalPlayer
    if not localPlayer or not localPlayer.Character then return nil end
    
    local rootPart = localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local origin = rootPart.Position
    local startPos, onScreenStart = Camera:WorldToViewportPoint(origin)
    if not onScreenStart then return nil end
    
    local line = Drawing.new("Line")
    line.From = Vector2.new(startPos.X, startPos.Y)
    line.To = Vector2.new(screenPos.X, screenPos.Y)
    line.Color = Color3.fromRGB(0, 255, 255)
    line.Thickness = 1
    line.Visible = true
    table.insert(self.DrawingObjects, line)
    return line
end

function MobileESP:CreateGlow(player)
    local character = player.Character
    if not character then return end
    
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            local glow = Instance.new("Part")
            glow.Size = part.Size + Vector3.new(0.2, 0.2, 0.2)
            glow.Position = part.Position
            glow.Color = Color3.fromRGB(255, 0, 0)
            glow.Material = Enum.Material.Neon
            glow.Transparency = 0.5
            glow.Anchored = true
            glow.CanCollide = false
            glow.Parent = game:GetService("Workspace")
            
            local attachment = Instance.new("Weld")
            attachment.Part0 = part
            attachment.Part1 = glow
            attachment.C0 = part.CFrame:Inverse() * glow.CFrame
            attachment.Parent = glow
            
            table.insert(self.GlowObjects, glow)
        end
    end
end

function MobileESP:ClearDrawing()
    for _, obj in pairs(self.DrawingObjects) do
        obj.Visible = false
        obj:Remove()
    end
    table_clear(self.DrawingObjects)
    
    for _, obj in pairs(self.GlowObjects) do
        obj:Destroy()
    end
    table_clear(self.GlowObjects)
end

function MobileESP:Update()
    if not self.Enabled then 
        self:ClearDrawing()
        return 
    end
    
    self:ClearDrawing()
    
    local localPlayer = Players.LocalPlayer
    if not localPlayer then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local character = player.Character
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                    local distance = (rootPart.Position - Camera.CFrame.p).Magnitude
                    
                    if onScreen and distance <= self.MaxDistance then
                        local size = Vector2.new(2, 4) * (100 / distance) * 10
                        
                        if self.BoxESP then
                            self:CreateBox(player, Vector2.new(screenPos.X, screenPos.Y), size)
                        end
                        
                        if self.NameESP then
                            local nameLabel = Drawing.new("Text")
                            nameLabel.Position = Vector2.new(screenPos.X - 30, screenPos.Y - 80)
                            nameLabel.Text = player.Name
                            nameLabel.Color = self.NameColor
                            nameLabel.Size = 14
                            nameLabel.Center = true
                            nameLabel.Visible = true
                            table.insert(self.DrawingObjects, nameLabel)
                        end
                        
                        if self.HealthBar then
                            local healthPercent = humanoid.Health / humanoid.MaxHealth * 100
                            self:CreateHealthBar(player, Vector2.new(screenPos.X, screenPos.Y), size, healthPercent)
                        end
                        
                        if self.DistanceESP then
                            local distLabel = Drawing.new("Text")
                            distLabel.Position = Vector2.new(screenPos.X - 20, screenPos.Y + 20)
                            distLabel.Text = math.floor(distance) .. "m"
                            distLabel.Color = Color3.fromRGB(200, 200, 200)
                            distLabel.Size = 12
                            distLabel.Center = true
                            distLabel.Visible = true
                            table.insert(self.DrawingObjects, distLabel)
                        end
                        
                        if self.TracerESP then
                            self:CreateTracer(player, Vector2.new(screenPos.X, screenPos.Y))
                        end
                        
                        if self.GlowESP then
                            self:CreateGlow(player)
                        end
                    end
                end
            end
        end
    end
end

