function RemoteSystem:ScanRemotes()
    local remotes = {}
    
    for _, obj in pairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local remoteInfo = {
                Object = obj,
                ClassName = obj.ClassName,
                Name = obj.Name,
                Parent = obj.Parent and obj.Parent:GetFullName() or nil,
                Path = obj:GetFullName(),
                IsServer = true,
                IsClient = true,
                Arguments = {},
                ReturnType = "any",
                Hooks = {},
                Calls = 0,
                LastCall = 0
            }
            
            if obj:IsA("RemoteEvent") then
                remoteInfo.OnServerEvent = obj.OnServerEvent
                remoteInfo.OnClientEvent = obj.OnClientEvent
                remoteInfo.FireServer = obj.FireServer
                remoteInfo.FireClient = obj.FireClient
                remoteInfo.FireAllClients = obj.FireAllClients
            elseif obj:IsA("RemoteFunction") then
                remoteInfo.OnServerInvoke = obj.OnServerInvoke
                remoteInfo.OnClientInvoke = obj.OnClientInvoke
                remoteInfo.InvokeServer = obj.InvokeServer
                remoteInfo.InvokeClient = obj.InvokeClient
            end
            
            table.insert(remotes, remoteInfo)
            self.Remotes[obj] = remoteInfo
            
            if obj:IsA("RemoteEvent") then
                self.RemoteEvents[obj] = remoteInfo
            else
                self.RemoteFunctions[obj] = remoteInfo
            end
        end
    end
    
    return remotes
end

function RemoteSystem:HookRemote(remote)
    if self.HookedRemotes[remote] then return end
    
    local remoteInfo = self.Remotes[remote]
    if not remoteInfo then return end
    
    local hookInfo = {
        Remote = remote,
        Hooks = {},
        Original = {},
        Active = true
    }
    
    if remote:IsA("RemoteEvent") then
        -- Hook FireServer
        hookInfo.Original.FireServer = remote.FireServer
        remote.FireServer = function(self, ...)
            if hookInfo.Active then
                local args = {...}
                self.RemoteCalls[remote] = (self.RemoteCalls[remote] or 0) + 1
                remoteInfo.LastCall = os.time()
                remoteInfo.Calls = remoteInfo.Calls + 1
                
                if self.RemoteLogging then
                    print("[AI] Remote Event Fired:", remote.Name, "Args:", unpack(args))
                end
                
                -- Execute hooks
                for _, hook in pairs(hookInfo.Hooks) do
                    hook(args)
                end
                
                -- Block remote
                if self.RemoteBlocking and self.BlockedRemotes[remote] then
                    return
                end
            end
            
            return hookInfo.Original.FireServer(self, ...)
        end
        
        -- Hook FireClient
        hookInfo.Original.FireClient = remote.FireClient
        remote.FireClient = function(self, player, ...)
            if hookInfo.Active and self.RemoteLogging then
                print("[AI] Remote Event Sent to Client:", remote.Name, "Target:", player.Name)
            end
            return hookInfo.Original.FireClient(self, player, ...)
        end
        
        -- Hook FireAllClients
        hookInfo.Original.FireAllClients = remote.FireAllClients
        remote.FireAllClients = function(self, ...)
            if hookInfo.Active and self.RemoteLogging then
                print("[AI] Remote Event Sent to All Clients:", remote.Name)
            end
            return hookInfo.Original.FireAllClients(self, ...)
        end
        
    elseif remote:IsA("RemoteFunction") then
        -- Hook InvokeServer
        hookInfo.Original.InvokeServer = remote.InvokeServer
        remote.InvokeServer = function(self, ...)
            if hookInfo.Active then
                local args = {...}
                self.RemoteCalls[remote] = (self.RemoteCalls[remote] or 0) + 1
                remoteInfo.LastCall = os.time()
                remoteInfo.Calls = remoteInfo.Calls + 1
                
                if self.RemoteLogging then
                    print("[AI] Remote Function Invoked:", remote.Name, "Args:", unpack(args))
                end
                
                -- Execute hooks
                for _, hook in pairs(hookInfo.Hooks) do
                    hook(args)
                end
                
                -- Block remote
                if self.RemoteBlocking and self.BlockedRemotes[remote] then
                    return
                end
            end
            
            return hookInfo.Original.InvokeServer(self, ...)
        end
        
        -- Hook InvokeClient
        hookInfo.Original.InvokeClient = remote.InvokeClient
        remote.InvokeClient = function(self, player, ...)
            if hookInfo.Active and self.RemoteLogging then
                print("[AI] Remote Function Invoked on Client:", remote.Name, "Target:", player.Name)
            end
            return hookInfo.Original.InvokeClient(self, player, ...)
        end
    end
    
    self.HookedRemotes[remote] = hookInfo
    return hookInfo
end

function RemoteSystem:AddHook(remote, hookFunction)
    local hookInfo = self.HookedRemotes[remote]
    if not hookInfo then
        hookInfo = self:HookRemote(remote)
    end
    
    table.insert(hookInfo.Hooks, hookFunction)
    return hookFunction
end

function RemoteSystem:RemoveHook(remote, hookFunction)
    local hookInfo = self.HookedRemotes[remote]
    if not hookInfo then return end
    
    for i, hook in pairs(hookInfo.Hooks) do
        if hook == hookFunction then
            table.remove(hookInfo.Hooks, i)
            return true
        end
    end
    return false
end

function RemoteSystem:BlockRemote(remote)
    self.BlockedRemotes[remote] = true
    self.RemoteBlocking = true
end

function RemoteSystem:UnblockRemote(remote)
    self.BlockedRemotes[remote] = nil
end

function RemoteSystem:SpoofRemote(remote, args)
    if not self.RemoteSpoofing then return end
    
    local remoteInfo = self.Remotes[remote]
    if not remoteInfo then return end
    
    if remote:IsA("RemoteEvent") then
        remote:FireServer(unpack(args))
    elseif remote:IsA("RemoteFunction") then
        return remote:InvokeServer(unpack(args))
    end
end

function RemoteSystem:InjectRemote(remote, pattern, replacement)
    self.InjectionPatterns[remote] = {
        Pattern = pattern,
        Replacement = replacement,
        Active = true
    }
    
    self.RemoteInjection = true
end

function RemoteSystem:SimulateNetwork()
    if not self.LatencySimulation and not self.PacketLossSimulation and not self.PacketOrderSimulation then
        return
    end
    
    -- Simulate latency
    if self.LatencySimulation and self.LatencyAmount > 0 then
        wait(self.LatencyAmount / 1000)
    end
    
    -- Simulate packet loss
    if self.PacketLossSimulation and math.random() < self.PacketLossAmount then
        return false -- Drop packet
    end
    
    -- Simulate packet order
    if self.PacketOrderSimulation then
        if self.PacketOrderType == "random" then
            if math.random() < 0.5 then
                wait(math.random() * 0.1)
            end
        elseif self.PacketOrderType == "reverse" then
            -- Reverse packet order (simulate by reordering queue)
            local queue = self.RequestQueue
            table.sort(queue, function(a, b)
                return a.Time > b.Time
            end)
        end
    end
    
    return true
end

function RemoteSystem:LogRemoteCall(remote, args, result)
    local log = {
        Remote = remote,
        Time = os.time(),
        Args = args,
        Result = result,
        Size = #args
    }
    
    table.insert(self.RequestHistory, log)
    if #self.RequestHistory > self.MaxHistorySize then
        table.remove(self.RequestHistory, 1)
    end
    
    self.PacketCount = self.PacketCount + 1
    self.PacketSize = self.PacketSize + #args
    self.Bandwidth = self.PacketSize / (os.time() - self.LastPacketTime + 1)
    self.LastPacketTime = os.time()
end

function RemoteSystem:GetRemoteInfo(remote)
    return self.Remotes[remote]
end

function RemoteSystem:GetAllRemotes()
    return self.Remotes
end

function RemoteSystem:GetRemoteCalls(remote)
    return self.RemoteCalls[remote] or 0
end

function RemoteSystem:ClearRemoteCalls()
    self.RemoteCalls = {}
end

function RemoteSystem:AnalyzeRemotePatterns()
    local patterns = {}
    
    for remote, info in pairs(self.Remotes) do
        local name = remote.Name
        local pattern = name:gsub("%d+", "*")
        if not patterns[pattern] then
            patterns[pattern] = {
                Count = 0,
                Remotes = {}
            }
        end
        patterns[pattern].Count = patterns[pattern].Count + 1
        table.insert(patterns[pattern].Remotes, remote)
    end
    
    return patterns
end

function RemoteSystem:FindRemoteByName(name)
    for remote, info in pairs(self.Remotes) do
        if remote.Name == name then
            return remote
        end
    end
    return nil
end

function RemoteSystem:FindRemoteByPath(path)
    for remote, info in pairs(self.Remotes) do
        if remote:GetFullName() == path then
            return remote
        end
    end
    return nil
end

