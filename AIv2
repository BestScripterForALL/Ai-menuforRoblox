function AdvancedESP:CreateBox3D(player, position, size)
    -- Create 3D box using multiple lines
    local lines = {}
    local corners = {
        position + Vector3.new(-size.X/2, -size.Y, -size.Z/2),
        position + Vector3.new(size.X/2, -size.Y, -size.Z/2),
        position + Vector3.new(size.X/2, 0, -size.Z/2),
        position + Vector3.new(-size.X/2, 0, -size.Z/2),
        position + Vector3.new(-size.X/2, -size.Y, size.Z/2),
        position + Vector3.new(size.X/2, -size.Y, size.Z/2),
        position + Vector3.new(size.X/2, 0, size.Z/2),
        position + Vector3.new(-size.X/2, 0, size.Z/2)
    }
    
    local edges = {
        {1,2}, {2,3}, {3,4}, {4,1},
        {5,6}, {6,7}, {7,8}, {8,5},
        {1,5}, {2,6}, {3,7}, {4,8}
    }
    
    for _, edge in pairs(edges) do
        local p1 = corners[edge[1]]
        local p2 = corners[edge[2]]
        local screen1, onScreen1 = Camera:WorldToViewportPoint(p1)
        local screen2, onScreen2 = Camera:WorldToViewportPoint(p2)
        
        if onScreen1 and onScreen2 then
            local line = Drawing.new("Line")
            line.From = Vector2.new(screen1.X, screen1.Y)
            line.To = Vector2.new(screen2.X, screen2.Y)
            line.Color = self.BoxColor
            line.Thickness = self.BoxThickness
            line.Visible = true
            table.insert(self.DrawingObjects, line)
            table.insert(lines, line)
        end
    end
    
    return lines
end

