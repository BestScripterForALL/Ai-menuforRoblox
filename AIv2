function MainEngine:HandleCommand(input)
    local cmd = input:lower()
    local args = {}
    for arg in input:gmatch("%S+") do
        table.insert(args, arg)
    end
    
    if args[1] and self.Commands[args[1]] then
        self.Commands[args[1]]()
        return true
    end
    
    return false
end

