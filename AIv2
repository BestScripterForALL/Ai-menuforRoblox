    else
        grounded = false
    end
    
    self.BHop.Grounded = grounded
    
    -- Jump logic
    if grounded then
        self.BHop.JumpCount = 0
        self.BHop.JumpState = false
    end
    
    -- Auto jump
    if self.BHop.AutoJump and grounded then
        wait(self.BHop.AutoJumpDelay)
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        self.BHop.JumpCount = self.BHop.JumpCount + 1
        self.BHop.JumpState = true
        self.BHop.LastJumpTime = os.time()
    end
    
    -- Perfect bhop
    if self.BHop.Mode == "perfect" and not grounded then
        if humanoid.MoveDirection.Magnitude > 0.1 then
            local velocity = rootPart.Velocity
            local horizontalVelocity = Vector3.new(velocity.X, 0, velocity.Z)
            local speed = horizontalVelocity.Magnitude
            
            if speed > 0 then
                local direction = horizontalVelocity.Unit
                local newVelocity = direction * self.BHop.CustomSpeed
                rootPart.Velocity = Vector3.new(newVelocity.X, velocity.Y, newVelocity.Z)
            end
        end
    end
    
    -- Strafe
    if self.BHop.StrafeEnabled and not grounded then
        local moveDirection = humanoid.MoveDirection
        if moveDirection.Magnitude > 0 then
            local strafeDirection = Vector3.new(-moveDirection.Z, 0, moveDirection.X)
            local strafeVector = strafeDirection * self.BHop.StrafeSpeed
            
            if self.BHop.StrafeDirection == "left" then
                rootPart.Velocity = rootPart.Velocity + strafeVector * 0.1
            else
                rootPart.Velocity = rootPart.Velocity - strafeVector * 0.1
            end
        end
    end
    
    -- Air control
    if self.BHop.AirControl and not grounded then
        local moveDirection = humanoid.MoveDirection
        if moveDirection.Magnitude > 0 then
            local currentVelocity = rootPart.Velocity
            local targetVelocity = moveDirection * self.BHop.CustomSpeed
            local newVelocity = currentVelocity:Lerp(targetVelocity, self.BHop.AirControlAmount * 0.1)
            rootPart.Velocity = newVelocity
        end
    end
    
    -- Speed cap
    if self.BHop.SpeedCap > 0 then
        local velocity = rootPart.Velocity
        local speed = velocity.Magnitude
        if speed > self.BHop.SpeedCap then
            local direction = velocity.Unit
            rootPart.Velocity = direction * self.BHop.SpeedCap
        end
    end
    
    -- Auto sprint
    if self.BHop.AutoSprint then
        if UserInputService:IsKeyDown(Enum.KeyCode[self.BHop.SprintKey]) then
            humanoid.WalkSpeed = self.BHop.CustomSpeed
        else
            humanoid.WalkSpeed = 16
        end
    end
    
    -- Crouch toggle
    if self.BHop.CrouchToggle then
        if UserInputService:IsKeyDown(Enum.KeyCode[self.BHop.CrouchKey]) then
            humanoid.Crouch = true
        else
            humanoid.Crouch = false
        end
    end
    
    -- Fast fall
    if self.BHop.FastFall and UserInputService:IsKeyDown(Enum.KeyCode[self.BHop.FastFallKey]) then
        if not grounded then
            rootPart.Velocity = rootPart.Velocity + Vector3.new(0, -50, 0)
        end
    end
    
    -- Wall run
    if self.BHop.WallRun and not grounded then
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {character}
        
        local wallDirection = Vector3.new(0, 0, 0)
        local wallFound = false
        
        -- Check for wall on left
        local leftRay = workspace:Raycast(rootPart.Position, rootPart.CFrame.LeftVector * 3, raycastParams)
        if leftRay then
            wallDirection = rootPart.CFrame.LeftVector
            wallFound = true
            self.BHop.WallRunDirection = "left"
        end
        
        -- Check for wall on right
        if not wallFound then
            local rightRay = workspace:Raycast(rootPart.Position, rootPart.CFrame.RightVector * 3, raycastParams)
            if rightRay then
                wallDirection = rootPart.CFrame.RightVector
                wallFound = true
                self.BHop.WallRunDirection = "right"
            end
        end
        
        if wallFound then
            self.BHop.WallRunTime = self.BHop.WallRunTime + 0.05
            
            if self.BHop.WallRunTime < self.BHop.WallRunMaxTime then
                local wallVelocity = Vector3.new(0, 0, 0)
                if self.BHop.WallRunDirection == "left" then
                    wallVelocity = rootPart.CFrame.LookVector * self.BHop.ClimbSpeed
                else
                    wallVelocity = -rootPart.CFrame.LookVector * self.BHop.ClimbSpeed
                end
                rootPart.Velocity = wallVelocity + Vector3.new(0, self.BHop.ClimbSpeed / 2, 0)
            end
        else
            self.BHop.WallRunTime = 0
        end
    end
    
    -- Slide
    if self.BHop.Slide and UserInputService:IsKeyDown(Enum.KeyCode[self.BHop.SlideKey]) and grounded then
        local moveDirection = humanoid.MoveDirection
        if moveDirection.Magnitude > 0 then
            local slideVelocity = moveDirection * self.BHop.SlideDistance
            rootPart.Velocity = slideVelocity
            
            humanoid.HipHeight = 0.5
            wait(self.BHop.SlideDuration)
            humanoid.HipHeight = 1
        end
    end
end

function AdvancedMovement:SpeedHack_Update()
    if not self.SpeedHack.Enabled then return end
    
    local localPlayer = Players.LocalPlayer
    if not localPlayer or not localPlayer.Character then return end
    
    local humanoid = localPlayer.Character:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    if self.SpeedHack.Mode == "normal" then
        humanoid.WalkSpeed = self.SpeedHack.WalkSpeed
        humanoid.JumpPower = self.SpeedHack.JumpPower
    elseif self.SpeedHack.Mode == "multiplicative" then
        humanoid.WalkSpeed = 16 * self.SpeedHack.Multiplier
        humanoid.JumpPower = 50 * self.SpeedHack.Multiplier
    elseif self.SpeedHack.Mode == "additive" then
        humanoid.WalkSpeed = 16 + self.SpeedHack.CustomWalkSpeed
        humanoid.JumpPower = 50 + self.SpeedHack.CustomJumpPower
    end
    
    -- Gravity
    if self.SpeedHack.Gravity ~= 196.2 then
        workspace.Gravity = self.SpeedHack.Gravity
    end
end

function AdvancedMovement:FlyHack_Update()
    if not self.FlyHack.Enabled then return end
    
    local localPlayer = Players.LocalPlayer
    if not localPlayer or not localPlayer.Character then return end
    
    local character = localPlayer.Character
    local humanoid = character:FindFirstChild("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not rootPart then return end
    
    local moveDirection = humanoid.MoveDirection
    local flyVelocity = Vector3.new(0, 0, 0)
    
    if self.FlyHack.Mode == "free" then
        local moveVector = Vector3.new(moveDirection.X, 0, moveDirection.Z)
        local verticalVector = Vector3.new(0, moveDirection.Y, 0)
        
        if moveVector.Magnitude > 0 then
            flyVelocity = flyVelocity + moveVector * self.FlyHack.HorizontalSpeed * 0.1
        end
        
        if verticalVector.Magnitude > 0 then
            flyVelocity = flyVelocity + verticalVector * self.FlyHack.VerticalSpeed * 0.1
        end
        
    elseif self.FlyHack.Mode == "directional" then
        local lookVector = Camera.CFrame.LookVector
        local rightVector = Camera.CFrame.RightVector
        local upVector = Camera.CFrame.UpVector
        
        if moveDirection.X ~= 0 then
            flyVelocity = flyVelocity + rightVector * moveDirection.X * self.FlyHack.HorizontalSpeed * 0.1
        end
        if moveDirection.Z ~= 0 then
            flyVelocity = flyVelocity + lookVector * moveDirection.Z * self.FlyHack.HorizontalSpeed * 0.1
        end
        if moveDirection.Y ~= 0 then
            flyVelocity = flyVelocity + upVector * moveDirection.Y * self.FlyHack.VerticalSpeed * 0.1
        end
    end
    
    -- No clip
    if self.FlyHack.NoClip then
        if self.FlyHack.NoClipMode == "solid" then
            character:SetAttribute("NoClip", true)
        elseif self.FlyHack.NoClipMode == "ghost" then
            rootPart.Transparency = 0.5
            character:SetAttribute("NoClip", true)
        elseif self.FlyHack.NoClipMode == "phasing" then
            rootPart.Transparency = 0.8
            rootPart.CanCollide = false
        end
    end
    
    -- Smooth movement
    if self.FlyHack.SmoothMovement then
        local currentVelocity = rootPart.Velocity
        local smoothVelocity = currentVelocity:Lerp(flyVelocity, self.FlyHack.SmoothAmount)
        rootPart.Velocity = smoothVelocity
    else
        rootPart.Velocity = flyVelocity
    end
    
    -- Auto land
    if self.FlyHack.AutoLand then
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {character}
        
        local rayResult = workspace:Raycast(rootPart.Position, Vector3.new(0, -self.FlyHack.LandDistance, 0), raycastParams)
        if rayResult then
            humanoid:ChangeState(Enum.HumanoidStateType.Landed)
            self.FlyHack.Enabled = false
        end
    end
    
    -- Teleport
    if self.FlyHack.Teleport and UserInputService:IsKeyDown(Enum.KeyCode[self.FlyHack.TeleportKey]) then
        local targetPosition = Camera.CFrame.p + Camera.CFrame.LookVector * self.FlyHack.TeleportDistance
        rootPart.CFrame = CFrame.new(targetPosition)
    end
end

function AdvancedMovement:Teleportation_Update()
    if not self.Teleportation.Enabled then return end
    
    if self.Teleportation.Cooldown > 0 and os.time() - self.Teleportation.LastTeleport < self.Teleportation.Cooldown then
        return
    end
    
    local localPlayer = Players.LocalPlayer
    if not localPlayer or not localPlayer.Character then return end
    
    local rootPart = localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local teleportTarget = nil
    
    if self.Teleportation.Mode == "click" then
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            local mousePos = UserInputService:GetMouseLocation()
            local ray = Camera:ScreenPointToRay(mousePos.X, mousePos.Y)
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {localPlayer.Character}
            
            local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, raycastParams)
            if result then
                teleportTarget = result.Position
            end
        end
    elseif self.Teleportation.Mode == "key" then
        if UserInputService:IsKeyDown(Enum.KeyCode[self.Teleportation.Key]) then
            teleportTarget = Camera.CFrame.p + Camera.CFrame.LookVector * self.Teleportation.Distance
        end
    elseif self.Teleportation.Mode == "auto" then
        -- Auto teleport to target
        local target = AdvancedAimBot.CurrentTarget
        if target and target.RootPart then
            teleportTarget = target.RootPart.Position
        end
    end
    
    if teleportTarget then
        -- Safe check
        if self.Teleportation.SafeCheck then
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {localPlayer.Character}
            
            local result = workspace:Raycast(teleportTarget, Vector3.new(0, -5, 0), raycastParams)
            if result then
                rootPart.CFrame = CFrame.new(teleportTarget)
                self.Teleportation.LastTeleport = os.time()
            end
        else
            rootPart.CFrame = CFrame.new(teleportTarget)
            self.Teleportation.LastTeleport = os.time()
        end
    end
end

function AdvancedMovement:AntiCheat_Update()
    if not self.AntiCheat.Enabled then return end
    
    local localPlayer = Players.LocalPlayer
    if not localPlayer or not localPlayer.Character then return end
    
    local humanoid = localPlayer.Character:FindFirstChild("Humanoid")
    local rootPart = localPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not rootPart then return end
    
    -- Spoof speed
    if self.AntiCheat.SpoofSpeed then
        local currentSpeed = rootPart.Velocity.Magnitude
        local spoofSpeed = currentSpeed * self.AntiCheat.SpoofAmount
        -- Send fake speed to server
        local fakeSpeed = math.floor(spoofSpeed * 100) / 100
        localPlayer:SetAttribute("FakeSpeed", fakeSpeed)
    end
    
    -- Spoof jump
    if self.AntiCheat.SpoofJump then
        local currentJump = humanoid.JumpPower
        local spoofJump = currentJump * self.AntiCheat.SpoofJumpAmount
        humanoid.JumpPower = spoofJump
    end
    
    -- Fake walk
    if self.AntiCheat.FakeWalk then
        if humanoid.MoveDirection.Magnitude > 0 then
            local fakePosition = rootPart.Position + rootPart.Velocity * self.AntiCheat.FakeWalkAmount * 0.1
            localPlayer:SetAttribute("FakePosition", fakePosition)
        end
    end
    
    -- Lag compensation
    if self.AntiCheat.LagCompensation then
        local randomLag = math.random() * self.AntiCheat.LagAmount
        wait(randomLag)
    end
    
    -- Packet loss
    if self.AntiCheat.PacketLoss then
        if math.random() < self.AntiCheat.PacketLossAmount then
            -- Simulate packet loss
            localPlayer:SetAttribute("PacketLoss", true)
            wait(0.1)
            localPlayer:SetAttribute("PacketLoss", false)
        end
    end
    
    -- Anti kick
    if self.AntiCheat.AntiKick then
        pcall(function()
            localPlayer:Kick = function() end
        end)
    end
    
    -- Anti ban
    if self.AntiCheat.AntiBan then
        pcall(function()
            localPlayer:Banned = false
        end)
    end
    
    -- Anti freeze
    if self.AntiCheat.AntiFreeze then
        pcall(function()
            if humanoid.PlatformStand then
                humanoid.PlatformStand = false
            end
        end)
    end
    
    -- Anti lag
    if self.AntiCheat.AntiLag then
        if settings().Network.AllowClientPing then
            settings().Network.AllowClientPing = false
        end
    end
    
    -- Anti fall
    if self.AntiCheat.AntiFall then
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {localPlayer.Character}
        
        local rayResult = workspace:Raycast(rootPart.Position, Vector3.new(0, -100, 0), raycastParams)
        if not rayResult then
            rootPart.CFrame = CFrame.new(rootPart.Position + Vector3.new(0, 100, 0))
        end
    end
    
    -- Anti teleport detection
    if self.AntiCheat.AntiTp then
        localPlayer:SetAttribute("LastPosition", rootPart.Position)
    end
    
    -- Anti bhop detection
    if self.AntiCheat.AntiBhopDetection then
        if self.BHop.Enabled then
            local randomDelay = math.random() * 0.1
            wait(randomDelay)
        end
    end
    
    -- Anti speed detection
    if self.AntiCheat.AntiSpeedDetection then
        if self.SpeedHack.Enabled then
            local randomSpeed = 16 + math.random() * 10
            humanoid.WalkSpeed = randomSpeed
            wait(0.5)
            humanoid.WalkSpeed = self.SpeedHack.WalkSpeed
        end
    end
    
    -- Anti fly detection
    if self.AntiCheat.AntiFlyDetection then
        if self.FlyHack.Enabled then
            if math.random() < 0.1 then
                humanoid:ChangeState(Enum.HumanoidStateType.Landed)
                wait(0.5)
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end

