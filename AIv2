local MobileMovement = {
    BHop = {
        Enabled = false,
        Mode = "perfect",
        AutoJump = true,
        StrafeEnabled = true,
        StrafeSpeed = 1.2,
        AirControl = true,
        CustomSpeed = 16,
        JumpPower = 50
    },
    SpeedHack = {
        Enabled = false,
        Speed = 50,
        WalkSpeed = 16,
        JumpPower = 50
    },
    FlyHack = {
        Enabled = false,
        Speed = 50,
        NoClip = false
    },
    Teleportation = {
        Enabled = false,
        Distance = 50
    }
}

function MobileMovement:BHop_Update()
    if not self.BHop.Enabled then return end
    
    local localPlayer = Players.LocalPlayer
    if not localPlayer or not localPlayer.Character then return end
    
    local character = localPlayer.Character
    local humanoid = character:FindFirstChild("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not rootPart then return end
    
    -- Check if grounded
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {character}
    local rayResult = workspace:Raycast(rootPart.Position, Vector3.new(0, -5, 0), raycastParams)
    local grounded = rayResult ~= nil
    
    -- Auto jump
    if self.BHop.AutoJump and grounded then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
    
    -- Strafe
    if self.BHop.StrafeEnabled and not grounded then
        local moveDirection = humanoid.MoveDirection
        if moveDirection.Magnitude > 0 then
            local strafeDirection = Vector3.new(-moveDirection.Z, 0, moveDirection.X)
            rootPart.Velocity = rootPart.Velocity + strafeDirection * self.BHop.StrafeSpeed * 0.1
        end
    end
    
    -- Air control
    if self.BHop.AirControl and not grounded then
        local moveDirection = humanoid.MoveDirection
        if moveDirection.Magnitude > 0 then
            local targetVelocity = moveDirection * self.BHop.CustomSpeed
            rootPart.Velocity = rootPart.Velocity:Lerp(targetVelocity, 0.08)
        end
    end
end

function MobileMovement:SpeedHack_Update()
    if not self.SpeedHack.Enabled then return end
    
    local localPlayer = Players.LocalPlayer
    if not localPlayer or not localPlayer.Character then return end
    
    local humanoid = localPlayer.Character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = self.SpeedHack.WalkSpeed
        humanoid.JumpPower = self.SpeedHack.JumpPower
    end
end

function MobileMovement:FlyHack_Update()
    if not self.FlyHack.Enabled then return end
    
    local localPlayer = Players.LocalPlayer
    if not localPlayer or not localPlayer.Character then return end
    
    local character = localPlayer.Character
    local humanoid = character:FindFirstChild("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not rootPart then return end
    
    local moveDirection = humanoid.MoveDirection
    local flyVelocity = Vector3.new(0, 0, 0)
    
    if moveDirection.Magnitude > 0 then
        flyVelocity = moveDirection * self.FlyHack.Speed * 0.1
    end
    
    if self.FlyHack.NoClip then
        character:SetAttribute("NoClip", true)
    end
    
    rootPart.Velocity = flyVelocity
end

function MobileMovement:Teleportation_Update()
    if not self.Teleportation.Enabled then return end
    
    local localPlayer = Players.LocalPlayer
    if not localPlayer or not localPlayer.Character then return end
    
    local rootPart = localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    -- Tap to teleport forward
    local targetPosition = Camera.CFrame.p + Camera.CFrame.LookVector * self.Teleportation.Distance
    rootPart.CFrame = CFrame.new(targetPosition)
end

