function AdvancedAimBot:FindTargets()
    local targets = {}
    local localPlayer = Players.LocalPlayer
    if not localPlayer or not localPlayer.Character then return targets end
    
    local character = localPlayer.Character
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return targets end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local targetChar = player.Character
            local humanoid = targetChar:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
                if targetRoot then
                    local distance = (targetRoot.Position - rootPart.Position).Magnitude
                    if distance <= self.MaxDistance then
                        local head = targetChar:FindFirstChild("Head")
                        local neck = targetChar:FindFirstChild("Neck")
                        local chest = targetChar:FindFirstChild("UpperTorso")
                        local spine = targetChar:FindFirstChild("LowerTorso")
                        
                        local targetInfo = {
                            Player = player,
                            Character = targetChar,
                            Humanoid = humanoid,
                            RootPart = targetRoot,
                            Head = head,
                            Neck = neck,
                            Chest = chest,
                            Spine = spine,
                            Distance = distance,
                            Health = humanoid.Health,
                            MaxHealth = humanoid.MaxHealth,
                            HealthPercent = humanoid.Health / humanoid.MaxHealth * 100,
                            Velocity = targetRoot.Velocity,
                            Position = targetRoot.Position,
                            Visible = self:IsVisible(targetRoot.Position)
                        }
                        
                        table.insert(targets, targetInfo)
                    end
                end
            end
        end
    end
    
    return targets
end

function AdvancedAimBot:IsVisible(position)
    if not self.VisibilityCheck then return true end
    
    local origin = Camera.CFrame.p
    local direction = (position - origin).Unit
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {Players.LocalPlayer.Character}
    
    local result = workspace:Raycast(origin, direction * (position - origin).Magnitude, raycastParams)
    return not result or result.Instance:IsA("BasePart") and result.Instance.Name == "Head"
end

function AdvancedAimBot:GetBonePosition(target, bone)
    if bone == "head" and target.Head then
        return target.Head.Position
    elseif bone == "neck" and target.Neck then
        return target.Neck.Position
    elseif bone == "chest" and target.Chest then
        return target.Chest.Position
    elseif bone == "spine" and target.Spine then
        return target.Spine.Position
    elseif bone == "root" then
        return target.RootPart.Position
    else
        return target.RootPart and target.RootPart.Position or nil
    end
end

function AdvancedAimBot:SelectTarget(targets)
    if #targets == 0 then return nil end
    
    if self.TargetMode == "closest" then
        table.sort(targets, function(a, b)
            return a.Distance < b.Distance
        end)
        return targets[1]
        
    elseif self.TargetMode == "lowest_health" then
        table.sort(targets, function(a, b)
            return a.HealthPercent < b.HealthPercent
        end)
        return targets[1]
        
    elseif self.TargetMode == "highest_health" then
        table.sort(targets, function(a, b)
            return a.HealthPercent > b.HealthPercent
        end)
        return targets[1]
        
    elseif self.TargetMode == "nearest_crosshair" then
        local bestTarget = nil
        local bestDistance = self.FOV
        
        for _, target in pairs(targets) do
            local bonePos = self:GetBonePosition(target, self.BoneSelection)
            if bonePos then
                local screenPos, onScreen = Camera:WorldToViewportPoint(bonePos)
                if onScreen then
                    local crosshairDist = Vector2.new(screenPos.X - Camera.ViewportSize.X/2, screenPos.Y - Camera.ViewportSize.Y/2).Magnitude
                    if crosshairDist < bestDistance then
                        bestDistance = crosshairDist
                        bestTarget = target
                    end
                end
            end
        end
        return bestTarget
    end
    
    return targets[1]
end

function AdvancedAimBot:CalculatePrediction(target)
    if not self.Prediction then return target.Position end
    
    local velocity = target.Velocity
    local position = target.Position
    local predictionTime = self.PredictionTime
    
    -- Simple linear prediction
    local predictedPos = position + velocity * predictionTime
    
    -- Store prediction history
    table.insert(self.PredictionHistory, {
        Position = predictedPos,
        Time = os.time()
    })
    
    if #self.PredictionHistory > 50 then
        table.remove(self.PredictionHistory, 1)
    end
    
    return predictedPos
end

function AdvancedAimBot:GetSmoothPosition(current, target, smoothness)
    if smoothness <= 0 then return target end
    
    local delta = target - current
    local step = delta / smoothness
    
    if self.SmoothingType == "linear" then
        return current + step
        
    elseif self.SmoothingType == "exponential" then
        return current + delta * (1 - math.exp(-1 / smoothness))
        
    elseif self.SmoothingType == "bezier" then
        local t = 1 / smoothness
        return current + delta * (3 * t^2 - 2 * t^3)
    end
    
    return current + step
end

function AdvancedAimBot:ApplyHumanization(position)
    if not self.Humanization then return position end
    
    local amount = self.HumanizationAmount
    local noise = Vector3.new(
        math.random() - 0.5,
        math.random() - 0.5,
        math.random() - 0.5
    ) * amount
    
    return position + noise
end

function AdvancedAimBot:AimAt(target)
    if not target then return end
    
    local bonePos = self:GetBonePosition(target, self.BoneSelection)
    if not bonePos then return end
    
    -- Calculate prediction
    local predictedPos = self:CalculatePrediction(target)
    
    -- Apply humanization
    local aimPos = self:ApplyHumanization(predictedPos)
    
    -- Get current camera position
    local cameraPos = Camera.CFrame.p
    local targetCFrame = CFrame.new(cameraPos, aimPos)
    
    if self.Mode == "silent" then
        -- Silent aim (only affects view direction)
        local lookVector = (aimPos - cameraPos).Unit
        local newCFrame = CFrame.new(cameraPos, cameraPos + lookVector)
        Camera.CFrame = Camera.CFrame:Lerp(newCFrame, 1 / self.Smoothness)
        
    elseif self.Mode == "normal" then
        -- Normal aim (affects camera directly)
        Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1 / self.Smoothness)
        
    elseif self.Mode == "rage" then
        -- Instant aim
        Camera.CFrame = targetCFrame
    end
    
    self.LastTarget = target
    self.CurrentTarget = target
end

function AdvancedAimBot:TriggerBot()
    if not self.TriggerBot then return end
    
    local target = self.CurrentTarget
    if not target then return end
    
    local bonePos = self:GetBonePosition(target, self.BoneSelection)
    if bonePos then
        local screenPos, onScreen = Camera:WorldToViewportPoint(bonePos)
        if onScreen and screenPos.Z > 0 then
            local crosshairDist = Vector2.new(screenPos.X - Camera.ViewportSize.X/2, screenPos.Y - Camera.ViewportSize.Y/2).Magnitude
            if crosshairDist < 50 then
                -- Simulate click
                local mouse = game:GetService("VirtualUser")
                mouse:CaptureController()
                
                if self.TriggerKey == "MouseButton1" then
                    mouse:ClickButton1(Vector2.new(screenPos.X, screenPos.Y))
                elseif self.TriggerKey == "MouseButton2" then
                    mouse:ClickButton2(Vector2.new(screenPos.X, screenPos.Y))
                end
                
                self.ShotsFired = self.ShotsFired + 1
            end
        end
    end
end

function AdvancedAimBot:Update()
    if not self.Enabled then return end
    
    local targets = self:FindTargets()
    local target = self:SelectTarget(targets)
    
    if target then
        self:AimAt(target)
        self:TriggerBot()
        
        -- Update stats
        self.ShotsFired = self.ShotsFired + 1
        if self.HitChance > 80 then
            self.Hits = self.Hits + 1
        end
        self.HitRate = self.Hits / self.ShotsFired * 100
    end
end

