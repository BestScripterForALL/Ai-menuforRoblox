    btn.Text = selected
    btn.TextColor3 = self.Themes[self.Theme].Text
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.Parent = dropdown
    
    local expanded = false
    local list = Instance.new("ScrollingFrame")
    list.Size = UDim2.new(0.5, 0, 0, 0)
    list.Position = UDim2.new(0.5, 0, 1, 0)
    list.BackgroundColor3 = self.Themes[self.Theme].Foreground
    list.BorderSizePixel = 1
    list.BorderColor3 = self.Themes[self.Theme].Border
    list.CanvasSize = UDim2.new(0, 0, 0, 0)
    list.ScrollBarThickness = 4
    list.Visible = false
    list.Parent = dropdown
    
    local items = {}
    for i, option in pairs(options) do
        local item = Instance.new("TextButton")
        item.Size = UDim2.new(1, 0, 0, 40)
        item.BackgroundColor3 = self.Themes[self.Theme].Foreground
        item.Text = option
        item.TextColor3 = self.Themes[self.Theme].Text
        item.Font = Enum.Font.Gotham
        item.TextSize = 14
        item.Parent = list
        item.TouchTap:Connect(function()
            selected = option
            btn.Text = option
            expanded = false
            list.Visible = false
            list.Size = UDim2.new(0.5, 0, 0, 0)
            if callback then callback(option) end
        end)
        item.MouseButton1Click:Connect(function()
            selected = option
            btn.Text = option
            expanded = false
            list.Visible = false
            list.Size = UDim2.new(0.5, 0, 0, 0)
            if callback then callback(option) end
        end)
        table.insert(items, item)
    end
    
    list.CanvasSize = UDim2.new(0, 0, 0, #options * 40)
    list.Size = UDim2.new(0.5, 0, 0, math.min(#options * 40, 200))
    
    btn.TouchTap:Connect(function()
        expanded = not expanded
        list.Visible = expanded
        if expanded then
            list.Size = UDim2.new(0.5, 0, 0, math.min(#options * 40, 200))
        else
            list.Size = UDim2.new(0.5, 0, 0, 0)
        end
    end)
    
    btn.MouseButton1Click:Connect(function()
        expanded = not expanded
        list.Visible = expanded
        if expanded then
            list.Size = UDim2.new(0.5, 0, 0, math.min(#options * 40, 200))
        else
            list.Size = UDim2.new(0.5, 0, 0, 0)
        end
    end)
    
    table.insert(tab.Elements, dropdown)
    return dropdown, function() return selected end
end

