-- Memory Management System
local MemoryManager = {
    Allocated = 0,
    Freed = 0,
    Objects = {},
    WeakRefs = {},
    GarbageCollector = nil,
    HeapSize = 0,
    StackSize = 0,
    MemoryLimit = 1024 * 1024 * 500, -- 500MB
    MemoryThreshold = 0.8,
    LastCollection = os.time(),
    CollectionInterval = 60,
    Fragmentation = 0,
    AllocCount = 0,
    FreeCount = 0
}

function MemoryManager:Allocate(size, data)
    self.Allocated = self.Allocated + size
    self.AllocCount = self.AllocCount + 1
    local id = #self.Objects + 1
    self.Objects[id] = {
        Size = size,
        Data = data,
        Created = os.time(),
        Accessed = os.time(),
        References = 0
    }
    self.HeapSize = self.HeapSize + size
    return id
end

function MemoryManager:Free(id)
    if self.Objects[id] then
        self.Freed = self.Freed + self.Objects[id].Size
        self.FreeCount = self.FreeCount + 1
        self.HeapSize = self.HeapSize - self.Objects[id].Size
        self.Objects[id] = nil
    end
end

function MemoryManager:CollectGarbage()
    local now = os.time()
    if now - self.LastCollection > self.CollectionInterval then
        local toRemove = {}
        for id, obj in pairs(self.Objects) do
            if now - obj.Accessed > 300 then -- 5 minutes unused
                table.insert(toRemove, id)
            end
        end
        for _, id in pairs(toRemove) do
            self:Free(id)
        end
        self.LastCollection = now
        collectgarbage("collect")
        return #toRemove
    end
    return 0
end

-- Advanced Task Scheduler
local TaskScheduler = {
    Tasks = {},
    Running = false,
    MaxConcurrent = 10,
    CurrentRunning = 0,
    Queue = {},
    PriorityLevels = {
        CRITICAL = 1,
        HIGH = 2,
        NORMAL = 3,
        LOW = 4,
        BACKGROUND = 5
    }
}

function TaskScheduler:AddTask(name, func, priority, interval)
    priority = priority or self.PriorityLevels.NORMAL
    interval = interval or 0
    local task = {
        Name = name,
        Function = func,
        Priority = priority,
        Interval = interval,
        LastRun = 0,
        NextRun = 0,
        Running = false,
        ErrorCount = 0,
        TotalRuns = 0,
        AvgTime = 0
    }
    table.insert(self.Tasks, task)
    return task
end

function TaskScheduler:ProcessQueue()
    table.sort(self.Tasks, function(a, b)
        return a.Priority < b.Priority
    end)
    
    local now = os.clock()
    for _, task in pairs(self.Tasks) do
        if not task.Running and task.NextRun <= now then
            if self.CurrentRunning < self.MaxConcurrent then
                self:ExecuteTask(task)
            end
        end
    end
end

function TaskScheduler:ExecuteTask(task)
    task.Running = true
    task.TotalRuns = task.TotalRuns + 1
    self.CurrentRunning = self.CurrentRunning + 1
    
    local startTime = os.clock()
    local success, err = pcall(task.Function)
    local endTime = os.clock()
    task.AvgTime = (task.AvgTime * (task.TotalRuns - 1) + (endTime - startTime)) / task.TotalRuns
    
    if not success then
        task.ErrorCount = task.ErrorCount + 1
        print("[AI] Task Error:", task.Name, err)
    end
    
    task.Running = false
    self.CurrentRunning = self.CurrentRunning - 1
    task.LastRun = os.time()
    task.NextRun = os.clock() + task.Interval
end

-- Advanced Event System
local EventSystem = {
    Events = {},
    Listeners = {},
    OnceListeners = {},
    Active = true
}

function EventSystem:RegisterEvent(name)
    if not self.Events[name] then
        self.Events[name] = {
            Listeners = {},
            OnceListeners = {},
            Data = {}
        }
    end
    return self.Events[name]
end

function EventSystem:AddListener(eventName, callback, priority)
    priority = priority or 0
    local listener = {
        Callback = callback,
        Priority = priority,
        Active = true
    }
    if not self.Events[eventName] then
        self:RegisterEvent(eventName)
    end
    table.insert(self.Events[eventName].Listeners, listener)
    return listener
end

function EventSystem:AddOnceListener(eventName, callback)
    if not self.Events[eventName] then
        self:RegisterEvent(eventName)
    end
    table.insert(self.Events[eventName].OnceListeners, {
        Callback = callback,
        Active = true
    })
end

function EventSystem:FireEvent(eventName, ...)
    if not self.Active then return end
    local event = self.Events[eventName]
    if not event then return end
    
    local args = {...}
    
    -- Sort listeners by priority
    table.sort(event.Listeners, function(a, b)
        return a.Priority > b.Priority
    end)
    
    -- Execute regular listeners
    for _, listener in pairs(event.Listeners) do
        if listener.Active then
            local success, err = pcall(listener.Callback, unpack(args))
            if not success then
                print("[AI] Event Listener Error:", err)
            end
        end
    end
    
    -- Execute once listeners
    for i = #event.OnceListeners, 1, -1 do
        local listener = event.OnceListeners[i]
        if listener and listener.Active then
            local success, err = pcall(listener.Callback, unpack(args))
            if not success then
                print("[AI] Once Listener Error:", err)
            end
            table.remove(event.OnceListeners, i)
        end
    end
end

