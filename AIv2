function GameAnalyzer:BuildObjectGraph()
    for id, data in pairs(self.ScannedObjects) do
        if data.Parent then
            if not self.ObjectGraph[data.Parent] then
                self.ObjectGraph[data.Parent] = {}
            end
            table.insert(self.ObjectGraph[data.Parent], id)
        end
    end
end

function GameAnalyzer:DetectPatterns()
    local patterns = {}
    
    -- Detect remote patterns
    local remotePatterns = {}
    for _, remote in pairs(self.RemoteCalls) do
        local pattern = remote.Name:gsub("%d+", "*")
        if not remotePatterns[pattern] then
            remotePatterns[pattern] = 0
        end
        remotePatterns[pattern] = remotePatterns[pattern] + 1
    end
    
    for pattern, count in pairs(remotePatterns) do
        if count > 3 then
            table.insert(patterns, {
                Type = "RemotePattern",
                Pattern = pattern,
                Count = count
            })
        end
    end
    
    self.Patterns = patterns
end

function GameAnalyzer:FindAnomalies()
    local anomalies = {}
    
    -- Check for suspicious objects
    for id, data in pairs(self.ScannedObjects) do
        if data.IsRemote and data.Depth > 10 then
            table.insert(anomalies, {
                Type = "DeepRemote",
                Location = id,
                Depth = data.Depth
            })
        end
        
        if data.IsPart and data.Properties and data.Properties.Size and data.Properties.Size > Vector3.new(100, 100, 100) then
            table.insert(anomalies, {
                Type = "GiantPart",
                Location = id,
                Size = data.Properties.Size
            })
        end
    end
    
    self.Anomalies = anomalies
end

function GameAnalyzer:GenerateSignatures()
    local signatures = {}
    
    for id, data in pairs(self.ScannedObjects) do
        if data.IsRemote then
            local signature = self:GenerateRemoteSignature(data.Instance)
            if signature then
                table.insert(signatures, signature)
            end
        end
    end
    
    self.Signatures = signatures
end

function GameAnalyzer:GenerateRemoteSignature(remote)
    if not remote then return nil end
    
    local signature = {
        Name = remote.Name,
        ClassName = remote.ClassName,
        Path = remote:GetFullName(),
        Methods = {}
    }
    
    if remote:IsA("RemoteEvent") then
        signature.Methods = {"FireServer", "FireAllClients", "FireClient"}
    elseif remote:IsA("RemoteFunction") then
        signature.Methods = {"InvokeServer", "InvokeClient"}
    end
    
    return signature
end

