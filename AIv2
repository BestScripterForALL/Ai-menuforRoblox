    end
    
    -- Check for signature analysis
    if self:DetectSignatureAnalysis() then
        table.insert(detections, "SignatureAnalysis")
        riskScore = riskScore + 20
    end
    
    -- Calculate detection rate
    self.DetectionRate = #detections / #self.DetectionMethods * 100
    self.RiskLevel = riskScore
    self.ThreatLevel = riskScore
    
    if #detections > 0 then
        self.LastDetected = os.time()
    end
    
    self.DetectionHistory = detections
    
    return detections, riskScore
end

