function MobileMenu:CreateTab(window, name, icon)
    -- Touch-friendly tab button
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 120, 0, 50)
    btn.Position = UDim2.new(0, #window.Tabs * 125 + 10, 0, 5)
    btn.BackgroundColor3 = self.Themes[self.Theme].Background
    btn.Text = icon and icon .. " " .. name or name
    btn.TextColor3 = self.Themes[self.Theme].Text
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.Parent = window.TabContainer
    
    -- Update canvas size
    window.TabContainer.CanvasSize = UDim2.new(0, (#window.Tabs + 1) * 125 + 10, 0, 60)
    
    -- Tab content (scrollable)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 0)
    frame.BackgroundTransparency = 1
    frame.Visible = false
    frame.Parent = window.ContentFrame
    
    local tab = {
        Name = name,
        Icon = icon,
        Button = btn,
        Frame = frame,
        Elements = {},
        Visible = false
    }
    
    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(window.Tabs) do
            t.Frame.Visible = false
            t.Button.BackgroundColor3 = self.Themes[self.Theme].Background
            t.Visible = false
        end
        frame.Visible = true
        tab.Visible = true
        btn.BackgroundColor3 = self.Themes[self.Theme].Foreground
        window.CurrentTab = tab
        
        -- Update canvas size for content
        local totalHeight = #tab.Elements * 60 + 20
        window.ContentFrame.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
        frame.Size = UDim2.new(1, 0, 0, totalHeight)
    end)
    
    table.insert(window.Tabs, tab)
    return tab
end

