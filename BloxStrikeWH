-- 9. ЛОГИКА WALLHACK (Highlight)
-- ============================================================
local activeHighlights = {}
local LocalTeam = nil

local function GetLocalTeam()
    if LocalTeam then return LocalTeam end
    local char = LocalPlayer.Character
    if not char then return nil end
    local characters = Workspace:FindFirstChild("Characters")
    if not characters then return nil end
    for _, folder in ipairs(characters:GetChildren()) do
        if folder:IsA("Folder") and folder:FindFirstChild(char.Name) then
            LocalTeam = folder.Name
            return LocalTeam
        end
    end
    return nil
end

local function IsEnemy(character)
    if not character or not character.Parent then return false end
    local teamFolder = character.Parent
    if not teamFolder:IsA("Folder") then return false end
    if teamFolder.Name == "Hostages" then return false end
    local localTeam = GetLocalTeam()
    if not localTeam then return true end
    return teamFolder.Name ~= localTeam
end

local function ApplyHighlight(character)
    if activeHighlights[character] then return end
    if not IsEnemy(character) then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "TornadoWH"
    highlight.Adornee = character
    highlight.Parent = character
    highlight.FillColor = Settings.EnemyColor
    highlight.FillTransparency = Settings.FillTransparency
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    activeHighlights[character] = highlight
end

local function RemoveHighlight(character)
    if activeHighlights[character] then
        activeHighlights[character]:Destroy()
        activeHighlights[character] = nil
    end
end

local function ProcessCharacter(character)
    if not character:IsA("Model") then return end
    if character == LocalPlayer.Character then return end
    if not character:FindFirstChild("Humanoid") then return end
    if IsEnemy(character) and Settings.WallHackEnabled then
        ApplyHighlight(character)
    else
        RemoveHighlight(character)
    end
end

local charactersFolder = Workspace:FindFirstChild("Characters")
if charactersFolder then
    for _, folder in ipairs(charactersFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, character in ipairs(folder:GetChildren()) do
                ProcessCharacter(character)
            end
            folder.ChildAdded:Connect(function(character)
                task.wait(0.1)
                ProcessCharacter(character)
            end)
            folder.ChildRemoved:Connect(RemoveHighlight)
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not Settings.WallHackEnabled then
        for _, highlight in pairs(activeHighlights) do
            highlight.Enabled = false
        end
        return
    end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    for character, highlight in pairs(activeHighlights) do
        if character and character.Parent then
            local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso")
            if root then
                local dist = (myRoot.Position - root.Position).Magnitude
                highlight.Enabled = dist <= Settings.MaxRenderDistance
            else
                highlight.Enabled = false
            end
        else
            RemoveHighlight(character)
        end
    end
end)
LocalPlayer.CharacterAdded:Connect(function()
    LocalTeam = nil
end)
