local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
   local method = getnamecallmethod()
   local args = {...}

   if _G.WallbangEnabled and (method == "Raycast" or method == "FindPartOnRayWithIgnoreList") then
      if typeof(args[3]) == "table" then
         table.insert(args[3], Workspace:FindFirstChild("Map"))
         table.insert(args[3], Workspace.Terrain)
      end
   end

   return oldNamecall(self, unpack(args))
end)

local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, k)
    if not checkcaller() and _G.RapidFireConfig.Enabled then
        if k == "Cooldown" or k == "FireRate" or k == "LastShot" then
            local weaponModule = rawget(self, "FireRate") or rawget(self, "Cooldown")
            if weaponModule then
                return weaponModule * _G.RapidFireConfig.Multiplier
            end
        end
    end
    return oldIndex(self, k)
end)

RunService.RenderStepped:Connect(function()
    UpdateESP()

    FOVCircle.Visible = Config.Aimbot.DrawFOV
    FOVCircle.Radius = Config.Aimbot.FOV
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if Config.Aimbot.Enabled then
        local targetPart = GetClosestTarget()
        if targetPart and LocalPlayer.Character then
            local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local aimAlign = rootPart and rootPart:FindFirstChild("AimAlign")
            
            if aimAlign and aimAlign:IsA("AlignOrientation") then
                local currentCFrame = rootPart.CFrame
                local targetCFrame = CFrame.lookAt(rootPart.Position, Vector3.new(targetPart.Position.X, targetPart.Position.Y, targetPart.Position.Z))
                aimAlign.CFrame = currentCFrame:Lerp(targetCFrame, 1)
            else
                local currentCFrame = Camera.CFrame
                local targetCFrame = CFrame.lookAt(currentCFrame.Position, targetPart.Position)
                Camera.CFrame = currentCFrame:Lerp(targetCFrame, 1)
            end

            if Config.Aimbot.TriggerbotEnabled then
                local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local screenCoord = Vector2.new(screenPos.X, screenPos.Y)
                    if (screenCoord - viewportCenter).Magnitude < 25 then
                        TriggerShoot()
                    end
                end
            end
        end
    end
end)

