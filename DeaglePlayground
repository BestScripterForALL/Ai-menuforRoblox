--------------------------------------------------------------------------------
local function GetCharacterParts(model)
    if not model or not model:IsA("Model") then return nil end
    if not model:FindFirstChildOfClass("Humanoid") then return nil end

    return {
        HeadHitbox = model:FindFirstChild("HeadHitbox"),
        BodyHitbox = model:FindFirstChild("BodyHitbox"),
        Root = model:FindFirstChild("HumanoidRootPart"),
        Head = model:FindFirstChild("Head")
    }
end

local function GetTargetPart(model, preferredType)
    local parts = GetCharacterParts(model)
    if not parts then return nil end

    if preferredType == "Head" then
        return parts.HeadHitbox or parts.Head or parts.Root
    elseif preferredType == "Body" then
        return parts.BodyHitbox or parts.Root
    else
        return parts.Root or parts.BodyHitbox or parts.HeadHitbox
    end
end

-- Функция проверки видимости (WallCheck через Raycast)
local function IsVisible(targetPart)
    if not Config.Aimbot.WallCheck or _G.WallbangEnabled then return true end
    
    local character = LocalPlayer.Character
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    -- Игнорируем себя и модели игроков/клиентский вьюмодел
    local ignoreList = {character, workspace:FindFirstChild("ClientViewmodel")}
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            table.insert(ignoreList, obj)
        end
    end
    raycastParams.FilterDescendantsInstances = ignoreList

    local result = Workspace:Raycast(origin, direction, raycastParams)
    if result then
        -- Если луч задел что-то до цели, значит цель за стеной
        local hitInstance = result.Instance
        if hitInstance:IsDescendantOf(targetPart.Parent) then
            return true
        end
        return false
    end
    
    return true
end

--------------------------------------------------------------------------------
-- 4. ЛОГИКА AIMBOT (С динамическим переключением на ближайшего по студам)
--------------------------------------------------------------------------------
local function GetClosestTarget()
    local closestPart = nil
    local shortestDistance3D = math.huge -- Ищем абсолютного лидера по дистанции в студах внутри FOV
    local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj ~= LocalPlayer.Character and obj.Name ~= "ClientViewmodel" then
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local targetPart = GetTargetPart(obj, Config.Aimbot.TargetPart)
                
                if targetPart then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local mouseDistance = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
                        
                        -- Проверяем FOV и видимость через стены (если WallCheck активен)
                        if mouseDistance <= Config.Aimbot.FOV and IsVisible(targetPart) then
                            local distance3D = (targetPart.Position - Camera.CFrame.Position).Magnitude
                            
                            -- Динамически переключаемся на врага, который ближе к нам в студах
                            if distance3D < shortestDistance3D then
                                shortestDistance3D = distance3D
                                closestPart = targetPart
                            end
                        end
                    end
                end
            end
        end
    end

    return closestPart
end

-- Надежный треил движения персонажа (живет ровно 3 секунды через кастомный менеджер без багов с Attachments)
local movementTrailInstance = nil
local trailAttachment0 = nil
local trailAttachment1 = nil

local function UpdateMovementTrailState()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    
    if Config.WorldModulation.MovementTrailEnabled and root then
        if not movementTrailInstance or movementTrailInstance.Parent ~= root then
            if movementTrailInstance then movementTrailInstance:Destroy() end
            if trailAttachment0 then trailAttachment0:Destroy() end
            if trailAttachment1 then trailAttachment1:Destroy() end
            
            trailAttachment0 = Instance.new("Attachment", root)
            trailAttachment0.Position = Vector3.new(0, -2, 0)
            trailAttachment1 = Instance.new("Attachment", root)
            trailAttachment1.Position = Vector3.new(0, 2, 0)
            
            movementTrailInstance = Instance.new("Trail")
            movementTrailInstance.Attachment0 = trailAttachment0
            movementTrailInstance.Attachment1 = trailAttachment1
            movementTrailInstance.Lifetime = 3.0 -- Ровно 3 секунды затухания
            movementTrailInstance.MinLength = 0.1
            movementTrailInstance.WidthScale = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.5),
                NumberSequenceKeypoint.new(1, 0)
            })
            movementTrailInstance.Parent = root
        end
        
        -- Радужный цвет трейла
        local hue = (tick() % 5) / 5
        movementTrailInstance.Color = ColorSequence.new(Color3.fromHSV(hue, 1, 1))
    else
        if movementTrailInstance then
            movementTrailInstance:Destroy()
            movementTrailInstance = nil
        end
        if trailAttachment0 then trailAttachment0:Destroy() end
        if trailAttachment1 then trailAttachment1:Destroy() end
    end
end

local ESPCache = {}

local function ClearESP(model)
    if ESPCache[model] then
        for _, object in pairs(ESPCache[model]) do
            object:Destroy()
        end
        ESPCache[model] = nil
    end
end

local function CreateAdornment(part, color)
    local box = Instance.new("BoxHandleAdornment")
    box.Size = part.Size
    box.Color3 = color
    box.Transparency = 0.5
    box.AlwaysOnTop = true
    box.ZIndex = 10
    box.Adornee = part
    box.Parent = part
    return box
end

local function UpdateESP()
    if not Config.ESP.Enabled then
        for model in pairs(ESPCache) do
            ClearESP(model)
        end
        return
    end

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj ~= LocalPlayer.Character and obj.Name ~= "ClientViewmodel" then
            local parts = GetCharacterParts(obj)

            if parts and (parts.Root or parts.HeadHitbox) then
                if not ESPCache[obj] then
                    ESPCache[obj] = {}

                    local highlight = Instance.new("Highlight")
                    highlight.Adornee = obj
                    highlight.FillColor = Config.ESP.BoxColor
                    highlight.FillTransparency = 0.6
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = obj
                    table.insert(ESPCache[obj], highlight)

                    if Config.ESP.HighlightHitboxes then
                        if parts.HeadHitbox then
                            table.insert(ESPCache[obj], CreateAdornment(parts.HeadHitbox, Config.ESP.HeadColor))
                        end
                        if parts.BodyHitbox then
                            table.insert(ESPCache[obj], CreateAdornment(parts.BodyHitbox, Config.ESP.BodyColor))
                        end
                    end
                end
            else
                ClearESP(obj)
            end
        end
    end
end

local function TriggerShoot()
    pcall(function()
        local character = LocalPlayer.Character
        if character then
            local tool = character:FindFirstChildOfClass("Tool")
            if tool then
                if typeof(tool.Activate) == "function" then
                    tool:Activate()
                end
                local fireEvent = tool:FindFirstChild("Fire") or tool:FindFirstChild("Shoot")
                if fireEvent and fireEvent:IsA("RemoteEvent") then
                    fireEvent:FireServer()
                end
            end
        end
    end)
end

