-- Функция назначения иконок и цветов для классов в стиле Studio
local function getClassStyle(className)
    if className == "Workspace" then return "🌍", Color3.fromRGB(80, 160, 255)
    elseif className == "Players" then return "👥", Color3.fromRGB(90, 200, 120)
    elseif className == "Lighting" then return "💡", Color3.fromRGB(240, 220, 80)
    elseif className == "ReplicatedStorage" then return "📦", Color3.fromRGB(230, 150, 50)
    elseif className == "ReplicatedFirst" then return "⚡", Color3.fromRGB(120, 180, 255)
    elseif className == "ServerScriptService" or className == "ServerStorage" then return "🔒", Color3.fromRGB(70, 180, 110)
    elseif className == "StarterGui" or className == "StarterPack" or className == "StarterPlayer" then return "📁", Color3.fromRGB(220, 190, 80)
    elseif className == "Folder" then return "📁", Color3.fromRGB(200, 170, 70)
    elseif className == "Model" then return "📦", Color3.fromRGB(220, 140, 60)
    elseif className == "Part" or className == "MeshPart" or className == "UnionOperation" then return "🧊", Color3.fromRGB(160, 160, 180)
    elseif className == "LocalScript" or className == "ModuleScript" or className == "Script" then return "📜", Color3.fromRGB(255, 120, 120)
    elseif className == "RemoteEvent" or className == "RemoteFunction" then return "🔥", Color3.fromRGB(255, 90, 90)
    elseif className:find("Value") then return "📊", Color3.fromRGB(100, 220, 220)
    else return "🔹", Color3.fromRGB(170, 170, 190)
    end
end

-- Рекурсивное создание дерева с разворачиванием по [+]
local function createTreeNode(obj, parentContainer, depth)
    local success, children = pcall(function() return obj:GetChildren() end)
    if not success then return end

    local hasChildren = children and #children > 0
    local icon, color = getClassStyle(obj.ClassName)

    local itemFrame = Instance.new("Frame")
    itemFrame.Size = UDim2.new(1, 0, 0, 22)
    itemFrame.BackgroundTransparency = 1
    itemFrame.Parent = parentContainer

    local indent = math.min(depth * 12, 140)

    -- Кнопка разворачивания [+] / [-]
    local expandBtn = nil
    if hasChildren then
        expandBtn = Instance.new("TextButton")
        expandBtn.Size = UDim2.new(0, 16, 0, 16)
        expandBtn.Position = UDim2.new(0, indent, 0.5, -8)
        expandBtn.BackgroundColor3 = Color3.fromRGB(35, 40, 60)
        expandBtn.Font = Enum.Font.GothamBold
        expandBtn.Text = "+"
        expandBtn.TextColor3 = Color3.fromRGB(200, 200, 220)
        expandBtn.TextSize = 9
        expandBtn.Parent = itemFrame

        local ec = Instance.new("UICorner")
        ec.CornerRadius = UDim.new(0, 3)
        ec.Parent = expandBtn
    end

    local labelX = indent + (hasChildren and 20 or 0)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -labelX - 30, 1, 0)
    label.Position = UDim2.new(0, labelX, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    label.Text = icon .. " " .. obj.Name
    label.TextColor3 = color
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = itemFrame

    -- Кнопка просмотра содержимого скрипта или значения данных [⚙]
    local isScript = obj:IsA("LocalScript") or obj:IsA("ModuleScript") or obj:IsA("Script")
    local isDataVal = obj:IsA("ValueBase") or obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")

    if isScript or isDataVal then
        local viewBtn = Instance.new("TextButton")
        viewBtn.Size = UDim2.new(0, 20, 0, 18)
        viewBtn.Position = UDim2.new(1, -22, 0.5, -9)
        viewBtn.BackgroundColor3 = Color3.fromRGB(50, 40, 90)
        viewBtn.Font = Enum.Font.GothamBold
        viewBtn.Text = "⚙"
        viewBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        viewBtn.TextSize = 10
        viewBtn.Parent = itemFrame

        local vc = Instance.new("UICorner")
        vc.CornerRadius = UDim.new(0, 3)
        vc.Parent = viewBtn

        viewBtn.MouseButton1Click:Connect(function()
            currentLoadedName = obj.Name
            if isScript then
                if currentMode == "Safe" then
                    local successDecomp, decompResult = pcall(function()
                        return decompile and decompile(obj) or "-- Декомпилятор недоступен в Safe моде"
                    end)
                    currentLoadedContent = successDecomp and decompResult or "-- Ошибка декомпиляции"
                else
                    local successDecomp, decompResult = pcall(function()
                        return decompile and decompile(obj) or "-- Ошибка чтения"
                    end)
                    local aggInfo = "-- [AGGRESSIVE MODE PARSER]\n-- Источник: " .. obj:GetFullName() .. "\n\n"
                    if successDecomp and decompResult and #decompResult > 10 then
                        aggInfo = aggInfo .. decompResult
                    else
                        aggInfo = aggInfo .. "-- [Lite Spy] Эмуляция цепочки вызовов:\n"
                        if obj:IsA("RemoteEvent") then
                            aggInfo = aggInfo .. "game:GetService(\"" .. obj.Parent.Name .. "\")." .. obj.Name .. ":FireServer()\n"
                        elseif obj:IsA("RemoteFunction") then
                            aggInfo = aggInfo .. "game:GetService(\"" .. obj.Parent.Name .. "\")." .. obj.Name .. ":InvokeServer()\n"
                        else
                            aggInfo = aggInfo .. "-- Нет активных сетевых триггеров."
                        end
                    end
                    currentLoadedContent = aggInfo
                end
            elseif obj:IsA("ValueBase") then
                currentLoadedContent = "-- Значение " .. obj.Name .. " [" .. obj.ClassName .. "]:\nValue = " .. tostring(obj.Value)
            else
                currentLoadedContent = "-- Данные объекта: " .. obj.Name .. " [" .. obj.ClassName .. "]"
            end

            SVTitle.Text = "Объект: " .. obj.Name
            SVTextBox.Text = currentLoadedContent
            ScriptViewerFrame.Visible = true
        end)
    end

    -- Логика раскрытия подпапок по клику на [+]
    if hasChildren then
        local isExpanded = false
        local childContainer = Instance.new("Frame")
        childContainer.Size = UDim2.new(1, 0, 0, 0)
        childContainer.AutomaticSize = Enum.AutomaticSize.Y
        childContainer.BackgroundTransparency = 1
        childContainer.Visible = false
        childContainer.Parent = parentContainer

        local cLayout = Instance.new("UIListLayout")
        cLayout.SortOrder = Enum.SortOrder.LayoutOrder
        cLayout.Padding = UDim.new(0, 2)
        cLayout.Parent = childContainer

        expandBtn.MouseButton1Click:Connect(function()
            isExpanded = not isExpanded
            childContainer.Visible = isExpanded
            expandBtn.Text = isExpanded and "-" : "+"
            if isExpanded and #childContainer:GetChildren() <= 1 then
                for _, subChild in ipairs(children) do
                    createTreeNode(subChild, childContainer, depth + 1)
                end
            end
        end)
    end
end

-- Кнопка: Сохранить весь мир в TXT
createButton("📦 Полный эксплор в TXT", Color3.fromRGB(60, 45, 120), 2, function()
    task.spawn(function()
        local txtLines = {}
        table.insert(txtLines, "=== MOBILE DEV-EX FULL REPORT (PLACE ID: " .. tostring(game.PlaceId) .. ") ===")
        table.insert(txtLines, "Режим сканирования: " .. currentMode)
        table.insert(txtLines, "Дата: " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n")

        local function deepDump(obj, depth)
            local success, children = pcall(function() return obj:GetChildren() end)
            if not success or not children then return end
            for _, c in ipairs(children) do
                local line = string.rep("  ", math.min(depth, 6)) .. "- [" .. c.ClassName .. "] " .. c.Name
                if c:IsA("ValueBase") then
                    line = line .. " (Value: " .. tostring(c.Value) .. ")"
                end
                table.insert(txtLines, line)
                if #txtLines < 1200 then
                    deepDump(c, depth + 1)
                end
            end
        end

        local services = {
            game:GetService("Workspace"),
            game:GetService("Players"),
            game:GetService("CoreGui"),
            game:GetService("Lighting"),
            game:GetService("ReplicatedStorage"),
            game:GetService("ReplicatedFirst"),
            game:GetService("StarterGui"),
            game:GetService("StarterPack"),
            game:GetService("StarterPlayer"),
            game:GetService("SoundService"),
            game:GetService("TextChatService")
        }

        for _, s in ipairs(services) do
            table.insert(txtLines, "\n--- Сервис: " .. s.Name .. " ---")
            deepDump(s, 1)
        end

        local report = table.concat(txtLines, "\n")
        local fileName = "DevExReport_" .. tostring(game.PlaceId) .. ".txt"
        if writefile then
            pcall(function()
                writefile(fileName, report)
                Title.Text = "Сохранено: " .. fileName
                task.wait(3)
                Title.Text = "Mobile DevEx Explorer v2.0"
            end)
        end
    end)
end)

