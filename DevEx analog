-- Стили классов
local function getClassStyle(className)
    if className == "Workspace" then return "🌍", Color3.fromRGB(80, 160, 255)
    elseif className == "Players" then return "👥", Color3.fromRGB(90, 200, 120)
    elseif className == "Lighting" then return "💡", Color3.fromRGB(240, 220, 80)
    elseif className == "ReplicatedStorage" then return "📦", Color3.fromRGB(230, 150, 50)
    elseif className == "ReplicatedFirst" then return "⚡", Color3.fromRGB(120, 180, 255)
    elseif className == "ServerScriptService" or className == "ServerStorage" then return "🔒", Color3.fromRGB(70, 180, 110)
    elseif className == "StarterGui" or className == "StarterPack" or className == "StarterPlayer" then return "📁", Color3.fromRGB(220, 190, 80)
    elseif className == "Folder" then return "📁", Color3.fromRGB(200, 170, 70)
    elseif className == "Model" then return "📦", Color3.fromRGB(220, 140, 60)
    elseif className == "Part" or className == "MeshPart" or className == "UnionOperation" then return "🧊", Color3.fromRGB(160, 160, 180)
    elseif className == "LocalScript" or className == "ModuleScript" or className == "Script" then return "📜", Color3.fromRGB(255, 120, 120)
    elseif className == "RemoteEvent" or className == "RemoteFunction" then return "🔥", Color3.fromRGB(255, 90, 90)
    elseif className:find("Value") then return "📊", Color3.fromRGB(100, 220, 220)
    else return "🔹", Color3.fromRGB(170, 170, 190)
    end
end

-- ================= НОВАЯ ФУНКЦИЯ ЭКСПОРТА ОДНОГО ОБЪЕКТА =================
local function exportSingleObject(rootObj)
    if not writefile then
        warn("writefile не доступен!")
        return
    end

    local lines = {}
    local exportName = rootObj.Name .. "_" .. os.date("%Y%m%d_%H%M%S")

    -- Заголовок отчета
    table.insert(lines, "=== ОТЧЕТ ПО ОБЪЕКТУ: " .. rootObj:GetFullName() .. " ===")
    table.insert(lines, "Класс: " .. rootObj.ClassName)
    table.insert(lines, "Дата экспорта: " .. os.date("%Y-%m-%d %H:%M:%S"))
    table.insert(lines, "Режим: " .. currentMode)
    table.insert(lines, string.rep("=", 50) .. "\n")

    -- Рекурсивный обход
    local function deepDump(obj, depth)
        local prefix = string.rep("  ", depth)
        local line = prefix .. "📂 [" .. obj.ClassName .. "] " .. obj.Name

        -- Добавляем информацию о значении для ValueBase
        if obj:IsA("ValueBase") then
            local val = pcall(function() return obj.Value end) and tostring(obj.Value) or "<Ошибка чтения>"
            line = line .. " = " .. val
        end

        table.insert(lines, line)

        -- Если это скрипт и включена опция
        if exportSettings.IncludeScriptsCode and (obj:IsA("LocalScript") or obj:IsA("ModuleScript") or obj:IsA("Script")) then
            table.insert(lines, prefix .. "  📜 КОД СКРИПТА:")
            local code = "-- Декомпиляция не удалась"
            if currentMode == "Safe" then
                local success, res = pcall(function() return decompile and decompile(obj) or "-- Декомпилятор недоступен" end)
                code = success and res or "-- Ошибка чтения"
            else
                local success, res = pcall(function() return decompile and decompile(obj) or "-- Ошибка" end)
                if success and res and #res > 10 then
                    code = res
                else
                    code = "-- [Эмуляция] " .. obj.ClassName .. " (" .. obj:GetFullName() .. ")"
                end
            end
            for scriptLine in (code or ""):gmatch("[^\r\n]+") do
                table.insert(lines, prefix .. "    " .. scriptLine)
            end
            table.insert(lines, prefix .. "  " .. string.rep("-", 30))
        end

        -- Обходим дочерние объекты, если не превышен лимит и они есть
        if depth < 8 then -- Ограничиваем глубину для безопасности
            local success, children = pcall(function() return obj:GetChildren() end)
            if success and children then
                for _, child in ipairs(children) do
                    deepDump(child, depth + 1)
                end
            end
        end
    end

    deepDump(rootObj, 0)

    -- Сохраняем файл
    local fileName = "DevEx_Single_" .. exportName .. ".txt"
    local content = table.concat(lines, "\n")
    
    pcall(function()
        writefile(fileName, content)
        return fileName
    end)
end
