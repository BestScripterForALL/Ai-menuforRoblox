-- Функция рекурсивного заполнения Explorer с поддержкой плюсиков [+] для скриптов/данных
local function buildExplorerTree(parentObj, container, depth)
    local success, children = pcall(function() return parentObj:GetChildren() end)
    if not success or not children then return end

    for _, child in ipairs(children) do
        local itemFrame = Instance.new("Frame")
        itemFrame.Size = UDim2.new(1, 0, 0, 22)
        itemFrame.BackgroundTransparency = 1
        itemFrame.Parent = container

        local indent = math.min(depth * 10, 120)
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -indent - 25, 1, 0)
        label.Position = UDim2.new(0, indent, 0, 0)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.Gotham
        label.Text = child.Name .. " [" .. child.ClassName .. "]"
        label.TextColor3 = Color3.fromRGB(190, 190, 210)
        label.TextSize = 10
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = itemFrame

        -- Проверка: если это скрипт или объект с ценными данными (IntValue, StringValue и т.д.)
        local isScript = child:IsA("LocalScript") or child:IsA("ModuleScript") or child:IsA("Script")
        local isDataVal = child:IsA("ValueBase") or child:IsA("RemoteEvent") or child:IsA("RemoteFunction")

        if isScript or isDataVal then
            local plusBtn = Instance.new("TextButton")
            plusBtn.Size = UDim2.new(0, 20, 0, 18)
            plusBtn.Position = UDim2.new(1, -22, 0.5, -9)
            plusBtn.BackgroundColor3 = Color3.fromRGB(40, 50, 80)
            plusBtn.Font = Enum.Font.GothamBold
            plusBtn.Text = "+"
            plusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            plusBtn.TextSize = 10
            plusBtn.Parent = itemFrame

            local pc = Instance.new("UICorner")
            pc.CornerRadius = UDim.new(0, 3)
            pc.Parent = plusBtn

            plusBtn.MouseButton1Click:Connect(function()
                currentLoadedName = child.Name
                if isScript then
                    if currentMode == "Safe" then
                        local successDecomp, decompResult = pcall(function()
                            return decompile and decompile(child) or "-- Декомпилятор недоступен в Safe моде"
                        end)
                        currentLoadedContent = successDecomp and decompResult or "-- Ошибка декомпиляции"
                    else
                        -- Aggressive Mode: Попытка прочитать обычным способом + Lite Spy генерация по вызовам
                        local successDecomp, decompResult = pcall(function()
                            return decompile and decompile(child) or "-- Ошибка чтения"
                        end)
                        
                        local aggInfo = "-- [AGGRESSIVE MODE PARSER]\n-- Источник: " .. child:GetFullName() .. "\n\n"
                        if successDecomp and decompResult and #decompResult > 10 then
                            aggInfo = aggInfo .. decompResult
                        else
                            aggInfo = aggInfo .. "-- [Lite Spy] Скрипт зашифрован или пуст. Эмуляция цепочки вызовов:\n"
                            if child:IsA("RemoteEvent") then
                                aggInfo = aggInfo .. "game:GetService(\"" .. child.Parent.Name .. "\")." .. child.Name .. ":FireServer()\n"
                            elseif child:IsA("RemoteFunction") then
                                aggInfo = aggInfo .. "game:GetService(\"" .. child.Parent.Name .. "\")." .. child.Name .. ":InvokeServer()\n"
                            else
                                aggInfo = aggInfo .. "-- Нет активных сетевых триггеров для этого типа объекта."
                            end
                        end
                        currentLoadedContent = aggInfo
                    end
                elseif child:IsA("ValueBase") then
                    currentLoadedContent = "-- Значение объекта " .. child.Name .. " [" .. child.ClassName .. "]:\nValue = " .. tostring(child.Value)
                else
                    currentLoadedContent = "-- Данные объекта: " .. child.Name .. " [" .. child.ClassName .. "]"
                end

                SVTitle.Text = "Объект: " .. child.Name
                SVTextBox.Text = currentLoadedContent
                ScriptViewerFrame.Visible = true
            end)
        end

        buildExplorerTree(child, container, depth + 1)
    end
end

-- Кнопка 1: Пропарсить всё и сохранить в TXT с PlaceId
createButton("📦 Полный эксплор в TXT", Color3.fromRGB(60, 45, 120), 2, function()
    task.spawn(function()
        local txtLines = {}
        table.insert(txtLines, "=== MOBILE DEV-EX FULL REPORT (PLACE ID: " .. tostring(game.PlaceId) .. ") ===")
        table.insert(txtLines, "Режим сканирования: " .. currentMode)
        table.insert(txtLines, "Дата: " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n")

        local function deepDump(obj, depth)
            local success, children = pcall(function() return obj:GetChildren() end)
            if not success or not children then return end
            for _, c in ipairs(children) do
                local line = string.rep("  ", math.min(depth, 6)) .. "- [" .. c.ClassName .. "] " .. c.Name
                if c:IsA("ValueBase") then
                    line = line .. " (Value: " .. tostring(c.Value) .. ")"
                end
                table.insert(txtLines, line)
                if #txtLines < 1200 then
                    deepDump(c, depth + 1)
                end
            end
        end

        local services = {
            game:GetService("Workspace"),
            game:GetService("ReplicatedStorage"),
            game:GetService("ReplicatedFirst"),
            game:GetService("StarterGui"),
            game:GetService("Players"),
            game:GetService("Lighting")
        }

        for _, s in ipairs(services) do
            table.insert(txtLines, "\n--- Сервис: " .. s.Name .. " ---")
            deepDump(s, 1)
        end

        local report = table.concat(txtLines, "\n")
        local fileName = "DevExReport_" .. tostring(game.PlaceId) .. ".txt"
        if writefile then
            pcall(function()
                writefile(fileName, report)
                Title.Text = "Сохранено: " .. fileName
                task.wait(3)
                Title.Text = "Mobile DevEx Explorer"
            end)
        end
    end)
end)

