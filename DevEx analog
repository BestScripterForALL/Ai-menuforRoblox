RunExportBtn.MouseButton1Click:Connect(function()
    task.spawn(function()
        local txtLines = {}
        table.insert(txtLines, "=== CUSTOM DEV-EX EXPORT REPORT ===")
        table.insert(txtLines, "Place ID: " .. tostring(game.PlaceId))
        table.insert(txtLines, "Дата: " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n")

        local function deepDump(obj, depth)
            local success, children = pcall(function() return obj:GetChildren() end)
            if not success or not children then return end
            for _, c in ipairs(children) do
                local line = string.rep("  ", math.min(depth, 6)) .. "- [" .. c.ClassName .. "] " .. c.Name
                if c:IsA("ValueBase") then
                    line = line .. " (Value: " .. tostring(c.Value) .. ")"
                end
                table.insert(txtLines, line)

                if exportSettings.IncludeScriptsCode and (c:IsA("LocalScript") or c:IsA("ModuleScript") or c:IsA("Script")) then                    local decompOK, decompRes = pcall(function() return decompile and decompile(c) or "-- нет декомпилятора" end)
                    table.insert(txtLines, string.rep("  ", math.min(depth + 1, 6)) .. "--- [СКОПИРОВАННЫЙ КОД СРИПТА] ---")
                    for scriptLine in (decompRes or ""):gmatch("[^\r\n]+") do
                        table.insert(txtLines, string.rep("  ", math.min(depth + 1, 6)) .. "  " .. scriptLine)
                    end
                    table.insert(txtLines, string.rep("  ", math.min(depth + 1, 6)) .. "---------------------------------")
                end

                if #txtLines < 2500 then
                    deepDump(c, depth + 1)
                end
            end
        end

        local serviceCandidates = {
            Workspace = game:GetService("Workspace"),
            Players = game:GetService("Players"),
            CoreGui = game:GetService("CoreGui"),
            Lighting = game:GetService("Lighting"),
            ReplicatedStorage = game:GetService("ReplicatedStorage"),
            ReplicatedFirst = game:GetService("ReplicatedFirst"),
            StarterGui = game:GetService("StarterGui"),
            StarterPack = game:GetService("StarterPack"),
            StarterPlayer = game:GetService("StarterPlayer")
        }

        for key, srv in pairs(serviceCandidates) do
            if exportSettings[key] then
                table.insert(txtLines, "\n--- Сервис: " .. srv.Name .. " ---")
                deepDump(srv, 1)
            end
        end

        local report = table.concat(txtLines, "\n")
        local fileName = "CustomDevExReport_" .. tostring(game.PlaceId) .. ".txt"
        if writefile then
            pcall(function()
                writefile(fileName, report)
                RunExportBtn.Text = "✅ Сохранено в " .. fileName
                task.wait(3)
                RunExportBtn.Text = "💾 Выгрузить выбранное в TXT"
            end)
        end
    end)
end)

