-- Функция добавления лога
local function LogAction(category, data)
    if not isRecording then return end
    local timestamp = os.date("%H:%M:%S")
    local entry = string.format("[%s] [%s] %s", timestamp, category, data)
    table.insert(capturedLogs, entry)
end

-- // Логика отслеживания локального игрока (Мувмент, Камера, Скрипты, Стрельба)

-- 1. Трекинг камеры
RunService.RenderStepped:Connect(function()
    if Filters.IgnoreCamera then return end
    local camCF = Camera.CFrame
    -- Логируем направление взгляда раз в несколько кадров или по сильному изменению
    -- Для базы сделаем фиксацию основных углов раз в секунду через поток ниже
end)

task.spawn(function()
    while true do
        task.reload or task.wait(1)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            if not Filters.IgnoreMovement then
                LogAction("MOVEMENT", string.format("Position: %.1f, %.1f, %.1f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z))
            end
            if not Filters.IgnoreCamera then
                local look = Camera.CFrame.LookVector
                LogAction("CAMERA", string.format("LookVector: %.2f, %.2f, %.2f", look.X, look.Y, look.Z))
            end
        end
    end
end)

-- 2. Отслеживание кликов / стрельбы / мыши
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if Filters.IgnoreMouse then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        LogAction("ACTION", "Screen Tap / Click / Shoot input detected")
    elseif input.UserInputType == Enum.UserInputType.Keyboard then
        LogAction("INPUT", "Key pressed: " .. tostring(input.KeyCode))
    end
end)

-- 3. Мониторинг используемых скриптов локального игрока (Backpack / PlayerScripts)
if LocalPlayer:FindFirstChild("PlayerScripts") then
    for _, scriptObj in ipairs(LocalPlayer.PlayerScripts:GetDescendants()) do
        if scriptObj:IsA("LocalScript") or scriptObj:IsA("ModuleScript") and not Filters.IgnoreScripts then
            LogAction("SCRIPTS", "Found Script/Module: " .. scriptObj:GetFullName())
        end
    end
end

-- // Функция экспорта в TXT файл (через writefile, если поддерживается эксплойтом)
ExportBtn.MouseButton1Click:Connect(function()
    local fileName = "Spy_" .. game.PlaceId .. ".txt"
    local fileContent = table.concat(capturedLogs, "\n")
    
    local success, err = pcall(function()
        if writefile then
            writefile(fileName, fileContent)
        end
    end)
    
    if success and writefile then
        ExportBtn.Text = "Сохранено!"
        task.wait(1.5)
        ExportBtn.Text = "Экспорт в TXT"
    else
        ExportBtn.Text = "Ошибка записи"
        task.wait(1.5)
        ExportBtn.Text = "Экспорт в TXT"
    end
end)

