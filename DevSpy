-- Логирование
local function LogData(category, info)
    if not isRecording then return end
    local time = os.date("%H:%M:%S")
    local entry = string.format("[%s] [%s] %s", time, category, info)
    table.insert(capturedLogs, entry)
    InfoLabel.Text = "Собрано данных: " .. #capturedLogs
end

-- // Реализация методов сканирования
task.spawn(function()
    Workspace.DescendantAdded:Connect(function(obj)
        if isRecording and currentMethod == "Workspace" then
            LogData("WORKSPACE", "Создан объект: " .. obj:GetFullName() .. " [" .. obj.ClassName .. "]")
        end
    end)
end)

-- Периодический сканер памяти, атрибутов и камеры
RunService.RenderStepped:Connect(function(dt)
    if not isRecording then return end

    if currentMethod == "CameraDebug" then
        local currentCFrame = Camera.CFrame
        local posDelta = (currentCFrame.Position - LastCameraCFrame.Position).Magnitude
        local rotDelta = 1 - math.clamp(currentCFrame.LookVector:Dot(LastCameraCFrame.LookVector), -1, 1)
        
        if posDelta >= PositionThreshold or rotDelta >= RotationThreshold then
            LogData("CAMERA_SPY", string.format("OUTGOING PACKET -> Pos: (%.2f, %.2f, %.2f) | Look: (%.2f, %.2f, %.2f)", 
                currentCFrame.Position.X, currentCFrame.Position.Y, currentCFrame.Position.Z,
                currentCFrame.LookVector.X, currentCFrame.LookVector.Y, currentCFrame.LookVector.Z
            ))
            LastCameraCFrame = currentCFrame
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(2)
        if isRecording then
            if currentMethod == "GC_Scan" and getgc then
                pcall(function()
                    for _, v in ipairs(getgc(true)) do
                        if type(v) == "table" then
                            if rawget(v, "Damage") or rawget(v, "Speed") or rawget(v, "Health") then
                                LogData("GC_SCAN", string.format("Найдена таблица параметров: Damage=%s, Speed=%s", tostring(v.Damage), tostring(v.Speed)))
                            end
                        end
                    end
                end)
            elseif currentMethod == "Attributes" then
                pcall(function()
                    if LocalPlayer.Character then
                        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                            for attr, val in pairs(part:GetAttributes()) do
                                LogData("ATTRIBUTE", string.format("Объект %s | Атрибут %s = %s", part.Name, attr, tostring(val)))
                            end
                        end
                    end
                end)
            end
        end
    end
end)

