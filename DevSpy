ExportBtn.MouseButton1Click:Connect(function()
    local filename = "LiteSpy_" .. tostring(game.PlaceId) .. ".txt"
    local content = table.concat(capturedLogs, "\n")
    
    local writeOK = false
    pcall(function()
        if writefile then
            writefile(filename, content)
            writeOK = true
        end
    end)

    if writeOK then
        ExportBtn.Text = "Сохранено в " .. filename
    else
        ExportBtn.Text = "Ошибка: writefile не поддерживается"
    end
    
    task.wait(2)
    ExportBtn.Text = "Сохранить в TXT"
end)
