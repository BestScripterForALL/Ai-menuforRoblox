    local UIList = Instance.new("UIListLayout")
    UIList.HorizontalAlignment = Enum.HorizontalAlignment.Center
    UIList.SortOrder = Enum.SortOrder.LayoutOrder
    UIList.Padding = UDim.new(0, 6)
    UIList.Parent = ScrollingFrame

    UIList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, UIList.AbsoluteContentSize.Y + 10)
    end)

    TabButton.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.Frame.Visible = false
            t.Button.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
            t.Button.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        ScrollingFrame.Visible = true
        TabButton.BackgroundColor3 = Color3.fromRGB(0, 255, 128)
        TabButton.TextColor3 = Color3.fromRGB(15, 15, 20)
    end)

    if not currentTab then
        ScrollingFrame.Visible = true
        TabButton.BackgroundColor3 = Color3.fromRGB(0, 255, 128)
        TabButton.TextColor3 = Color3.fromRGB(15, 15, 20)
        currentTab = ScrollingFrame
    end

    table.insert(tabs, {Button = TabButton, Frame = ScrollingFrame})
    return ScrollingFrame
end

