-- Система профилей
local function GetProfilePath(name)
    return "Tornado_Profile_v5_" .. name .. ".json"
end

local function SaveProfileToFile(name)
    if not writefile then return false end
    local profile = {
        TornadoConfig = getgenv().TornadoConfig,
        Stats = getgenv().Stats,
        SavedAt = os.time()
    }
    local json = game:GetService("HttpService"):JSONEncode(profile)
    pcall(function() writefile(GetProfilePath(name), json) end)
    return true
end

local function LoadProfileFromFile(name)
    if not readfile then return false end
    local success, data = pcall(function() return readfile(GetProfilePath(name)) end)
    if not success or not data then return false end
    local profile = game:GetService("HttpService"):JSONDecode(data)
    if profile and profile.TornadoConfig then
        for k,v in pairs(profile.TornadoConfig) do 
            if getgenv().TornadoConfig[k] then
                for subK, subV in pairs(v) do
                    getgenv().TornadoConfig[k][subK] = subV
                end
            end
        end
        if profile.Stats then
            getgenv().Stats.Kills = profile.Stats.Kills or 0
            getgenv().Stats.Hits = profile.Stats.Hits or 0
            getgenv().Stats.Shots = profile.Stats.Shots or 0
        end
        return true
    end
    return false
end

