-- ================= 3. ФУНКЦИОНАЛ АИМБОТА И ЦЕЛЕЙ =================

local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1
FOVCircle.NumSides = 64
FOVCircle.Filled = false
FOVCircle.Transparency = 0.7
FOVCircle.Color = Color3.fromRGB(0, 255, 128)

local espCache = {}
local activeMultipoints = {}

local function createESP(player)
    if espCache[player] then return end
    local cache = {
        Box = Drawing.new("Square"),
        Tracer = Drawing.new("Line"),
        Highlight = Instance.new("Highlight")
    }
    cache.Box.Thickness = 1
    cache.Box.Filled = false
    cache.Box.Color = Color3.fromRGB(0, 255, 128)
    cache.Tracer.Thickness = 1
    cache.Tracer.Color = Color3.fromRGB(0, 255, 128)
    cache.Highlight.FillTransparency = 0.5
    cache.Highlight.OutlineTransparency = 0
    cache.Highlight.Parent = nil
    espCache[player] = cache
end

local function removeESP(player)
    if espCache[player] then
        espCache[player].Box:Remove()
        espCache[player].Tracer:Remove()
        espCache[player].Highlight:Destroy()
        espCache[player] = nil
    end
end

Players.PlayerRemoving:Connect(removeESP)

local function clearMultipoints(player)
    if activeMultipoints[player] then
        for _, part in ipairs(activeMultipoints[player]) do
            if part then part:Destroy() end
        end
        activeMultipoints[player] = nil
    end
end

local function getTargetPoints(char, mode)
    local config = mode == "Legit" and getgenv().TornadoConfig.Legit or getgenv().TornadoConfig.Rage
    local points = {}
    local velocity = char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Velocity or Vector3.new(0,0,0)
    local predTime = config.Prediction / 1000
    local predictionOffset = velocity * predTime

    local hitboxName = config.Hitbox or "Head"
    local mainPart = char:FindFirstChild(hitboxName) or char:FindFirstChild("Head")
    if mainPart then
        table.insert(points, mainPart.Position + predictionOffset)
    end

    if mode == "Rage" and getgenv().TornadoConfig.Rage.Multipoints then
        for partName, enabled in pairs(getgenv().TornadoConfig.Rage.MultipointParts) do
            if enabled then
                local part = char:FindFirstChild(partName)
                if part then
                    local basePos = part.Position + predictionOffset
                    local sizeMult = getgenv().TornadoConfig.Rage.MultipointSize
                    table.insert(points, basePos + Vector3.new(part.Size.X/2 * sizeMult, 0, 0))
                    table.insert(points, basePos + Vector3.new(-part.Size.X/2 * sizeMult, 0, 0))
                    table.insert(points, basePos + Vector3.new(0, part.Size.Y/2 * sizeMult, 0))
                    table.insert(points, basePos + Vector3.new(0, -part.Size.Y/2 * sizeMult, 0))
                end
            end
        end
    end

    return points
end

local function getClosestTarget(mode)
    local config = mode == "Legit" and getgenv().TornadoConfig.Legit or getgenv().TornadoConfig.Rage
    if not config.Enabled then return nil end

    local fovDeg = mode == "Legit" and config.FOV or 180
    local fovRad = math.rad(fovDeg)
    local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local bestDist = math.huge
    local bestPos = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local primaryPart = char:FindFirstChild("HumanoidRootPart")
                    if primaryPart and isVisibleAdvanced(primaryPart, char, 3) then
                        local points = getTargetPoints(char, mode)
                        for _, pos in ipairs(points) do
                            local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
                            if onScreen then
                                local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                                local angle = math.atan(dist / Camera.FieldOfView)
                                if angle < fovRad and dist < bestDist then
                                    bestDist = dist
                                    bestPos = pos
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPos
end

-- ================= ГЛАВНЫЙ ЦИКЛ =================
RunService.RenderStepped:Connect(function()
    local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    -- Отрисовка FOV для Legit
    if getgenv().TornadoConfig.Legit.DrawFOV and getgenv().TornadoConfig.Legit.Enabled then
        FOVCircle.Visible = true
        FOVCircle.Position = screenCenter
        local fovRad = math.rad(getgenv().TornadoConfig.Legit.FOV)
        local radius = Camera.ViewportSize.Y / 2 * math.tan(fovRad) / math.tan(math.rad(Camera.FieldOfView / 2))
        FOVCircle.Radius = radius
    else
        FOVCircle.Visible = false
    end

    -- Логика Аимбота (Legit / Rage)
    if getgenv().TornadoConfig.Rage.Enabled then
        local target = getClosestTarget("Rage")
        if target then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target)
        end
    elseif getgenv().TornadoConfig.Legit.Enabled then
        local target = getClosestTarget("Legit")
        if target then
            local screenTarget = Camera:WorldToViewportPoint(target)
            local smooth = math.max(getgenv().TornadoConfig.Legit.Smooth, 1)
            local deltaX = (screenTarget.X - screenCenter.X) / smooth
            local deltaY = (screenTarget.Y - screenCenter.Y) / smooth
            Camera.CFrame = Camera.CFrame * CFrame.Angles(-math.rad(deltaY / 10), -math.rad(deltaX / 10), 0)
        end
    end

    -- Логика Player
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if getgenv().TornadoConfig.Player.SpeedHack then
                humanoid.WalkSpeed = getgenv().TornadoConfig.Player.Speed
            elseif humanoid.WalkSpeed ~= 16 and not getgenv().TornadoConfig.Player.SpeedHack then
                humanoid.WalkSpeed = 16
            end

            if getgenv().TornadoConfig.Player.JumpHack then
                humanoid.JumpPower = getgenv().TornadoConfig.Player.JumpPower
            elseif humanoid.JumpPower ~= 50 and not getgenv().TornadoConfig.Player.JumpHack then
                humanoid.JumpPower = 50
            end

            if getgenv().TornadoConfig.Player.BHop then
                if humanoid:GetState() == Enum.HumanoidStateType.Jumping and humanoid.FloorMaterial ~= Enum.Material.Air then
                    humanoid.Jump = true
                end
            end

            if getgenv().TornadoConfig.Player.AutoStrafer then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local velocity = rootPart.Velocity
                    if velocity.Magnitude > 5 then
                        local right = Camera.CFrame.RightVector
                        local dir = Vector3.new(right.X, 0, right.Z).Unit
                        rootPart.Velocity = Vector3.new(dir.X * velocity.Magnitude, velocity.Y, dir.Z * velocity.Magnitude)
                    end
                end
            end

            if getgenv().TornadoConfig.Player.DoubleJump then
                if not getgenv()._doubleJump then getgenv()._doubleJump = 0 end
                if humanoid:GetState() == Enum.HumanoidStateType.Jumping and getgenv()._doubleJump == 1 then
                    humanoid.Jump = true
                    getgenv()._doubleJump = 2
                elseif humanoid:GetState() == Enum.HumanoidStateType.Freefall and getgenv()._doubleJump == 0 then
                    getgenv()._doubleJump = 1
                elseif humanoid:GetState() == Enum.HumanoidStateType.Landed then
                    getgenv()._doubleJump = 0
                end
            end
        end
    end

    -- Отслеживание попаданий и убийств
    if not getgenv()._lastHealth then getgenv()._lastHealth = {} end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") then
            local humanoid = player.Character.Humanoid
            local health = humanoid.Health
            local prev = getgenv()._lastHealth[player] or health
            if health < prev and health > 0 then
                getgenv().Stats.Hits = getgenv().Stats.Hits + 1
                ShowNotification("🎯 Попадание! (" .. player.Name .. ")", Color3.fromRGB(255, 200, 0))
                if health <= 0 then
                    getgenv().Stats.Kills = getgenv().Stats.Kills + 1
                    ShowNotification("💀 Убийство! (" .. player.Name .. ")", Color3.fromRGB(255, 50, 50))
                end
            end
            getgenv()._lastHealth[player] = health
        end
    end

    -- Рендеринг ESP и мультипоинтов (для Rage)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                createESP(player)
                local cache = espCache[player]
                local rootPart = char.HumanoidRootPart
                local head = char:FindFirstChild("Head") or rootPart
                
                if getgenv().TornadoConfig.Rage.Enabled and getgenv().TornadoConfig.Rage.Multipoints and getgenv().TornadoConfig.Rage.MultipointVisuals then
                    if not activeMultipoints[player] then
                        activeMultipoints[player] = {}
                        for i = 1, 5 do
                            local p = Instance.new("Part")
                            p.Size = Vector3.new(1, 1, 1) * getgenv().TornadoConfig.Rage.MultipointSize
                            p.Shape = Enum.PartType.Ball
                            p.Color = Color3.fromRGB(0, 255, 128)
                            p.Anchored = true
                            p.CanCollide = false
                            p.Transparency = 0.3
                            p.Parent = workspace
                            table.insert(activeMultipoints[player], p)
                        end
                    end
                    
                    local pts = activeMultipoints[player]
                    local size = getgenv().TornadoConfig.Rage.MultipointSize
                    local velocity = rootPart.Velocity * (getgenv().TornadoConfig.Rage.Prediction / 1000)
                    local headPosPred = head.Position + velocity
                    
                    if pts[1] then pts[1].Size = Vector3.new(size,size,size) pts[1].Position = headPosPred end
                    if pts[2] then pts[2].Size = Vector3.new(size,size,size) pts[2].Position = headPosPred + Vector3.new(head.Size.X/2, 0, 0) end
                    if pts[3] then pts[3].Size = Vector3.new(size,size,size) pts[3].Position = headPosPred + Vector3.new(-head.Size.X/2, 0, 0) end
                    if pts[4] then pts[4].Size = Vector3.new(size,size,size) pts[4].Position = headPosPred + Vector3.new(0, head.Size.Y/2, 0) end
                    if pts[5] then pts[5].Size = Vector3.new(size,size,size) pts[5].Position = headPosPred + Vector3.new(0, -head.Size.Y/2, 0) end
                else
                    clearMultipoints(player)
                end

                if getgenv().TornadoConfig.Visuals.Chams then
                    cache.Highlight.Parent = char
                    cache.Highlight.FillColor = isVisibleAdvanced(head, char, 3) and Color3.fromRGB(0, 255, 128) or Color3.fromRGB(255, 50, 50)
                else
                    cache.Highlight.Parent = nil
                end
                
                local rootPos, rootOnScreen = Camera:WorldToViewportPoint(rootPart.Position)
                if rootOnScreen then
                    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                    local legPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height / 2
                    
                    if getgenv().TornadoConfig.Visuals.Box then
                        cache.Box.Visible = true
                        cache.Box.Size = Vector2.new(width, height)
                        cache.Box.Position = Vector2.new(rootPos.X - width / 2, rootPos.Y - height / 2)
                    else
                        cache.Box.Visible = false
                    end
                    
                    if getgenv().TornadoConfig.Visuals.Tracer then
                        cache.Tracer.Visible = true
                        cache.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        cache.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
                    else
                        cache.Tracer.Visible = false
                    end
                else
                    cache.Box.Visible = false
                    cache.Tracer.Visible = false
                end
            else
                removeESP(player)
                clearMultipoints(player)
            end
        end
    end

    -- Обновление статистики в UI
    local kills = getgenv().Stats.Kills
    local hits = getgenv().Stats.Hits
    local shots = getgenv().Stats.Shots
    local accuracy = shots > 0 and math.floor((hits / shots) * 100) or 0
    local elapsed = os.time() - getgenv().Stats.StartTime
    local minutes = math.floor(elapsed / 60)
    
    killsLabel.Text = "Убийств: " .. kills
    hitsLabel.Text = "Попаданий: " .. hits
    accuracyLabel.Text = "Точность: " .. accuracy .. "%"
    timeLabel.Text = "Время работы: " .. minutes .. " мин"
end)

