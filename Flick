local function ShowNotification(text, color, duration)
    if not getgenv().TornadoConfig.Misc.Notifications then return end
    duration = duration or 2
    local notif = Instance.new("TextLabel")
    notif.Size = UDim2.new(0, 350, 0, 40)
    notif.Position = UDim2.new(0.5, -175, 0.85, 0)
    notif.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    notif.BackgroundTransparency = 0.3
    notif.Text = text
    notif.TextColor3 = color or Color3.fromRGB(0, 255, 128)
    notif.Font = Enum.Font.GothamBold
    notif.TextSize = 14
    notif.TextStrokeTransparency = 0.5
    notif.ZIndex = 100
    notif.Parent = ScreenGui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = notif
    notif.BackgroundTransparency = 1
    notif.TextTransparency = 1
    for i = 1, 10 do
        notif.BackgroundTransparency = 0.3 - (i / 10) * 0.2
        notif.TextTransparency = 1 - (i / 10)
        task.wait(0.03)
    end
    notif.BackgroundTransparency = 0.1
    task.wait(duration)
    for i = 1, 10 do
        notif.BackgroundTransparency = 0.1 + (i / 10) * 0.3
        notif.TextTransparency = i / 10
        task.wait(0.03)
    end
    notif:Destroy()
end

