                t.TextColor3 = Color3.fromRGB(150, 150, 160)
            end
            Page.Visible = true
            TabButton.TextColor3 = Color3.fromRGB(120, 110, 255)
        end)

        table.insert(Tabs, TabButton)
        table.insert(Pages, Page)

        if order == 1 then
            Page.Visible = true
            TabButton.TextColor3 = Color3.fromRGB(120, 110, 255)
        end

        return Page
    end

    local RagePage = createTab("Rage", 1)
