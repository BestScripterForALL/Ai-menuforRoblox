    local function IsTeammate(player)
        if player == LocalPlayer then return true end
        if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
            return true
        end
        if player:GetAttribute("Team") and LocalPlayer:GetAttribute("Team") then
            if player:GetAttribute("Team") == LocalPlayer:GetAttribute("Team") then
                return true
            end
        end
        return false
    end

    --------------------------------------------------
    -- ОПТИМИЗИРОВАННЫЙ ВХ (ОБНОВЛЕНИЕ РАЗ В 35 КАДРОВ)
    --------------------------------------------------
    local frameCounter = 0
    local targetFrameInterval = math.floor(60 / 35) -- кадровый троттлинг (~ каждые 1-2 кадра для стабильности 35 FPS обновления)

    local function UpdateESP()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local guiName = "NeverloseESP_" .. player.Name
                local boxGui = PlayerGui:FindFirstChild(guiName)

                local char = player.Character
                local shouldShow = Config.Visuals.ESP and char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.Health > 0 and not IsTeammate(player)

                if shouldShow then
                    local hrp = char.HumanoidRootPart
                    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude

                    if dist <= Config.Visuals.MaxDist then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                        if onScreen then
                            if not boxGui then
                                boxGui = Instance.new("ScreenGui")
                                boxGui.Name = guiName
                                boxGui.Parent = PlayerGui
                                boxGui.IgnoreGuiInset = true
                                boxGui.ResetOnSpawn = false

                                local frame = Instance.new("Frame")
                                frame.Name = "Box"
                                frame.Parent = boxGui
                                frame.BackgroundTransparency = 1
                                frame.BorderSizePixel = 1
                                frame.BorderColor3 = Color3.fromRGB(120, 110, 255)
                            end

                            local frame = boxGui:FindFirstChild("Box")
                            if frame then
                                local sizeFactor = math.clamp(2500 / dist, 5, 500)
                                frame.Size = UDim2.new(0, sizeFactor * 0.6, 0, sizeFactor)
                                frame.Position = UDim2.new(0, screenPos.X - (sizeFactor * 0.3), 0, screenPos.Y - (sizeFactor * 0.5))
                                boxGui.Enabled = true
                            end
                        else
                            if boxGui then boxGui.Enabled = false end
                        end
                    else
                        if boxGui then boxGui.Enabled = false end
                    end
                else
                    if boxGui then boxGui.Enabled = false end
                end
            end
        end
    end

