local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Parent = TabContainer
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.Padding = UDim.new(0, 5)

-- Функция создания вкладки
local function createTab(name, order)
    движимыйКнопка = Instance.new("TextButton")
    движимыйКнопка.Parent = TabContainer
    движимыйКнопка.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
    движимыйКнопка.BorderSizePixel = 0
    движимыйКнопка.Size = UDim2.new(1, 0, 0, 30)
    движимыйКнопка.Font = Enum.Font.GothamSemibold
    движимыйКнопка.Text = name
    движимыйКнопка.TextColor3 = Color3.fromRGB(150, 150, 160)
    движимыйКнопка.TextSize = 13
    движимыйКнопка.LayoutOrder = order
    return движимыйКнопка
end

-- Основные вкладки Neverlose CS2
createTab("Rage", 1)
createTab("Legit", 2)
createTab("Visuals", 3)
createTab("Misc", 4)
createTab("Configs", 5)
createTab("Scripts", 6)

-- Перетаскивание окна мышкой (Drag Logic)
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
