-- Защищенный загрузчик Neverlose Mobile UI Library (Full UI)
local success, errorMessage = pcall(function()
    local CoreGui = game:GetService("CoreGui")
    local UserInputService = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    -- Удаляем старые копии интерфейса
    if CoreGui:FindFirstChild("NeverloseMobileMenu") then
        CoreGui.NeverloseMobileMenu:Destroy()
    end
    if CoreGui:FindFirstChild("NeverloseWatermark") then
        CoreGui.NeverloseWatermark:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "NeverloseMobileMenu"
    ScreenGui.Parent = CoreGui
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.ResetOnSpawn = false

    -- Главное компактное окно для телефонов
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    MainFrame.BackgroundTransparency = 0.1
    MainFrame.BorderSizePixel = 0
    MainFrame.Position = UDim2.new(0.5, -175, 0.5, -125)
    MainFrame.Size = UDim2.new(0, 350, 0, 250)

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 6)
    UICorner.Parent = MainFrame

    -- Шапка меню (Topbar)
    local TopBar = Instance.new("Frame")
    TopBar.Parent = MainFrame
    TopBar.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
    TopBar.BackgroundTransparency = 0.1
    TopBar.Size = UDim2.new(1, 0, 0, 30)
    TopBar.BorderSizePixel = 0

    local TopBarCorner = Instance.new("UICorner")
    TopBarCorner.CornerRadius = UDim.new(0, 6)
    TopBarCorner.Parent = TopBar

    -- Логотип
    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Parent = TopBar
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Position = UDim2.new(0, 10, 0, 0)
    TitleLabel.Size = UDim2.new(0, 150, 1, 0)
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.Text = "neverlose"
    TitleLabel.TextColor3 = Color3.fromRGB(120, 110, 255)
    TitleLabel.TextSize = 14
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    local SubTitle = Instance.new("TextLabel")
    SubTitle.Parent = TitleLabel
    SubTitle.BackgroundTransparency = 1
    SubTitle.Position = UDim2.new(0, 68, 0, 0)
    SubTitle.Size = UDim2.new(0, 50, 1, 0)
    SubTitle.Font = Enum.Font.Gotham
    SubTitle.Text = ".cc"
    SubTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    SubTitle.TextSize = 14
    SubTitle.TextXAlignment = Enum.TextXAlignment.Left

    -- Кнопка скрытия меню в букву N
    local HideButton = Instance.new("TextButton")
    HideButton.Parent = TopBar
    HideButton.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    HideButton.Position = UDim2.new(1, -26, 0.5, -10)
    HideButton.Size = UDim2.new(0, 20, 0, 20)
    HideButton.Font = Enum.Font.GothamBold
    HideButton.Text = "-"
    HideButton.TextColor3 = Color3.fromRGB(200, 200, 200)
    HideButton.TextSize = 12

    local HideCorner = Instance.new("UICorner")
    HideCorner.CornerRadius = UDim.new(0, 4)
    HideCorner.Parent = HideButton

    -- Контейнер для списка вкладок (слева)
    local TabContainer = Instance.new("ScrollingFrame")
    TabContainer.Parent = MainFrame
    TabContainer.BackgroundTransparency = 1
    TabContainer.Position = UDim2.new(0, 0, 0, 35)
    TabContainer.Size = UDim2.new(0, 90, 1, -35)
    TabContainer.CanvasSize = UDim2.new(0, 0, 0, 210)
    TabContainer.ScrollBarThickness = 2

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.Parent = TabContainer
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Padding = UDim.new(0, 4)

    -- Контейнер для отображения контента выбранной вкладки (справа)
    local ContentContainer = Instance.new("Frame")
    ContentContainer.Parent = MainFrame
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Position = UDim2.new(0, 95, 0, 35)
    ContentContainer.Size = UDim2.new(1, -95, 1, -35)

    local Tabs = {}
    local Pages = {}

    local function createTab(name, order)
        -- Кнопка вкладки
        local TabButton = Instance.new("TextButton")
        TabButton.Parent = TabContainer
        TabButton.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
        TabButton.BackgroundTransparency = 0.2
        TabButton.BorderSizePixel = 0
        TabButton.Size = UDim2.new(1, 0, 0, 26)
        TabButton.Font = Enum.Font.GothamSemibold
        TabButton.Text = name
        TabButton.TextColor3 = Color3.fromRGB(150, 150, 160)
        TabButton.TextSize = 11
        TabButton.LayoutOrder = order

        local BtnCorner = Instance.new("UICorner")
        BtnCorner.CornerRadius = UDim.new(0, 4)
        BtnCorner.Parent = TabButton

        -- Страница для контента вкладки
        local Page = Instance.new("ScrollingFrame")
        Page.Name = name .. "Page"
        Page.Parent = ContentContainer
        Page.BackgroundTransparency = 1
        Page.BorderSizePixel = 0
        Page.Size = UDim2.new(1, 0, 1, 0)
        Page.Visible = false
        Page.CanvasSize = UDim2.new(0, 0, 0, 0)
        Page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        Page.ScrollBarThickness = 2

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.Parent = Page
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Padding = UDim.new(0, 6)

        TabButton.MouseButton1Click:Connect(function()
            for _, p in pairs(Pages) do
                p.Visible = false
            end
            for _, t in pairs(Tabs) do
                t.TextColor3 = Color3.fromRGB(150, 150, 160)
            end
            Page.Visible = true
            TabButton.TextColor3 = Color3.fromRGB(120, 110, 255)
        end)

        table.insert(Tabs, TabButton)
        table.insert(Pages, Page)

        -- Делаем первую вкладку активной по умолчанию
        if order == 1 then
            Page.Visible = true
            TabButton.TextColor3 = Color3.fromRGB(120, 110, 255)
        end

        return Page
    end

    -- Создаем основные вкладки
    local RagePage = createTab("Rage", 1)
    local LegitPage = createTab("Legit", 2)
    local VisualsPage = createTab("Visuals", 3)
    local MiscPage = createTab("Misc", 4)
    local ConfigsPage = createTab("Configs", 5)
    local ScriptsPage = createTab("Scripts", 6)
    local DevTab = createTab("Dev", 7)

    -- Функция добавления чекбокса (тоггла)
    local function AddToggle(parent, title, defaultState, callback)
        local state = defaultState
        local ToggleBtn = Instance.new("TextButton")
        ToggleBtn.Parent = parent
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
        ToggleBtn.BackgroundTransparency = 0.3
        ToggleBtn.Size = UDim2.new(1, -6, 0, 24)
        ToggleBtn.AutoButtonColor = false
        ToggleBtn.Text = ""
        ToggleBtn.BorderSizePixel = 0

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 4)
        Corner.Parent = ToggleBtn

        local Label = Instance.new("TextLabel")
        Label.Parent = ToggleBtn
        Label.BackgroundTransparency = 1
        Label.Position = UDim2.new(0, 8, 0, 0)
        Label.Size = UDim2.new(1, -35, 1, 0)
        Label.Font = Enum.Font.Gotham
        Label.Text = title
        Label.TextColor3 = Color3.fromRGB(200, 200, 210)
        Label.TextSize = 10
        Label.TextXAlignment = Enum.TextXAlignment.Left

        local Box = Instance.new("Frame")
        Box.Parent = ToggleBtn
        Box.BackgroundColor3 = state and Color3.fromRGB(120, 110, 255) or Color3.fromRGB(35, 35, 45)
        Box.Position = UDim2.new(1, -20, 0.5, -6)
        Box.Size = UDim2.new(0, 12, 0, 12)

        local BoxCorner = Instance.new("UICorner")
        BoxCorner.CornerRadius = UDim.new(0, 3)
        BoxCorner.Parent = Box

        ToggleBtn.MouseButton1Click:Connect(function()
            state = not state
            Box.BackgroundColor3 = state and Color3.fromRGB(120, 110, 255) or Color3.fromRGB(35, 35, 45)
            if callback then callback(state) end
        end)
    end

    -- Функция добавления слайдера
    local function AddSlider(parent, title, min, max, default, callback)
        local val = default
        local SliderFrame = Instance.new("Frame")
        SliderFrame.Parent = parent
        SliderFrame.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
        SliderFrame.BackgroundTransparency = 0.3
        SliderFrame.Size = UDim2.new(1, -6, 0, 36)
        SliderFrame.BorderSizePixel = 0

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 4)
        Corner.Parent = SliderFrame

        local Label = Instance.new("TextLabel")
        Label.Parent = SliderFrame
        Label.BackgroundTransparency = 1
        Label.Position = UDim2.new(0, 8, 0, 2)
        Label.Size = UDim2.new(1, -50, 0, 14)
        Label.Font = Enum.Font.Gotham
        Label.Text = title
        Label.TextColor3 = Color3.fromRGB(200, 200, 210)
        Label.TextSize = 10
        Label.TextXAlignment = Enum.TextXAlignment.Left

        local ValLabel = Instance.new("TextLabel")
        ValLabel.Parent = SliderFrame
        ValLabel.BackgroundTransparency = 1
        ValLabel.Position = UDim2.new(1, -45, 0, 2)
        ValLabel.Size = UDim2.new(0, 40, 0, 14)
        ValLabel.Font = Enum.Font.GothamBold
        ValLabel.Text = tostring(default)
        ValLabel.TextColor3 = Color3.fromRGB(120, 110, 255)
        ValLabel.TextSize = 10
        ValLabel.TextXAlignment = Enum.TextXAlignment.Right

        local Bar = Instance.new("TextButton")
        Bar.Parent = SliderFrame
        Bar.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        Bar.Position = UDim2.new(0, 8, 0, 22)
        Bar.Size = UDim2.new(1, -16, 0, 6)
        Bar.AutoButtonColor = false
        Bar.Text = ""
        Bar.BorderSizePixel = 0

        local BarCorner = Instance.new("UICorner")
        BarCorner.CornerRadius = UDim.new(0, 3)
        BarCorner.Parent = Bar

        local Fill = Instance.new("Frame")
        Fill.Parent = Bar
        Fill.BackgroundColor3 = Color3.fromRGB(120, 110, 255)
        Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        Fill.BorderSizePixel = 0

        local FillCorner = Instance.new("UICorner")
        FillCorner.CornerRadius = UDim.new(0, 3)
        FillCorner.Parent = Fill

        local dragging = false
        local function UpdateSlider(input)
            local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
            Fill.Size = UDim2.new(pos, 0, 1, 0)
            val = math.floor(min + ((max - min) * pos))
            ValLabel.Text = tostring(val)
            if callback then callback(val) end
        end

        Bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                UpdateSlider(input)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                UpdateSlider(input)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    -- Заполняем вкладку Rage
    AddToggle(RagePage, "Enable Ragebot", true, function(v) print("Rage:", v) end)
    AddToggle(RagePage, "Auto Shoot", false, function(v) print("Auto Shoot:", v) end)
    AddSlider(RagePage, "Field of View", 1, 180, 45, function(v) print("FOV:", v) end)

    -- Заполняем вкладку Legit
    AddToggle(LegitPage, "Enable Legitbot", false, function(v) print("Legit:", v) end)
    AddSlider(LegitPage, "Smoothness", 1, 20, 5, function(v) print("Smooth:", v) end)

    -- Заполняем вкладку Visuals
    AddToggle(VisualsPage, "Player ESP", true, function(v) print("ESP:", v) end)
    AddToggle(VisualsPage, "Box Outline", true, function(v) print("Box:", v) end)
    AddSlider(VisualsPage, "Max Distance", 50, 500, 250, function(v) print("Dist:", v) end)

    -- Плавающая кнопка-значок "N" для возврата меню
    local WatermarkGui = Instance.new("ScreenGui")
    WatermarkGui.Name = "NeverloseWatermark"
    WatermarkGui.Parent = CoreGui
    WatermarkGui.IgnoreGuiInset = true
    WatermarkGui.ResetOnSpawn = false
    WatermarkGui.Enabled = false

    local WatermarkBtn = Instance.new("TextButton")
    WatermarkBtn.Name = "NButton"
    WatermarkBtn.Parent = WatermarkGui
    WatermarkBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    WatermarkBtn.BackgroundTransparency = 0.2
    WatermarkBtn.Position = UDim2.new(0, 50, 0, 50)
    WatermarkBtn.Size = UDim2.new(0, 35, 0, 35)
    WatermarkBtn.Font = Enum.Font.GothamBold
    WatermarkBtn.Text = "N"
    WatermarkBtn.TextColor3 = Color3.fromRGB(120, 110, 255)
    WatermarkBtn.TextSize = 18

    local WatermarkCorner = Instance.new("UICorner")
    WatermarkCorner.CornerRadius = UDim.new(0, 8)
    WatermarkCorner.Parent = WatermarkBtn

    -- Логика скрытия/показа
    HideButton.MouseButton1Click:Connect(function()
        MainFrame.Visible = false
        WatermarkGui.Enabled = true
    end)

    WatermarkBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = true
        WatermarkGui.Enabled = false
    end)

    -- Функция выгрузки (Удаление меню через вкладку Dev)
    DevTab.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
        WatermarkGui:Destroy()
    end)

    -- Перетаскивание главного окна
    local draggingMain, dragStartMain, startPosMain
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingMain = true
            dragStartMain = input.Position
            startPosMain = MainFrame.Position
        end
    end)

    -- Перетаскивание плавающей кнопки N
    local draggingWm, dragStartWm, startPosWm
    WatermarkBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingWm = true
            dragStartWm = input.Position
            startPosWm = WatermarkBtn.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            if draggingMain then
                local delta = input.Position - dragStartMain
                MainFrame.Position = UDim2.new(startPosMain.X.Scale, startPosMain.X.Offset + delta.X, startPosMain.Y.Scale, startPosMain.Y.Offset + delta.Y)
            elseif draggingWm then
                local delta = input.Position - dragStartWm
                WatermarkBtn.Position = UDim2.new(startPosWm.X.Scale, startPosWm.X.Offset + delta.X, startPosWm.Y.Scale, startPosWm.Y.Offset + delta.Y)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingMain = false
            draggingWm = false
        end
    end)
end)

if not success then
    warn("Ошибка инициализации интерфейса: " .. tostring(errorMessage))
end
