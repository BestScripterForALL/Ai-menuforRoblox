    local function TriggerShoot()
        if isShooting then return end
        isShooting = true
        task.spawn(function()
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
            task.wait(0.1)
            isShooting = false
        end)
    end

