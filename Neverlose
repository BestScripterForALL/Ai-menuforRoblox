-- Защищенный загрузчик Neverlose Mobile UI Library
local success, errorMessage = pcall(function()
    local CoreGui = game:GetService("CoreGui")
    local UserInputService = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    -- Удаляем старые копии интерфейса
    if CoreGui:FindFirstChild("NeverloseMobileMenu") then
        CoreGui.NeverloseMobileMenu:Destroy()
    end
    if CoreGui:FindFirstChild("NeverloseWatermark") then
        CoreGui.NeverloseWatermark:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "NeverloseMobileMenu"
    ScreenGui.Parent = CoreGui
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.ResetOnSpawn = false

    -- Главное компактное окно для телефонов (непрозрачность 90% / BackgroundTransparency = 0.1)
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    MainFrame.BackgroundTransparency = 0.1
    MainFrame.BorderSizePixel = 0
    MainFrame.Position = UDim2.new(0.5, -175, 0.5, -125)
    MainFrame.Size = UDim2.new(0, 350, 0, 250)

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 6)
    UICorner.Parent = MainFrame

    -- Шапка меню (Topbar)
    local TopBar = Instance.new("Frame")
    TopBar.Parent = MainFrame
    TopBar.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
    TopBar.BackgroundTransparency = 0.1
    TopBar.Size = UDim2.new(1, 0, 0, 30)
    TopBar.BorderSizePixel = 0

    local TopBarCorner = Instance.new("UICorner")
    TopBarCorner.CornerRadius = UDim.new(0, 6)
    TopBarCorner.Parent = TopBar

    -- Логотип
    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Parent = TopBar
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Position = UDim2.new(0, 10, 0, 0)
    TitleLabel.Size = UDim2.new(0, 150, 1, 0)
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.Text = "neverlose"
    TitleLabel.TextColor3 = Color3.fromRGB(120, 110, 255)
    TitleLabel.TextSize = 14
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    local SubTitle = Instance.new("TextLabel")
    SubTitle.Parent = TitleLabel
    SubTitle.BackgroundTransparency = 1
    SubTitle.Position = UDim2.new(0, 68, 0, 0)
    SubTitle.Size = UDim2.new(0, 50, 1, 0)
    SubTitle.Font = Enum.Font.Gotham
    SubTitle.Text = ".cc"
    SubTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    SubTitle.TextSize = 14
    SubTitle.TextXAlignment = Enum.TextXAlignment.Left

    -- Кнопка скрытия меню в букву N
    local HideButton = Instance.new("TextButton")
    HideButton.Parent = TopBar
    HideButton.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    HideButton.Position = UDim2.new(1, -26, 0.5, -10)
    HideButton.Size = UDim2.new(0, 20, 0, 20)
    HideButton.Font = Enum.Font.GothamBold
    HideButton.Text = "-"
    HideButton.TextColor3 = Color3.fromRGB(200, 200, 200)
    HideButton.TextSize = 12

    local HideCorner = Instance.new("UICorner")
    HideCorner.CornerRadius = UDim.new(0, 4)
    HideCorner.Parent = HideButton

    -- Контейнер для вкладок
    local TabContainer = Instance.new("ScrollingFrame")
    TabContainer.Parent = MainFrame
    TabContainer.BackgroundTransparency = 1
    TabContainer.Position = UDim2.new(0, 0, 0, 35)
    TabContainer.Size = UDim2.new(0, 90, 1, -35)
    TabContainer.CanvasSize = UDim2.new(0, 0, 0, 210)
    TabContainer.ScrollBarThickness = 2

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.Parent = TabContainer
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Padding = UDim.new(0, 4)

    local function createTab(name, order)
        local TabButton = Instance.new("TextButton")
        TabButton.Parent = TabContainer
        TabButton.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
        TabButton.BackgroundTransparency = 0.2
        TabButton.BorderSizePixel = 0
        TabButton.Size = UDim2.new(1, 0, 0, 26)
        TabButton.Font = Enum.Font.GothamSemibold
        TabButton.Text = name
        TabButton.TextColor3 = Color3.fromRGB(150, 150, 160)
        TabButton.TextSize = 11
        TabButton.LayoutOrder = order
        return TabButton
    end

    createTab("Rage", 1)
    createTab("Legit", 2)
    createTab("Visuals", 3)
    createTab("Misc", 4)
    createTab("Configs", 5)
    createTab("Scripts", 6)
    
    -- Вкладка Dev
    local DevTab = createTab("Dev", 7)

    -- Плавающая кнопка-значок "N" для возврата меню
    local WatermarkGui = Instance.new("ScreenGui")
    WatermarkGui.Name = "NeverloseWatermark"
    WatermarkGui.Parent = CoreGui
    WatermarkGui.IgnoreGuiInset = true
    WatermarkGui.ResetOnSpawn = false
    WatermarkGui.Enabled = false

    local WatermarkBtn = Instance.new("TextButton")
    WatermarkBtn.Name = "NButton"
    WatermarkBtn.Parent = WatermarkGui
    WatermarkBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    WatermarkBtn.BackgroundTransparency = 0.2
    WatermarkBtn.Position = UDim2.new(0, 50, 0, 50)
    WatermarkBtn.Size = UDim2.new(0, 35, 0, 35)
    WatermarkBtn.Font = Enum.Font.GothamBold
    WatermarkBtn.Text = "N"
    WatermarkBtn.TextColor3 = Color3.fromRGB(120, 110, 255)
    WatermarkBtn.TextSize = 18

    local WatermarkCorner = Instance.new("UICorner")
    WatermarkCorner.CornerRadius = UDim.new(0, 8)
    WatermarkCorner.Parent = WatermarkBtn

    -- Логика скрытия/показа
    HideButton.MouseButton1Click:Connect(function()
        MainFrame.Visible = false
        WatermarkGui.Enabled = true
    end)

    WatermarkBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = true
        WatermarkGui.Enabled = false
    end)

    -- Функция выгрузки (Удаление меню и функций)
    DevTab.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
        WatermarkGui:Destroy()
    end)

    -- Перетаскивание главного окна
    local draggingMain, dragStartMain, startPosMain
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingMain = true
            dragStartMain = input.Position
            startPosMain = MainFrame.Position
        end
    end)

    -- Перетаскивание плавающей кнопки N
    local draggingWm, dragStartWm, startPosWm
    WatermarkBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingWm = true
            dragStartWm = input.Position
            startPosWm = WatermarkBtn.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            if draggingMain then
                local delta = input.Position - dragStartMain
                MainFrame.Position = UDim2.new(startPosMain.X.Scale, startPosMain.X.Offset + delta.X, startPosMain.Y.Scale, startPosMain.Y.Offset + delta.Y)
            elseif draggingWm then
                local delta = input.Position - dragStartWm
                WatermarkBtn.Position = UDim2.new(startPosWm.X.Scale, startPosWm.X.Offset + delta.X, startPosWm.Y.Scale, startPosWm.Y.Offset + delta.Y)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingMain = false
            draggingWm = false
        end
    end)
end)

if not success then
    warn("Ошибка инициализации интерфейса: " .. tostring(errorMessage))
end
