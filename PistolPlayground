-- Aimbot Variables
local AimbotEnabled = false
local AimFOV = 100
local MaxDistance = 500
local WallCheck = false
local PredictionTime = 0.05 -- Время предикта для аимбота и точек визуализации
local AimSmooth = 0.2 -- Плавность аимбота (чем меньше, тем плавнее)

-- Visuals Variables (ESP / Chams / Tracers)
local ESPBoxes = false
local ChamsEnabled = false
local TracersEnabled = false

-- Misc & Auto-Strafe Variables
local SpeedHack = false
local SpeedValue = 16
local JumpHack = false
local JumpPower = 50
local BunnyHop = false
local AutoStrafeEnabled = false
local StrafeForce = 15
local MaxAirSpeed = 28
local ESPStorage = {}

local function CleanupESP(player)
    if ESPStorage[player] then
        if ESPStorage[player].Box then pcall(function() ESPStorage[player].Box:Remove() end) end
        if ESPStorage[player].Tracer then pcall(function() ESPStorage[player].Tracer:Remove() end) end
        if ESPStorage[player].PredictDot then pcall(function() ESPStorage[player].PredictDot:Remove() end) end
        if ESPStorage[player].Highlight and ESPStorage[player].Highlight.Parent then
            ESPStorage[player].Highlight:Destroy()
        end
        ESPStorage[player] = nil
    end
end

-- Robust Wall Check function
local function IsVisible(targetPart, origin)
    if not WallCheck then return true end
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    
    local result = Workspace:Raycast(origin, targetPart.Position - origin, raycastParams)
    if result then
        local hitPart = result.Instance
        if hitPart:IsDescendantOf(targetPart.Parent) then
            return true
        end
        return false
    end
    return true
end

