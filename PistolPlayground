-- Main Render Loop (Aimbot, Visuals, Auto-Strafe, Misc)
RunService.RenderStepped:Connect(function(dt)
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local validTargets = {}

    -- Сбор валидных целей
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("Head") and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local hrp = char.HumanoidRootPart
                local head = char.Head
                
                local distanceToPlayer = (hrp.Position - Camera.CFrame.Position).Magnitude
                if distanceToPlayer <= MaxDistance then
                    if not WallCheck or IsVisible(head, Camera.CFrame.Position) then
                        table.insert(validTargets, {
                            Player = player,
                            Character = char,
                            Head = head,
                            HRP = hrp,
                            Distance = distanceToPlayer
                        })
                    end
                end
            end
        end
    end

    table.sort(validTargets, function(a, b)
        return a.Distance < b.Distance
    end)

    -- 1. Rage Aimbot с Предиктом по топ-2 целям
    local closestTargetPos = nil
    local shortestFovDist = math.huge

    for i = 1, math.min(2, #validTargets) do
        local target = validTargets[i]
        local velocity = target.HRP.AssemblyLinearVelocity or Vector3.new(0,0,0)
        local predictedPosition = target.Head.Position + (velocity * PredictionTime)
        
        local screenPoint, onScreen = Camera:WorldToViewportPoint(predictedPosition)
        if onScreen then
            local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
            local fovDistance = (screenPos2D - screenCenter).Magnitude

            if fovDistance <= AimFOV then
                if fovDistance < shortestFovDist then
                    shortestFovDist = fovDistance
                    closestTargetPos = predictedPosition
                end
            end
        end
    end

    if AimbotEnabled and closestTargetPos then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, closestTargetPos), AimSmooth)
    end

    -- 2. Visuals Loop (ESP Box, Tracers, Chams, PredictDot)
    local activePlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            activePlayers[player] = true
            local char = player.Character
            
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local hrp = char.HumanoidRootPart
                local head = char.Head
                
                if not ESPStorage[player] then
                    ESPStorage[player] = {
                        Box = Drawing.new("Square"),
                        Tracer = Drawing.new("Line"),
                        PredictDot = Drawing.new("Circle")
                    }
                    ESPStorage[player].Box.Thickness = 1.5
                    ESPStorage[player].Box.Filled = false
                    ESPStorage[player].Tracer.Thickness = 1.5
                    ESPStorage[player].PredictDot.Radius = 5
                    ESPStorage[player].PredictDot.Filled = true
                    ESPStorage[player].PredictDot.Color = Color3.fromRGB(255, 255, 0)
                end
                
                local data = ESPStorage[player]
                local rootScreen, rootOnScreen = Camera:WorldToViewportPoint(hrp.Position)
                local headScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local legScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                
                local velocity = hrp.AssemblyLinearVelocity or Vector3.new(0,0,0)
                local predictedPosition = head.Position + (velocity * PredictionTime)
                local predScreen, predOnScreen = Camera:WorldToViewportPoint(predictedPosition)

                local visible = IsVisible(head, Camera.CFrame.Position)
                local dynamicColor = visible and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)

                -- Box ESP Rendering
                if ESPBoxes and rootOnScreen then
                    local height = math.abs(headScreen.Y - legScreen.Y)
                    local width = height / 2
                    data.Box.Size = Vector2.new(width, height)
                    data.Box.Position = Vector2.new(rootScreen.X - width / 2, headScreen.Y)
                    data.Box.Color = dynamicColor
                    data.Box.Visible = true
                else
                    data.Box.Visible = false
                end

                -- Tracers Rendering
                if TracersEnabled and rootOnScreen then
                    data.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    data.Tracer.To = Vector2.new(rootScreen.X, rootScreen.Y)
                    data.Tracer.Color = dynamicColor
                    data.Tracer.Visible = true
                else
                    data.Tracer.Visible = false
                end

                -- Predict Dot Rendering для топ-2 целей
                local isTop2 = false
                for i = 1, math.min(2, #validTargets) do
                    if validTargets[i].Player == player then
                        isTop2 = true
                        break
                    end
                end

                if isTop2 and predOnScreen then
                    data.PredictDot.Position = Vector2.new(predScreen.X, predScreen.Y)
                    data.PredictDot.Visible = true
                else
                    data.PredictDot.Visible = false
                end

                -- Chams / Highlight Rendering
                local highlight = char:FindFirstChild("TornadoHighlight")
                if ChamsEnabled then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "TornadoHighlight"
                        highlight.Adornee = char
                        highlight.Parent = char
                    end
                    highlight.FillColor = dynamicColor
                    highlight.OutlineColor = dynamicColor
                else
                    if highlight then highlight:Destroy() end
                end
            else
                if ESPStorage[player] then
                    if ESPStorage[player].Box then ESPStorage[player].Box.Visible = false end
                    if ESPStorage[player].Tracer then ESPStorage[player].Tracer.Visible = false end
                    if ESPStorage[player].PredictDot then ESPStorage[player].PredictDot.Visible = false end
                end
                local highlight = char and char:FindFirstChild("TornadoHighlight")
                if highlight then highlight:Destroy() end
            end
        end
    end

    -- Cleanup players who left the server
    for player, _ in pairs(ESPStorage) do
        if not activePlayers[player] then
            CleanupESP(player)
        end
    end

    -- 3. Mobile Auto-Strafe Logic
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        
        if humanoid and hrp then
            if AutoStrafeEnabled and humanoid.FloorMaterial == Enum.Material.Air then
                local moveDir = humanoid.MoveDirection
                if moveDir.Magnitude > 0 then
                    local camCF = Camera.CFrame
                    local worldMoveDir = (camCF.RightVector * moveDir.X + camCF.LookVector * moveDir.Z)
                    worldMoveDir = Vector3.new(worldMoveDir.X, 0, worldMoveDir.Z)
                    
                    if worldMoveDir.Magnitude > 0 then
                        worldMoveDir = worldMoveDir.Unit
                        local currentVel = hrp.AssemblyLinearVelocity
                        local horizontalVel = Vector3.new(currentVel.X, 0, currentVel.Z)
                        
                        if horizontalVel.Magnitude < MaxAirSpeed then
                            hrp:ApplyImpulse(worldMoveDir * StrafeForce * dt * 60)
                        end
                    end
                end
            end
            if SpeedHack then
                humanoid.WalkSpeed = SpeedValue
            end
            if JumpHack then
                humanoid.JumpPower = JumpPower
            end
            if BunnyHop and humanoid.FloorMaterial ~= Enum.Material.Air then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end)
